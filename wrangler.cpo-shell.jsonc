{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "straumvakt-cpo-shell",
  "account_id": "1b2fc4c163e8544e9cd472baa5a19c74",
  "main": "workers/cpo-shell.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "www.straumvakt.org", "custom_domain": true },
    { "pattern": "straumvakt.org", "custom_domain": true }
  ],
  "vars": {
    "CPO_SHELL_USERNAME": "Straumvakt",
    "CPO_SHELL_ORG_ID": "17a168ae-4d54-4ae4-b741-c2145825de5a",
    "CPO_VENDOR_CONNECT": "easee,zaptec",
    // Bounded independent recovery (costing + pending removals). OFF: only the exact string "true" enables it, and it also
    // needs a cron trigger below. Disabled does no database work.
    "CPO_SHELL_RECOVERY_ENABLED": "false",
    "NEXT_PUBLIC_APP_NAME": "Straumvakt"
  },
  // No cron ships. PROPOSED release setting, to be enabled only after review and approved live validation, together with
  // CPO_SHELL_RECOVERY_ENABLED = "true":   "crons": ["0 * * * *"]   (hourly; each pass is bounded to 20 costing attempts,
  // 5 lifecycle requests and a 20 s cooperative budget). Each enabled pass can wake the Neon compute. Rollback: set the
  // variable back to "false" (pending work then waits; it is not lost) and remove the cron.
  "triggers": { "crons": [] },
  // Both bindings name the gateway's CommandEntrypoint. OCPP_PENDING: pending-charger calls only (presence read, post-save
  // signal). GATEWAY: the binding the lifecycle endpoint reads for remote stop (durable, attempt-keyed). LOCAL CONFIGURATION
  // ONLY until released: deploying it ENABLES removal of a charger with a session in progress, which needs the gateway
  // version that carries the attempt-keyed requestStop. Release the gateway FIRST; the target Worker and entrypoint must
  // already exist when this configuration is deployed. The two bindings are the same target by design, not a second service.
  "services": [
    { "binding": "OCPP_PENDING", "service": "straumvakt-ocpp-s1", "entrypoint": "CommandEntrypoint" },
    { "binding": "GATEWAY", "service": "straumvakt-ocpp-s1", "entrypoint": "CommandEntrypoint" }
  ],
  // NOT ACTIVE. Stage B/C of the staged release (see docs/agent-runs/2026-11-01/2026-11-01-remaining-core-completion-handoff.md).
  // Adding these CREATES the VersionHub Durable Object namespace (a cloud change that needs the one consolidated release approval):
  //   "durable_objects": { "bindings": [{ "name": "VERSION_HUB", "class_name": "VersionHub" }] },
  //   "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VersionHub"] }],
  // Stage B (hub bound, push still off) makes the check cooldown, read limits and repair lease shared across isolates.
  // Stage C additionally sets "CPO_SHELL_REALTIME_ENABLED": "true" here, OCPP_REALTIME_ENABLED=true on the gateway, and (for the
  // driver app only) the secret DRIVER_AUTH_SECRET = the driver API's AUTH_SECRET. Rollback of C: set the flags back to "false".
  "ratelimits": [{
    "name": "SHELL_LOGIN_LIMITER",
    "namespace_id": "2026102701",
    "simple": { "limit": 5, "period": 60 }
  }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "limits": { "cpu_ms": 100 }
}
