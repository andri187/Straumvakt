{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "straumvakt/release-manifest.schema.json",
  "title": "Straumvakt release manifest",
  "description": "Record of one promotion: what was released, from where, onto what, and how to undo it. OFFLINE ONLY - this schema and its validator never contact a network and never mutate state. A manifest is evidence, not an instruction; nothing applies it.",
  "type": "object",
  "required": ["manifestVersion", "releaseId", "environment", "commit", "sourceBranch", "workers", "data", "rollback", "approval"],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": { "const": 1 },
    "releaseId": { "type": "string", "pattern": "^release-[0-9]{4}-[0-9]{2}-[0-9]{2}(-[0-9]+)?$" },
    "environment": { "type": "string", "enum": ["beta", "production"] },
    "commit": {
      "type": "object",
      "required": ["sha", "verifiedFastForward"],
      "additionalProperties": false,
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "full sha - a short sha is not an identity proof" },
        "tag": { "type": ["string", "null"] },
        "verifiedFastForward": { "type": "boolean", "description": "rev-list --left-right --count showed 0 on the left" },
        "betaTestedSince": { "type": ["string", "null"], "description": "UTC instant this exact sha began running in beta; null only for a beta release" }
      }
    },
    "sourceBranch": { "type": "string", "enum": ["main", "staging"] },
    "releasedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "UTC instant of the promotion. Required for production so that betaTestedSince has something to be ordered against." },
    "cpmsSeparationVerified": { "type": "boolean", "description": "CPMS declares the same Worker names. A production release while another project can redeploy those names is not a controlled release." },
    "workers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/worker" } },
    "data": {
      "type": "object",
      "required": ["neonProject", "neonBranchId", "migrationsRecorded"],
      "additionalProperties": false,
      "properties": {
        "neonProject": { "type": "string", "minLength": 1 },
        "neonBranchId": { "type": "string", "pattern": "^br-[a-z0-9-]+$", "description": "explicit, never defaulted - the project default is an abandoned branch" },
        "neonComputeId": { "type": ["string", "null"], "pattern": "^ep-[a-z0-9-]+$" },
        "hyperdriveId": { "type": ["string", "null"] },
        "migrationsRecorded": { "type": "integer", "minimum": 0 },
        "backupBranchId": { "type": ["string", "null"], "pattern": "^br-[a-z0-9-]+$" }
      }
    },
    "ocpp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpointUnchanged": { "type": "boolean", "description": "an explicit statement that no field device is affected by this release" },
        "gatewayWorker": { "type": ["string", "null"] },
        "mixedReleaseAcknowledged": { "type": "boolean", "description": "set when the gateway ships alongside web or api, acknowledging that one rollback decision would cover three blast radii" }
      }
    },
    "mobile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minSupported": { "type": ["string", "null"] },
        "pinnedHostPreserved": { "type": "boolean", "description": "the shipped app pins a workers.dev host; a release must not disable it" }
      }
    },
    "rollback": {
      "type": "object",
      "required": ["unit", "workerVersionsBefore"],
      "additionalProperties": false,
      "properties": {
        "unit": { "type": "string", "enum": ["worker-version", "domain-reattach", "database-restore"] },
        "workerVersionsBefore": {
          "type": "object",
          "description": "THE rollback target. A release without this is a one-way door.",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "minimumSafeVersion": { "type": ["object", "null"], "additionalProperties": { "type": "string" } },
        "restoreTimeMeasuredSec": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "approval": {
      "type": "object",
      "required": ["approver", "checksPassed"],
      "additionalProperties": false,
      "properties": {
        "approver": { "type": "string", "minLength": 1 },
        "checksPassed": { "type": "array", "items": { "type": "string" } },
        "excludedCommitsVerifiedAbsent": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "worker": {
      "type": "object",
      "required": ["role", "name", "workersDevRequired"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "enum": ["web", "api", "ocpp"] },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "customDomains": { "type": "array", "items": { "type": "string" } },
        "workersDevRequired": { "type": "boolean", "description": "true when an external client pins the workers.dev hostname; adding routes without declaring workers_dev would disable it" },
        "workersDevDeclaredInConfig": { "type": ["boolean", "null"] },
        "newWorkerJustification": { "type": "string", "minLength": 10, "description": "required when the Worker name is not in known-workers.json; a typo otherwise validates perfectly and describes nothing that exists" },
        "serviceBindings": { "type": "array", "items": { "type": "object", "required": ["binding", "target"], "additionalProperties": false, "properties": { "binding": { "type": "string" }, "target": { "type": "string" } } } },
        "secretNames": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
        "durableObjects": { "type": "array", "items": { "type": "string" } },
        "queues": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
