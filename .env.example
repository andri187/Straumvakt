# Copy to .env.local and fill in for local development. Never commit real values.

# Public
NEXT_PUBLIC_APP_NAME="Straumvakt"
NEXT_PUBLIC_APP_ENV="development"

# Auth — required for admin login to work
# AUTH_SECRET: random 32+ character string. Used to sign session cookies (HMAC-SHA256).
#   Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="0e88ee78335f9fdb94deb752dda2d22d745bea028b950da87feff83ba3fd30b9"
ADMIN_EMAIL="admin"
ADMIN_PASSWORD="admin01"

# Auðkenni — Íslensk rafræn skilríki (OIDC) — wired up in Sprint 3
AUDKENNI_ISSUER_URL="https://idp.audkenni.is"
AUDKENNI_CLIENT_ID=""
AUDKENNI_CLIENT_SECRET=""

# Database — wired up in Sprint 0 schema work. Not required for the login shell.
DATABASE_URL=""
DIRECT_URL=""

# OCPP ingest — Sprint 1 (ADR 0004).
# Shared secret the OCPP gateway worker sends on every call to
# /api/ocpp/events via `x-straumvakt-ingest` header. Belt-and-braces
# auth on top of the Cloudflare Service Binding. Unset = endpoint
# closed by default (401 on every call). Rotate by updating this
# value on both workers (gateway + main app) at the same time.
#   Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OCPP_INGEST_SECRET=""
