{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "straumvakt-ocpp",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-18",
  "compatibility_flags": ["nodejs_compat"],

  // Per-identity durable state. DO key = ocpp_identities.id (UUID).
  "durable_objects": {
    "bindings": [
      {
        "name": "IDENTITY_DO",
        "class_name": "IdentityDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["IdentityDurableObject"]
    }
  ],

  // Service Binding to the API Worker for auth lookups + event ingest.
  // Sprint 4.5 production cutover: both environments now bind to the
  // API Worker (post-Sprint-S1 the API Worker hosts every internal
  // route the gateway calls — ocpp-auth, ocpp-authorize, pending-
  // discovery, ocpp-events).
  //   prod    → hlada-api
  //   staging → hlada-api-staging
  // The UI Worker (hlada / hlada-staging) is no longer in the gateway path.
  //
  // CORRECTION 2026-08-18 — the sentence that used to be here said the dead
  // UI-side code "gets deleted in a follow-up commit". IT ALREADY WAS:
  // src/lib/ocpp/, src/app/api/ocpp/events/ and src/app/api/internal/
  // ocpp-auth/ do not exist in this tree, and `OCPP_WEBHOOK_SECRET` appears
  // in no source file. What survives is the SECRET, still set on the
  // top-level `hlada` Worker only. Retirement plan:
  // docs/notes/2026-08-18-dead-paths-and-deploy-runbook.md §2.
  //
  // ── THIS BINDING IS KNOWN-BROKEN AND DELIBERATELY NOT FIXED ────────
  //
  // `hlada-api` HAS NEVER EXISTED on the account (verified read-only
  // 2026-08-18: `wrangler deployments list --name hlada-api` → code 10007).
  // So this top-level block cannot deploy into a working state.
  //
  // It is not fixed here because the correct value is option-dependent:
  // under "adopt staging as production" this whole top-level Worker is
  // retired and the binding should go away; under "build top-level fresh"
  // `hlada-api` is created and the binding becomes correct as written.
  // See docs/notes/2026-08-18-what-production-means.md.
  //
  // It is not silent either: `npm run check:bindings` lists it as
  // pending-creation with an owner and a reason, and FAILS if any other
  // binding starts naming something that does not exist.
  //
  // The live gateway is the `staging` env below, which binds to
  // `hlada-api-staging` and is unaffected by any of this.
  "services": [
    {
      "binding": "MAIN_APP",
      "service": "hlada-api"
    }
  ],

  "observability": {
    "enabled": true
  },

  // ── OBSERVABILITY-TODO ────────────────────────────────────────────
  // Two bindings the observability slice needs are declared here as
  // comments rather than config, deliberately: turning them on changes
  // what a deploy produces, and that needs Andri's approval. The gate
  // `scripts/analysis/observability/check-observability.mjs` (OB9/OB12)
  // fails while these remain commented, so this cannot be forgotten.
  //
  // 1. Workers Analytics Engine — OCPP economics counters (metrics.ts).
  //    The dataset is created on first write, so no account-side setup
  //    is required; the name below is a proposal, not a discovered one.
  //
  //    "analytics_engine_datasets": [
  //      { "binding": "OCPP_METRICS", "dataset": "straumvakt_ocpp_metrics" }
  //    ],
  //
  // 2. Worker version id — becomes the Sentry release, so a regression
  //    can be keyed to a deploy. This is also the project's single
  //    blocking release gap (no version id has ever been recorded).
  //
  //    "version_metadata": { "binding": "CF_VERSION_METADATA" },
  //
  // SENTRY_DSN is a *secret*, set with `wrangler secret put SENTRY_DSN`.
  // It must never appear in this file — a DSN is a credential.
  // Full procedure: docs/notes/2026-08-11-sentry-analytics-engine-setup-runbook.md
  // ──────────────────────────────────────────────────────────────────

  // Hibernation API is the recommended pattern for long-lived charger
  // connections — WebSockets don't hold the Worker in memory between
  // frames. Secrets (OCPP_INGEST_SECRET — shared with main app) live in
  // the Cloudflare dashboard, never here.
  "env": {
    "staging": {
      "name": "straumvakt-ocpp-staging",
      "durable_objects": {
        "bindings": [
          {
            "name": "IDENTITY_DO",
            "class_name": "IdentityDurableObject"
          }
        ]
      },
      "services": [
        {
          "binding": "MAIN_APP",
          "service": "hlada-api-staging"
        }
      ],

      // ── S0 · THE CHARGER-FACING HOSTNAMES ─────────────────────────
      //
      // Both of these serve live charger traffic RIGHT NOW. Verified
      // 2026-08-18 by a read-only session:
      //
      //   ws.straumvakt.org                          → this Worker.
      //       Proven by tailing straumvakt-ocpp-staging while requesting
      //       /health?probe=… and watching the probe arrive.
      //   straumvakt-ocpp-staging.straumvakt.workers.dev → this Worker.
      //       GET /health returns 200 "ok".
      //
      // ADR 0035 records chargers configured against the workers.dev
      // host; the custom domain was added later, out of band. Until every
      // charger's device config is audited, ASSUME THE FLEET IS SPLIT
      // ACROSS BOTH and preserve both. 21 chargers hold live WebSockets.
      //
      // WHY THIS BLOCK EXISTS AT ALL: until now neither hostname appeared
      // in any committed config — they existed only in the dashboard. So
      // nothing in version control recorded that they exist, and nothing
      // would restore them if they were lost.
      //
      // WHY workers_dev IS EXPLICIT: declaring `routes` without it makes
      // wrangler infer workers_dev=false, which REMOVES the workers.dev
      // hostname on the next deploy. That is gate OB19's foot-gun, and
      // here it would disconnect whichever chargers use that host. The
      // `true` below is load-bearing — do not "tidy" it away.
      "routes": [{ "pattern": "ws.straumvakt.org", "custom_domain": true }],
      "workers_dev": true,
      // Sprint 5 / ADR 0017 — inbound OCPP events queue. The DO
      // enqueues raw envelopes here instead of awaiting a synchronous
      // service-binding write to apps/api. apps/api is the consumer
      // (config in apps/api/wrangler.jsonc). Local-dev `wrangler dev
      // --local` may run without this binding — the DO falls back to
      // direct service binding so the simulator dev loop is unchanged.
      "queues": {
        "producers": [
          {
            "binding": "OCPP_EVENTS_QUEUE",
            "queue": "straumvakt-ocpp-events-staging"
          }
        ]
      }
    }
  }
}
