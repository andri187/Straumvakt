  actor        User?         @relation(fields: [actorUserId], references: [id])

  @@index([orgId, occurredAt(sort: Desc)])
  @@index([targetType, targetId, occurredAt(sort: Desc)])
  @@map("actions")
  @@schema("audit")
}

enum ActorKind {
