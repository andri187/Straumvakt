// ─────────────────────────────────────────────────────────────────────────────
// events — append-only event log (source of truth) + idempotency
// ─────────────────────────────────────────────────────────────────────────────

// Sprint 7.2 / ADR 0018 Decision 1 — events.event_log is now a
// PARTITIONED table (RANGE on recorded_at, daily partitions).
// Postgres requires the partition key to be part of the primary
// key, so the PK is composite (id, recorded_at) instead of just id.
// Prisma sees the model unchanged in shape — only the @@id composition
// changes. The PARTITION BY declaration lives in the migration SQL,
// not here (Prisma 7 has no first-class partitioning syntax).
//
// Prisma diff awareness: future migrations to this model that add a
// column work fine (PARTITION BY survives column adds). Renames or
// type changes require dropping + recreating the partitioned parent;
// avoid those, or schedule the change with a dedicated migration
// that recreates partitions.
model EventLogEntry {
  id              String          @default(uuid()) @db.Uuid // UUIDv7 when driver lands it
  orgId           String          @map("org_id") @db.Uuid
  aggregateType   String          @map("aggregate_type")
  aggregateId    String           @map("aggregate_id") @db.Uuid
  eventType       String          @map("event_type")
  schemaVersion   Int             @map("schema_version") @default(1)
  payload         Json            @db.JsonB
  metadata        Json            @default("{}") @db.JsonB
  retentionClass  RetentionClass  @map("retention_class") @default(operational)
  occurredAt      DateTime        @map("occurred_at") @db.Timestamptz(6)
  recordedAt      DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)

  organization    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([id, recordedAt])
  @@index([orgId, occurredAt(sort: Desc)])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt(sort: Desc)])
  @@map("event_log")
  @@schema("events")
}

enum RetentionClass {
  financial     // indefinite, hot
  operational   // indefinite, hot, small
  raw_protocol  // 30–90 days, then deleted
  aggregate     // 12–24 months
  issue_history // indefinite

