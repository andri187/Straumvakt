// issues — tickets, timeline, detection rules (Issue Engine moat)
// ─────────────────────────────────────────────────────────────────────────────

model IssueTicket {
  id                    String        @id @default(uuid()) @db.Uuid
  orgId                 String        @map("org_id") @db.Uuid
  subjectType           IssueSubject  @map("subject_type")
  subjectId             String?       @map("subject_id") @db.Uuid
  category              String
  severity              IssueSeverity @default(medium)
  status                IssueStatus   @default(open)
  detectedBy            String        @map("detected_by")
  assignedToUserId      String?       @map("assigned_to_user_id") @db.Uuid
  assignedToContractorId String?      @map("assigned_to_contractor_id") @db.Uuid
  slaTargetAt           DateTime?     @map("sla_target_at") @db.Timestamptz(6)
  resolvedAt            DateTime?     @map("resolved_at") @db.Timestamptz(6)
  resolutionSummary     String?       @map("resolution_summary")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events                TicketEvent[]

  @@index([orgId, status, severity])
  @@index([subjectType, subjectId])
  @@map("tickets")
  @@schema("issues")
}

enum IssueSubject {
  charger
  ocpp_identity
  connector
  session
  site
  user
  other

  @@schema("issues")
}

enum IssueSeverity {
  low
  medium
  high
  critical

  @@schema("issues")
}

enum IssueStatus {
  open
  triaged
  assigned
  in_progress
  waiting
  resolved
  closed

  @@schema("issues")
}

model TicketEvent {
  id           String      @id @default(uuid()) @db.Uuid
  ticketId     String      @map("ticket_id") @db.Uuid
  eventType    String      @map("event_type")
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  payload      Json        @default("{}") @db.JsonB
  occurredAt   DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)

  ticket       IssueTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, occurredAt])
  @@map("ticket_events")
  @@schema("issues")
}

model DetectionRule {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  ruleKey     String       @map("rule_key")
  config      Json         @default("{}") @db.JsonB
  enabled     Boolean      @default(true)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, ruleKey])
  @@map("detection_rules")
  @@schema("issues")
}

// ─────────────────────────────────────────────────────────────────────────────
// events — append-only event log (source of truth) + idempotency
// ─────────────────────────────────────────────────────────────────────────────

model EventLogEntry {
  id              String          @id @default(uuid()) @db.Uuid // UUIDv7 when driver lands it
  orgId           String          @map("org_id") @db.Uuid
  aggregateType   String          @map("aggregate_type")
  aggregateId    String           @map("aggregate_id") @db.Uuid
  eventType       String          @map("event_type")
  schemaVersion   Int             @map("schema_version") @default(1)
  payload         Json            @db.JsonB
  metadata        Json            @default("{}") @db.JsonB
  retentionClass  RetentionClass  @map("retention_class") @default(operational)
  occurredAt      DateTime        @map("occurred_at") @db.Timestamptz(6)
  recordedAt      DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)

  organization    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, occurredAt(sort: Desc)])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt(sort: Desc)])
  @@map("event_log")
  @@schema("events")
}

enum RetentionClass {
  financial     // indefinite, hot
  operational   // indefinite, hot, small
  raw_protocol  // 30–90 days, then deleted
  aggregate     // 12–24 months
  issue_history // indefinite

  @@schema("events")
}

model IdempotencyKey {
  scope      String   // 'ocpp:<identity>', 'api', 'webhook:<partner>'
  key        String
  result     Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("events")
}

