  members        FamilyMembership[]

  @@index([orgId])
  @@map("family_groups")
  @@schema("people")
}

model FamilyMembership {
  familyGroupId String       @map("family_group_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  memberKind    MemberKind   @map("member_kind")
  joinedAt      DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)

  familyGroup   FamilyGroup  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([familyGroupId, userId])
  @@map("family_memberships")
  @@schema("people")
}

enum MemberKind {
  primary
  family_user

  @@schema("people")
}

// ─────────────────────────────────────────────────────────────────────────────
// vendors — adapter health + contract test results
// ─────────────────────────────────────────────────────────────────────────────

model VendorAdapterHealth {
  id            String   @id @default(uuid()) @db.Uuid
