// ─────────────────────────────────────────────────────────────────────────────
// billing — plans, tariffs, subscriptions, invoices
// Money is BIGINT minor units (aurar / öre / cents). No floats, no decimals.
// ─────────────────────────────────────────────────────────────────────────────

model Tariff {
  id           String     @id @default(uuid()) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  displayName  String     @map("display_name")
  rule         Json       @db.JsonB // interpreted by the tariff engine
  currency     String     // ISO 4217
  validFrom    DateTime   @map("valid_from") @db.Timestamptz(6)
  validUntil   DateTime?  @map("valid_until") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerPlans CustomerPlan[]

  @@index([orgId])
  @@map("tariffs")
  @@schema("billing")
}

model CustomerPlan {
  id                   String        @id @default(uuid()) @db.Uuid
  orgId                String        @map("org_id") @db.Uuid
  code                 String
  displayName          String        @map("display_name")
  description          String?
  balanceType          BalanceType   @map("balance_type")
  category             PlanCategory
  products             Json          @default("[]") @db.JsonB // setup/subscription/RFID/usage credit
  defaultTariffId      String?       @map("default_tariff_id") @db.Uuid
  terminationBehavior  TerminationBehavior @map("termination_behavior") @default(evergreen)
  minCommitmentMonths  Int?          @map("min_commitment_months")
  costFactor           Decimal?      @map("cost_factor") @db.Decimal(8, 4)
  country              String?
  currency             String?
  locale               String?
  validFrom            DateTime      @map("valid_from") @db.Timestamptz(6)
  validUntil           DateTime?     @map("valid_until") @db.Timestamptz(6)
  status               String        @default("active")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  defaultTariff        Tariff?       @relation(fields: [defaultTariffId], references: [id])
  subscriptions        Subscription[]

  @@unique([orgId, code])
  @@map("customer_plans")
  @@schema("billing")
}

enum BalanceType {
  prepaid
  postpaid
  non_paying
  pay_immediately
  postpaid_immediately

  @@schema("billing")
}

enum PlanCategory {
  single_tariff
  membership
  roaming
  guest_otp

  @@schema("billing")
}

enum TerminationBehavior {
  terminate
  evergreen
  rollover

  @@schema("billing")
}

model Subscription {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @map("org_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  planId     String       @map("plan_id") @db.Uuid
