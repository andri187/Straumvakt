  sitesDsoTariff           Site[]           @relation("SiteDsoTariff")
  sitesUsrfTariff          Site[]           @relation("SiteUsrfTariff")
  sitesUsrfPremTariff      Site[]           @relation("SiteUsrfPremTariff")
  sitesXtrrfTariff         Site[]           @relation("SiteXtrrfTariff")
  sitesSpvivfTariff        Site[]           @relation("SiteSpvivfTariff")
  installationsRetailerTariff Installation[] @relation("InstallationRetailerTariff")
  stationsChrgrfTariff     ChargingStation[]  @relation("StationChrgrfTariff")
  driverContractsWrkpfTariff DriverContract[] @relation("DriverContractWrkpfTariff")

  @@index([orgId, costFactorId, validFrom])
