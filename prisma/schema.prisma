  displayName   String        @map("display_name")
  status        String        @default("active")
  metadata      Json          @default("{}") @db.JsonB
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site          Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  chargingStation ChargingStation?
  meter         Meter?
  modem         Modem?
  controller    Controller?

  @@index([orgId, siteId])
  @@index([kind, status])
  @@map("site_assets")
  @@schema("properties")
}

enum SiteAssetKind {
  charger
  meter
  modem
  controller

  @@schema("properties")
}

// Installation — optional grouping between Site and charger-kind SiteAssets.
// Used for AC vendor-managed hardware (Zaptec Pro, Easee One) where the vendor
// portal models an installation and credentials cover the whole group.
// OCPP-only chargers and DC chargers typically have no Installation.
model Installation {
  // ── Sprint 0 (ADR 0001 + ADR 0002) ───────────────────────────────
  id                     String                        @id @default(uuid()) @db.Uuid
  orgId                  String                        @map("org_id") @db.Uuid
  siteId                 String                        @map("site_id") @db.Uuid
  vendorId               String?                       @map("vendor_id") @db.Uuid
  modelId                String?                       @map("model_id") @db.Uuid
  displayName            String                        @map("display_name")
  vendorInstallationRef  String?                       @map("vendor_installation_ref")
  credentialsRef         String?                       @map("credentials_ref")
  credentialsId          String?                       @map("credentials_id") @db.Uuid
  credentialsStatus      String?                       @map("credentials_status")
  onboardingStatus       InstallationOnboardingStatus  @map("onboarding_status") @default(pending_credentials)
  metadata               Json                          @default("{}") @db.JsonB
  createdAt              DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ── Rev-3 (ADR 0008 — REPF anchor) ───────────────────────────────
  retailerTariffId       String?                       @map("retailer_tariff_id") @db.Uuid

  // ── ADR 0014 / Sprint 4 milestone 4.6 — auth-enforce gate ────────
  // When true, the OCPP gateway honours the verdict from
  // /api/internal/ocpp-authorize for every Authorize.req at this
  // installation's chargers (Reject/Block/Expire/Accept). When false
  // (default), the gateway logs the verdict for observability but
  // always replies Accepted — today's shadow-mode behaviour.
  // Operator flips per-installation once the IdToken table is
  // verified seeded (Sprint 3 backfill) AND every operator-known
  // card has a row.
  enforceAuthorize       Boolean                       @default(false) @map("enforce_authorize")

  // ── Sprint 9 / ADR 0019 (2026-05-08) — load-bearing for agreements ──
  // Gates: factor enlistment (IDL/NET MDU-only), DriverGroup audience
  // flavors, TRD bearer applicability, public-vs-membership semantics.
  installationType       InstallationType              @default(workplace) @map("installation_type")

  // ── Existing relations ───────────────────────────────────────────
  organization           Organization                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site                   Site                          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  vendor                 HardwareVendor?               @relation(fields: [vendorId], references: [id])
  model                  HardwareModel?                @relation(fields: [modelId], references: [id])
  credentials            VendorCredential?             @relation("InstallationCredential", fields: [credentialsId], references: [id])
  chargingStations       ChargingStation[]
  circuits               Circuit[]

  // ── Tariff-definition relation (rev-3) ───────────────────────────
  retailerTariff         TariffDefinition?             @relation("InstallationRetailerTariff", fields: [retailerTariffId], references: [id])

  // ── ADR 0014 / API onboarding (back-relations) ───────────────────
  vendorUserRefs         UserVendorRef[]               @relation("InstallationVendorUserRefs")
  scopedIdTokens         IdToken[]                     @relation("InstallationIdTokens")
  vendorUserGroups       VendorUserGroup[]             @relation("InstallationVendorUserGroups")

  // ── Sprint 9 / ADR 0019 (2026-05-08) — agreements back-relation ──
  agreementsAtInstallation Agreement[]                 @relation("AgreementInstallation")

  // ── ADR 0029 — billing child-objects under this installation ─────
  billObjects              BillObject[]                @relation("BillObjectInstallation")

  // ── ADR 0022 (2026-05-31 addendum) — self-onboarding access requests ──
  driverAccessRequests     DriverAccessRequest[]       @relation("InstallationDriverAccessRequests")

  @@index([orgId, siteId])
  @@index([vendorId])
  @@map("installations")
  @@schema("properties")
}

// Sprint 9 / ADR 0019 (2026-05-08) — installation classification.
// Lives in the properties schema next to the installations table that
// uses it.
enum InstallationType {
  workplace
  mdu
  public
  private
  mixed

  @@schema("properties")
}

enum InstallationOnboardingStatus {
  pending_credentials
  discovering
  active
  suspended
  error

  @@schema("properties")
}

// ─────────────────────────────────────────────────────────────────────────────
// assets — kind-specific hardware records, extending SiteAsset
// ─────────────────────────────────────────────────────────────────────────────

// ── Rev-5 (ADR 0012) — Charger renamed to ChargingStation ──────────
// Physical equipment lives independently of the control plane. EVSE +
// Connector are split out below. Control attachments (ocpp.identities,
// vendors.vendor_asset_refs, roaming.external_cpms_refs) anchor here.

model ChargingStation {
  // Inherits ID from SiteAsset (preserves the Sprint 0 invariant that
  // every physical asset has a SiteAsset row).
  siteAssetId      String        @id @map("site_asset_id") @db.Uuid
  orgId            String        @map("org_id") @db.Uuid             // operator (the SaaS tenant)
  modelId          String?       @map("model_id") @db.Uuid
  installationId   String?       @map("installation_id") @db.Uuid
  vendor           String?
  model            String?
  // System-wide unique. Populated from Zaptec DeviceId (uppercase)
  // on import — canonical hardware serial stamped on the device.
  serialNumber     String?       @unique @map("serial_number")
  installDate      DateTime?     @map("install_date") @db.Date
  warrantyExpires  DateTime?     @map("warranty_expires") @db.Date
  firmwareVersion  String?       @map("firmware_version")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ── Rev-3 (ADRs 0007 + 0008) ────────────────────────────────────
  circuitId        String?       @map("circuit_id") @db.Uuid
  ownerOrgId       String?       @map("owner_org_id") @db.Uuid
  chrgrfTariffId   String?       @map("chrgrf_tariff_id") @db.Uuid

  // ── OCPP BootNotification profile (1.6 §6.2 / 2.0.1 §1.4) ────────
  // Auto-populated by the charger.booted projection on each
  // BootNotification. Operator-edited fields below the dashed line.
  chargeBoxSerialNumber String? @map("charge_box_serial_number") // legacy 1.6 alt-serial
  meterType             String? @map("meter_type")
  meterSerialNumber     String? @map("meter_serial_number")
  iccid                 String?                                  // SIM ICCID (cellular chargers)
  imsi                  String?                                  // SIM IMSI

  // ── Operator-domain fields (Sprint 3 enrichment) ──────────────────
  locationNote     String?       @map("location_note") @db.Text  // "north wall, slot 3"
  mountingType     String?       @map("mounting_type")            // wall | pedestal | floor | other
  photoUrl         String?       @map("photo_url")
  ipRating         String?       @map("ip_rating")                // IP54, IP65, …
  breakerAmps      Int?          @map("breaker_amps")             // upstream breaker

  // ── BLE tap-and-access (Sprint 9 / 2026-05-10) ───────────────────
  // What the charger broadcasts over BLE so the Flutter driver app
  // can detect proximity. kind='zaptec_serial' | 'ibeacon_uuid' | 'mac'.
  bleAdvertisingId   String?     @map("ble_advertising_id")
  bleAdvertisingKind String?     @map("ble_advertising_kind")

  // ── Lifetime kWh cache (Sprint 3 / ADR 0013) ──────────────────────
  // Persisted snapshot of Zaptec SignedMeterValueKwh (the OCMF-signed
  // cumulative meter reading). Updated write-through on every successful
  // per-charger detail fetch where the new value ≥ the cached one
  // (regressions are rejected — meters don't run backwards). Two reasons
  // to cache:
  //   1) Survival across offline windows. When Zaptec stops returning
  //      the value (or returns a stale one) we still show the last known
  //      total instead of "—".
  //   2) Survival across decommissioning. Zaptec sometimes drops the
  //      meter value when a charger goes Active=false; once we've
  //      observed it we own it.
  // Decimal(12,3) holds up to 999_999_999.999 kWh — well past any single
  // charger's lifetime (a 22 kW charger running flat-out for 100 years
  // would reach ~19M kWh).
  lifetimeKwhCached      Decimal?  @map("lifetime_kwh_cached") @db.Decimal(12, 3)
  lifetimeKwhObservedAt  DateTime? @map("lifetime_kwh_observed_at") @db.Timestamptz(6)

  // ── Telemetry snapshot cache (Sprint 8.4.3) ───────────────────────
  // Last-known live read from Zaptec /api/chargers/{id}/state. Stored
  // verbatim as JSONB so the technical-read panel can render
  // last-known values when the live fetch fails (charger offline from
  // Zaptec's cloud, transient network blip, vendor rate limit). The
  // panel marks fields stale when reading from cache and shows the
  // observed-at timestamp. Write-through happens after every
  // successful state fetch.
  lastTelemetryRead      Json?     @map("last_telemetry_read") @db.JsonB
  lastTelemetryAt        DateTime? @map("last_telemetry_at") @db.Timestamptz(6)

  // ── Firmware detail + online-since (Sprint 8.4.7) ─────────────────
  // Extracted from Zaptec /state observations on every cron tick (8.13.2)
  // so the /chargers list view can show them without a per-row Zaptec
  // round-trip. firmwareVersion above mirrors StateId 911; these three
  // are the rest of the firmware identity. onlineSinceAt is the
  // Timestamp on StateId -2 when ValueAsString=true — cleared when the
  // charger flips offline.
  mainboardSwVersion     String?   @map("mainboard_sw_version")        // StateId 908
  smartBootloaderVersion String?   @map("smart_bootloader_version")    // StateId 912
  hardwareVersion        String?   @map("hardware_version")             // StateId 913
  onlineSinceAt          DateTime? @map("online_since_at") @db.Timestamptz(6)

  // ── Comm-mode + signal cache (Sprint 9.8) ─────────────────────────
  // Cron extracts StateId 150 (comm mode) + StateId 809 (signal RSSI)
  // from the per-charger /state response on each */1 tick and writes
  // them here so the /chargers list view can show them without a
  // per-row Zaptec round-trip.
  commMode               String?   @map("comm_mode")     // "Wi-Fi" / "LTE" / "PLC" / "Ethernet"
  signalDbm              Int?      @map("signal_dbm")    // negative dBm magnitude

  // Sprint 9 / 2026-05-10 — Local auth list (CSMS-side bookkeeping)
  // Tracks the listVersion Straumvakt last pushed via OCPP SendLocalList.
  // Per-charger because OCPP versions are per-charge-point. Defaults to 0
  // (matches the OCPP convention "no list synced"). Bumped monotonically
  // on each successful enqueue; on charger VersionMismatch the recovery
  // flow re-syncs to the charger's reported StateId 751 and retries.
  pushedAuthListVersion  Int       @default(0) @map("pushed_auth_list_version")

  // ── Existing relations ───────────────────────────────────────────
  siteAsset        SiteAsset     @relation(fields: [siteAssetId], references: [id], onDelete: Cascade)
  organization     Organization  @relation("StationOperator", fields: [orgId], references: [id])
  hardwareModel    HardwareModel? @relation(fields: [modelId], references: [id])
  installation     Installation? @relation(fields: [installationId], references: [id])

  // ── Rev-5 (ADR 0012) — physical children + control attachments ───
  evses              EVSE[]
  ocppIdentities     OcppIdentity[]
  vendorAssetRefs    VendorAssetRef[]
  externalCpmsRefs   ExternalCpmsRef[]
  capabilityProfiles CapabilityProfile[]
  controlRoutingPolicy ControlRoutingPolicy?
  sessions           ChargeSession[]
  liveSession        LiveSession?
  liveSessionSamples LiveSessionSample[] @relation("LiveSessionSampleCharger")

  // ── Rev-3 / Rev-4 relations ──────────────────────────────────────
  circuit          Circuit?      @relation("CircuitStations", fields: [circuitId], references: [id])
  ownerOrg         Organization? @relation("StationOwner", fields: [ownerOrgId], references: [id])
  chrgrfTariff     TariffDefinition? @relation("StationChrgrfTariff", fields: [chrgrfTariffId], references: [id])

  @@index([modelId])
  @@index([installationId])
  @@index([circuitId])
  @@index([ownerOrgId])
  @@map("charging_stations")
  @@schema("assets")
}

// ── Rev-5 (ADR 0012) — EVSE: an electric vehicle supply equipment
// unit inside a ChargingStation. OCPP 2.0.1 native concept; for OCPP
// 1.6 chargers, one EVSE per connector.

model EVSE {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  chargingStationId   String   @map("charging_station_id") @db.Uuid
  evseIndex           Int      @map("evse_index")
  maxPowerKw          Decimal? @map("max_power_kw") @db.Decimal(8, 2)
  phaseCount          Int?     @map("phase_count")
  status              String   @default("unknown")
  statusUpdatedAt     DateTime? @map("status_updated_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargingStation     ChargingStation  @relation(fields: [chargingStationId], references: [siteAssetId], onDelete: Cascade)
  connectors          Connector[]
  sessions            ChargeSession[]

  @@unique([chargingStationId, evseIndex])
  @@index([orgId, status])
  @@map("evses")
  @@schema("assets")
}

// ── Rev-5 (ADR 0012) — Connector moved from ocpp schema to assets.
// Anchors on EVSE, not on OcppIdentity.

model Connector {
  id              String          @id @default(uuid()) @db.Uuid
  orgId           String          @map("org_id") @db.Uuid
  evseId          String          @map("evse_id") @db.Uuid
  connectorIndex  Int             @map("connector_index")
  type            String          // Type2 / CCS2 / CHAdeMO / Schuko
  maxPowerKw      Decimal?        @map("max_power_kw") @db.Decimal(8, 2)
  status          String          @default("unknown")
  statusUpdatedAt DateTime?       @map("status_updated_at") @db.Timestamptz(6)
  // ── OCPP StatusNotification mirror (1.6 §4.9) ─────────────────────
  // Auto-populated by the connector.status_updated projection when
  // payload carries a non-NoError errorCode. Operator console renders
  // these alongside status to differentiate "Available" from
  // "Faulted (GroundFailure)".
  errorCode       String?         @map("error_code")
  vendorErrorCode String?         @map("vendor_error_code")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  evse            EVSE            @relation(fields: [evseId], references: [id], onDelete: Cascade)
  sessions        ChargeSession[]
  reservations    Reservation[]

  @@unique([evseId, connectorIndex])
  @@index([orgId])
  @@map("connectors")
  @@schema("assets")
}

// ── Rev-5 (ADR 0012) — control-plane policy + capability tables.
// Live in `assets` schema because they describe asset-level routing,
// not protocol-level state.

model CapabilityProfile {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  chargingStationId String   @map("charging_station_id") @db.Uuid
  controlPlane      String   @map("control_plane")
  capabilities      Json     @db.JsonB
  source            String   // 'declared' / 'observed' / 'imported'
  observedAt        DateTime? @map("observed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargingStation   ChargingStation @relation(fields: [chargingStationId], references: [siteAssetId], onDelete: Cascade)

  @@unique([chargingStationId, controlPlane])
  @@map("capability_profiles")
  @@schema("assets")
}

model ControlRoutingPolicy {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  chargingStationId String   @unique @map("charging_station_id") @db.Uuid
  routing           Json     @db.JsonB
  fallback          String?  @map("fallback_plane")
  status            String   @default("active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargingStation   ChargingStation @relation(fields: [chargingStationId], references: [siteAssetId], onDelete: Cascade)

  @@map("control_routing_policies")
  @@schema("assets")
}

model Meter {
  siteAssetId   String      @id @map("site_asset_id") @db.Uuid
  meterSerial   String?     @map("meter_serial")
  meterType     String?     @map("meter_type") // grid / submeter / pv / battery
  maxAmps       Int?        @map("max_amps")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  siteAsset     SiteAsset   @relation(fields: [siteAssetId], references: [id], onDelete: Cascade)

  @@map("meters")
  @@schema("assets")
}

model Modem {
  siteAssetId  String     @id @map("site_asset_id") @db.Uuid
  imei         String?    @unique
  carrier      String?
  iccid        String?
  lastSeenAt   DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  siteAsset    SiteAsset  @relation(fields: [siteAssetId], references: [id], onDelete: Cascade)

  @@map("modems")
  @@schema("assets")
}

model Controller {
  siteAssetId    String     @id @map("site_asset_id") @db.Uuid
  vendor         String?    // e.g. "shelly"
  deviceId       String?    @map("device_id")
  endpointUrl    String?    @map("endpoint_url")
  capabilities   Json       @default("{}") @db.JsonB
  lastSeenAt     DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  siteAsset      SiteAsset  @relation(fields: [siteAssetId], references: [id], onDelete: Cascade)

  @@map("controllers")
  @@schema("assets")
}

// ─────────────────────────────────────────────────────────────────────────────
// hardware — platform-level catalog of supported vendors and models.
// Not tenant-scoped: all Orgs see the same catalog. Model profiles are the
// template for charger / meter / modem / controller records. Credential
// scope on the model drives where adapter credentials attach (installation
// vs. OCPP identity vs. none).
// ─────────────────────────────────────────────────────────────────────────────

model HardwareVendor {
  id             String              @id @default(uuid()) @db.Uuid
  slug           String              @unique // e.g. "zaptec", "easee", "kempower", "shelly", "generic-ocpp"
  displayName    String              @map("display_name")
  kind           HardwareVendorKind
  website        String?
  apiKind        VendorApiKind       @map("api_kind") @default(none)
  supportContact Json                @default("{}") @map("support_contact") @db.JsonB
  status         String              @default("active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  models         HardwareModel[]
  installations  Installation[]
  credentials    VendorCredential[]

  @@map("vendors")
  @@schema("hardware")
}

// Per-org vendor portal credentials. The operator stores Zaptec / Easee /
// Kempower / etc. portal username + password under one of their orgs.
// Password is AES-GCM encrypted with a Worker-side KEK before insert
// (see apps/api/src/lib/credential-crypto.ts) — the DB never holds
// plaintext. Multiple installations can share one credential row, and
// org-scoped UI filters by ownerOrgId so an org user only sees their
// own org's credentials.
model VendorCredential {
  id             String          @id @default(uuid()) @db.Uuid
  ownerOrgId     String          @map("owner_org_id") @db.Uuid
  vendorId       String          @map("vendor_id") @db.Uuid
  username       String          @db.VarChar(200)
  passwordCipher Bytes?          @map("password_cipher")
  passwordIv     Bytes?          @map("password_iv")
  status         String          @default("active") // active | expired | revoked
  lastUsedAt     DateTime?       @map("last_used_at") @db.Timestamptz(6)
  notes          String?         @db.VarChar(500)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerOrg       Organization    @relation("OrgVendorCredentials", fields: [ownerOrgId], references: [id], onDelete: Cascade)
  vendor         HardwareVendor  @relation(fields: [vendorId], references: [id])
  installations  Installation[]  @relation("InstallationCredential")

  @@unique([ownerOrgId, vendorId, username])
  @@index([ownerOrgId])
  @@map("vendor_credentials")
  @@schema("hardware")
}

enum HardwareVendorKind {
  charger_ac
  charger_dc
  meter
  modem
  controller
  multi // vendors that span kinds (e.g. Shelly: modem + controller)

  @@schema("hardware")
}

enum VendorApiKind {
  oauth       // Zaptec Pro style — exchange user/pass for token, then refresh
  basic_auth  // Easee-style user/pass sent per request, or per-identity DC
  none        // no vendor API; OCPP-only

  @@schema("hardware")
}

model HardwareModel {
  id               String                @id @default(uuid()) @db.Uuid
  vendorId         String                @map("vendor_id") @db.Uuid
  slug             String                // unique per vendor, e.g. "zaptec-pro", "easee-one"
  displayName      String                @map("display_name")
  kind             HardwareVendorKind
  assetClass       AssetClass?           @map("asset_class") // ac/dc for chargers; null for non-chargers
  credentialScope  VendorCredentialScope @map("credential_scope") @default(none)
  profile          Json                  @default("{}") @db.JsonB // technical spec template: power, phases, connectors, OCPP versions
  status           String                @default("active")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendor           HardwareVendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  chargingStations ChargingStation[]
  installations    Installation[]

  @@unique([vendorId, slug])
  @@index([kind, status])
  @@map("models")
  @@schema("hardware")
}

enum VendorCredentialScope {
  installation // AC vendor-managed: creds on properties.installations
  identity     // DC vendor-managed: creds on ocpp.ocpp_identities
  none         // OCPP-only: no vendor API

  @@schema("hardware")
}

// ─────────────────────────────────────────────────────────────────────────────
// ocpp — OCPP identities (control endpoints), connectors, outbound commands
// ─────────────────────────────────────────────────────────────────────────────

model OcppIdentity {
  // ── Rev-5 (ADR 0012) ──────────────────────────────────────────────
  // Now a control attachment on ChargingStation, not the parent of the
  // physical hierarchy. Capabilities + control routing moved to
  // assets.capability_profiles + assets.control_routing_policies.
  id                   String         @id @default(uuid()) @db.Uuid
  orgId                String         @map("org_id") @db.Uuid
  chargingStationId    String         @map("charging_station_id") @db.Uuid
  identityString       String         @map("identity_string")
  // Nullable since the no-auth installation feature: NULL means "this
  // identity accepts WebSocket upgrades without Basic Auth." Operator
  // opts in per installation by submitting an empty plaintext through
  // the password manager. Default for newly-onboarded chargers stays
  // populated; only the explicit empty-set path nulls this column.
  authSecretHash       String?        @map("auth_secret_hash")
  ocppVersion          OcppVersion    @map("ocpp_version")
  assetClass           AssetClass     @map("asset_class") @default(ac)
  vendor               String?
  vendorResourceId     String?        @map("vendor_resource_id")
  credentialsRef       String?        @map("credentials_ref")
  credentialsStatus    String?        @map("credentials_status")
  status               String         @default("provisioned")
  lastSeenAt           DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargingStation      ChargingStation  @relation(fields: [chargingStationId], references: [siteAssetId], onDelete: Cascade)
  outboundCommands     OutboundCommand[]
  configurationKeys    OcppConfigurationKey[]
  sessions             ChargeSession[]
  liveSession          LiveSession?

  @@unique([orgId, identityString])
  @@index([orgId, chargingStationId])
  @@map("ocpp_identities")
  @@schema("ocpp")
}

// Pre-onboarding discoveries — populated by the OCPP gateway auth path
// when a charger presents Basic-Auth that does not match any
// OcppIdentity row. Operators see these in /chargers/pending and click
// Claim to pre-fill the create-charger form. The row is deleted on
// successful provision (charger create with matching identity_string).
//
// Identity-string is PK because the discovery is platform-wide before
// any org claims it.
model PendingDiscovery {
  identityString     String   @id @map("identity_string") @db.VarChar(64)
  firstSeenAt        DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt         DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  attemptCount       Int      @default(0) @map("attempt_count")
  remoteAddr         String?  @map("remote_addr") @db.VarChar(64)
  userAgent          String?  @map("user_agent") @db.VarChar(255)
  lastPayloadSummary Json?    @map("last_payload_summary") @db.JsonB

  @@index([lastSeenAt(sort: Desc)])
  @@map("pending_discoveries")
  @@schema("ocpp")
}

enum OcppVersion {
  ocpp_1_6
  ocpp_2_0_1
  ocpp_2_1

  @@schema("ocpp")
}

enum AssetClass {
  ac
  dc

  @@schema("ocpp")
}

// ── Rev-5 (ADR 0012) — Connector moved to assets schema (defined
// above near ChargingStation/EVSE). Old definition removed.

model OutboundCommand {
  id              String       @id @default(uuid()) @db.Uuid
  orgId           String       @map("org_id") @db.Uuid
  identityId      String       @map("identity_id") @db.Uuid
  controlDomain   String       @map("control_domain")
  routedTo        String       @map("routed_to") // 'ocpp' or 'vendor:<name>'
  payload         Json         @db.JsonB
  status          CommandStatus @default(pending)
  attempts        Int          @default(0)
  notBefore       DateTime     @map("not_before") @db.Timestamptz(6)
  lastAttemptAt   DateTime?    @map("last_attempt_at") @db.Timestamptz(6)
  result          Json?        @db.JsonB
  correlationId   String       @map("correlation_id") @db.Uuid
  requestedBy     String?      @map("requested_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  identity        OcppIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  requester       User?        @relation("OutboundCommandRequester", fields: [requestedBy], references: [id])

  @@index([status, notBefore])
  @@index([orgId, identityId])
  @@map("outbound_commands")
  @@schema("ocpp")
}

enum CommandStatus {
  pending
  sent
  acked
  failed
  cancelled

  @@schema("ocpp")
}

// ─────────────────────────────────────────────────────────────────────────────
// charging — sessions, meter values, reservations
// ─────────────────────────────────────────────────────────────────────────────

model ChargeSession {
  // ── Rev-5 (ADR 0012) — anchors on EVSE; ocppIdentity/connector now optional ─
  id                String        @id @default(uuid()) @db.Uuid
  orgId             String        @map("org_id") @db.Uuid
  siteId            String        @map("site_id") @db.Uuid
  chargingStationId String        @map("charging_station_id") @db.Uuid
  evseId            String        @map("evse_id") @db.Uuid
  connectorId       String?       @map("connector_id") @db.Uuid
  ocppIdentityId    String?       @map("ocpp_identity_id") @db.Uuid
  userId            String?       @map("user_id") @db.Uuid
  idTag             String?       @map("id_tag")
  startedAt         DateTime      @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?     @map("ended_at") @db.Timestamptz(6)
  energyWh          BigInt?       @map("energy_wh")
  stopReason        String?       @map("stop_reason")
  status            SessionStatus @default(in_progress)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ── Rev-3 (ADR 0008) — rolled-up summary from billing_lines at session-stop ─
  costExVatMinor    BigInt?   @map("cost_ex_vat_minor")
  costIncVatMinor   BigInt?   @map("cost_inc_vat_minor")

  // ── Sprint 9 / 2026-05-08 — Zaptec StateId 723 (CompletedSession) capture ──
  // Persisted by the AMQP handler when 723 fires at session-end. Same
  // shape as /api/chargehistory but arrives on the AMQP path within
  // milliseconds of session-stop. Includes parsed OCMF IS/IT/ID/IL/IF
  // identity (RFID today, EVCCID/EMAID once Zaptec ships PnC firmware).
  completedSessionRawJson  Json?     @map("completed_session_raw_json") @db.JsonB
  ocmfSignedSession        String?   @map("ocmf_signed_session") @db.Text
  ocmfFormatVersion        String?   @map("ocmf_format_version")
  ocmfGatewayId            String?   @map("ocmf_gateway_id")
  ocmfGatewaySerial        String?   @map("ocmf_gateway_serial")
  ocmfGatewayVersion       String?   @map("ocmf_gateway_version")
  authIdStatus             Boolean?  @map("auth_id_status")
  authIdLevel              String?   @map("auth_id_level")
  authIdType               String?   @map("auth_id_type")
  authIdValue              String?   @map("auth_id_value")
  authIdFlags              String[]  @map("auth_id_flags")
  ocmfFirstReadingKwh      Decimal?  @map("ocmf_first_reading_kwh") @db.Decimal(14, 4)
  ocmfLastReadingKwh       Decimal?  @map("ocmf_last_reading_kwh") @db.Decimal(14, 4)
  ocmfSignedSessionKwh     Decimal?  @map("ocmf_signed_session_kwh") @db.Decimal(14, 4)
  completedSessionSeenAt   DateTime? @map("completed_session_seen_at") @db.Timestamptz(6)

  // ── Sprint 9 / ADR 0021 — Autocharge: vehicle identity capture ──
  // Three confidence tiers stored alongside the OCMF identity above
  // (which is the application-layer tier). See ADR 0021 for the full
  // story.
  //
  //   Link layer:        ev_plc_mac (StateId 953 MacPlcModuleEv) —
  //                      EV's PLC modem MAC, exchanged during HomePlug
  //                      GreenPHY pairing. Persistent vehicle ID.
  //                      OUI prefix → vendor name (ev_plc_mac_oui_vendor).
  //                      ev_plc_pib_version (StateId 921) — vehicle's
  //                      PLC firmware version.
  //
  //   Protocol layer:    pnc_attempted (StateId 724) — vehicle initiated
  //                      ISO 15118 PnC. pnc_succeeded null/true/false
  //                      tracks the outcome. pnc_rejected_uuid (StateId
  //                      725) carries the UUID denied if PnC failed.
  //
  //   Plus cable_type    (StateId 714) — Mode 3 / Type 2 / etc.
  //
  // Privacy: ev_plc_mac is PII (per ADR 0021 §9). UI must gate on
  // operator permission and redact to last-3-bytes for non-priv views.
  evPlcMac                 String?   @map("ev_plc_mac")
  evPlcMacOuiVendor        String?   @map("ev_plc_mac_oui_vendor")
  evPlcPibVersion          String?   @map("ev_plc_pib_version")
  cableType                String?   @map("cable_type")
  pncAttempted             Boolean?  @map("pnc_attempted")
  pncSucceeded             Boolean?  @map("pnc_succeeded")
  pncRejectedUuid          String?   @map("pnc_rejected_uuid")

  // ── Sprint 9 / ENRICH-1 — per-source enrichment columns ─────────
  // Three feeds converge into charging.sessions: the OCPP gateway
  // (StartTransaction / MeterValues / StopTransaction), Zaptec REST
  // /chargehistory (CDR sync), and Zaptec AMQP (StateId 723
  // CompletedSession). Before ENRICH-1, the later writers silently
  // overwrote the OCPP-side `energy_wh` and `ended_at` — billing
  // had no audit trail of which source produced the final number.
  //
  // ENRICH-1 adds per-source mirror columns so each writer records
  // its own figure WITHOUT clobbering the canonical column. The
  // canonical columns (`energy_wh`, `ended_at`) remain the billing-
  // read source of truth for back-compat; CDR (the authoritative
  // figure today) overlays them in addition to populating
  // `cdr_energy_kwh` / `cdr_stopped_at`. AMQP enriches with the
  // OCMF reference but never touches the canonical columns.
  //
  // SessionLedger.verifiedSource + enrichmentStatus document which
  // source produced the canonical figure. All columns NULLABLE so
  // legacy rows survive without backfill.
  ocppEnergyKwh   Decimal?  @map("ocpp_energy_kwh") @db.Decimal(10, 4)
  cdrEnergyKwh    Decimal?  @map("cdr_energy_kwh")  @db.Decimal(10, 4)
  amqpEnergyKwh   Decimal?  @map("amqp_energy_kwh") @db.Decimal(10, 4)
  ocppStoppedAt   DateTime? @map("ocpp_stopped_at") @db.Timestamptz(6)
  cdrStoppedAt    DateTime? @map("cdr_stopped_at")  @db.Timestamptz(6)
  ocmfBlobRef     String?   @map("ocmf_blob_ref")

  organization      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site              Site             @relation(fields: [siteId], references: [id])
  chargingStation   ChargingStation  @relation(fields: [chargingStationId], references: [siteAssetId])
  evse              EVSE             @relation(fields: [evseId], references: [id])
  connector         Connector?       @relation(fields: [connectorId], references: [id])
  ocppIdentity      OcppIdentity?    @relation(fields: [ocppIdentityId], references: [id])
  user              User?            @relation(fields: [userId], references: [id])
  meterValues       MeterValue[]
  billingLines      BillingLine[]
  protocolTransactionRefs ProtocolTransactionRef[]
  importedCdrRefs   ImportedCdrRef[]

  // ── Sprint 9 / ADR 0019 — agreements schema back-relation ───────
  agreementBillingLines AgreementBillingLine[] @relation("AgreementBillingLineSession")

  @@index([orgId, startedAt(sort: Desc)])
  @@index([evseId, startedAt(sort: Desc)])
  @@index([userId, startedAt(sort: Desc)])
  // Sprint 9 / ADR 0021 — vehicle-recurrence lookup. Partial because the
  // vast majority of historical rows have ev_plc_mac NULL until AMQP
  // path lights up.
  @@index([evPlcMac])
  @@map("sessions")
  @@schema("charging")
}

enum SessionStatus {
