  siteId     String       @map("site_id") @db.Uuid
  policy     Json         @db.JsonB
  validFrom  DateTime     @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime?    @map("valid_until") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site       Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([orgId, siteId])
  @@map("site_energy_policies")
  @@schema("energy")
}

model PropertyEnergyPolicy {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  propertyId  String       @map("property_id") @db.Uuid
  policy      Json         @db.JsonB
  validFrom   DateTime     @map("valid_from") @db.Timestamptz(6)
  validUntil  DateTime?    @map("valid_until") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([orgId, propertyId])
  @@map("property_energy_policies")
  @@schema("energy")
}

model EnergyPlanningResult {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  siteId       String       @map("site_id") @db.Uuid
  calculatedAt DateTime     @default(now()) @map("calculated_at") @db.Timestamptz(6)
  result       Json         @db.JsonB

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([orgId, siteId, calculatedAt(sort: Desc)])
  @@map("energy_planning_results")
  @@schema("energy")
}

// ─────────────────────────────────────────────────────────────────────────────
// webhooks — outbound delivery subsystem
// ─────────────────────────────────────────────────────────────────────────────

model WebhookSubscription {
  id               String       @id @default(uuid()) @db.Uuid
  orgId            String       @map("org_id") @db.Uuid
  name             String
  endpointUrl      String       @map("endpoint_url")
  signingSecretRef String       @map("signing_secret_ref")
  scopes           String[]     // event_type filters; empty = all
  status           String       @default("active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries       WebhookDelivery[]
  deadLetters      WebhookDeadLetter[]

  @@index([orgId])
  @@map("subscriptions")
  @@schema("webhooks")
}

model WebhookDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  eventId        String              @map("event_id") @db.Uuid
  attempt        Int
  status         String
  responseCode   Int?                @map("response_code")
  responseBody   String?             @map("response_body")
  deliveredAt    DateTime?           @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt(sort: Desc)])
  @@map("deliveries")
  @@schema("webhooks")
}

model WebhookDeadLetter {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  eventId        String              @map("event_id") @db.Uuid
  payload        Json                @db.JsonB
  lastError      String?             @map("last_error")
  movedAt        DateTime            @default(now()) @map("moved_at") @db.Timestamptz(6)

  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, movedAt(sort: Desc)])
  @@map("dead_letters")
  @@schema("webhooks")
}

// ═════════════════════════════════════════════════════════════════════════════
// REV-3 / REV-4 ADDITIONS — ADRs 0007 + 0008 + 0009 + 0010 (Sprint 2.6)
// ═════════════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────────────────────────────────────
// tenancy — OrganizationRole enum (ADR 0010)
// 21-value enum supporting multi-role Org rows.
// ─────────────────────────────────────────────────────────────────────────────

enum OrganizationRole {
  csms_provider
  operator
  service_contractor
  installer
  vendor
  asset_owner
  payer
  beneficiary
  customer
  retailer
  dso
  tso
  producer
  aggregator
  public_charging
  home_charging
  emsp
  roaming_hub
  payment_processor
  insurance_provider
  regulator

  @@schema("tenancy")
}

// ─────────────────────────────────────────────────────────────────────────────
// identity — PlatformAdmin (ADR 0008)
// ─────────────────────────────────────────────────────────────────────────────

model PlatformAdmin {
  userId          String              @id @map("user_id") @db.Uuid
  level           PlatformAdminLevel
  grantedAt       DateTime            @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedByUserId String?             @map("granted_by_user_id") @db.Uuid

  user            User                @relation("PlatformAdminUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User?               @relation("PlatformAdminGrantedBy", fields: [grantedByUserId], references: [id])

  @@map("platform_admins")
  @@schema("identity")
}

enum PlatformAdminLevel {
  read_only
  superuser

  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────────────────────
// properties — SiteType enum (ADR 0009 — moved here from hosts.HostType)
// + Circuit model (ADR 0007)
// ─────────────────────────────────────────────────────────────────────────────

enum SiteType {
  standard
  workplace
  mdu
  hotel
  fleet
  retail

  @@schema("properties")
}

model Circuit {
  id                String        @id @default(uuid()) @db.Uuid
  orgId             String        @map("org_id") @db.Uuid
  siteId            String        @map("site_id") @db.Uuid
  installationId    String?       @map("installation_id") @db.Uuid
  displayName       String        @map("display_name")
  ampereCeiling     Int?          @map("ampere_ceiling")
  phaseCount        Int           @map("phase_count") @default(3)
  vendorCircuitRef  String?       @map("vendor_circuit_ref")
  metadata          Json          @default("{}") @db.JsonB
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site              Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  installation      Installation? @relation(fields: [installationId], references: [id])
  chargingStations  ChargingStation[]   @relation("CircuitStations")

  @@index([orgId, siteId])
  @@index([installationId])
  @@map("circuits")
  @@schema("properties")
}

// ─────────────────────────────────────────────────────────────────────────────
// ocpp — OcppConfigurationKey registry (ADR 0010)
// Populated by GetConfiguration / ChangeConfiguration round-trips.
// Closes OCPP 1.6 spec gap — operator can see what's actually set on
// each charger with audit trail.
// ─────────────────────────────────────────────────────────────────────────────

model OcppConfigurationKey {
  id                  String        @id @default(uuid()) @db.Uuid
  orgId               String        @map("org_id") @db.Uuid
  ocppIdentityId      String        @map("ocpp_identity_id") @db.Uuid
  keyName             String        @map("key_name")
  keyValue            String?       @map("key_value")
  readonly            Boolean       @default(false)
  observedAt          DateTime      @map("observed_at") @db.Timestamptz(6)
  setByActorUserId    String?       @map("set_by_actor_user_id") @db.Uuid
  setAt               DateTime?     @map("set_at") @db.Timestamptz(6)
  notes               String?

  organization        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ocppIdentity        OcppIdentity  @relation(fields: [ocppIdentityId], references: [id], onDelete: Cascade)
  setByActor          User?         @relation("ConfigKeySetBy", fields: [setByActorUserId], references: [id])

  @@unique([ocppIdentityId, keyName])
  @@index([orgId, ocppIdentityId])
  @@map("configuration_keys")
  @@schema("ocpp")
}

// ─────────────────────────────────────────────────────────────────────────────
// billing — REV-3 cost-center splitting (ADR 0008)
// ─────────────────────────────────────────────────────────────────────────────

enum CostFactorAnchor {
  org
  property
  site
  installation
  circuit
  charger
  driver_contract

  @@schema("billing")
}

enum CostFactorStatus {
  draft
  active
  archived

  @@schema("billing")
}

model CostFactor {
  id                  String              @id @default(uuid()) @db.Uuid
  code                String              @unique
  displayName         String              @map("display_name")
  description         String?
  anchorTier          CostFactorAnchor    @map("anchor_tier")
  defaultVatRatePct   Decimal             @map("default_vat_rate_pct") @db.Decimal(4, 2)
  defaultCurrency     String              @map("default_currency") @default("ISK")
  status              CostFactorStatus    @default(active)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tariffDefinitions   TariffDefinition[]
  contractAssignments ContractFactorAssignment[]
  driverOverrides     DriverContractFactorOverride[]
  accumulators        ContractPeriodAccumulator[]
  billingLines        BillingLine[]

  @@map("cost_factors")
  @@schema("billing")
}

model TariffDefinition {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @map("org_id") @db.Uuid
  costFactorId    String           @map("cost_factor_id") @db.Uuid
  displayName     String           @map("display_name")
  computeRule     Json             @map("compute_rule") @db.JsonB
  vatRatePct      Decimal          @map("vat_rate_pct") @db.Decimal(4, 2)
  currency        String           @default("ISK")
  validFrom       DateTime         @map("valid_from") @db.Timestamptz(6)
  validUntil      DateTime?        @map("valid_until") @db.Timestamptz(6)
  status          String           @default("active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  costFactor      CostFactor       @relation(fields: [costFactorId], references: [id])

  // Anchor entities reference back via FK columns on Site / Installation /
  // Charger / DriverContract — listed below for relation completeness.
  sitesDsoTariff           Site[]           @relation("SiteDsoTariff")
  sitesUsrfTariff          Site[]           @relation("SiteUsrfTariff")
  sitesUsrfPremTariff      Site[]           @relation("SiteUsrfPremTariff")
  sitesXtrrfTariff         Site[]           @relation("SiteXtrrfTariff")
  sitesSpvivfTariff        Site[]           @relation("SiteSpvivfTariff")
  installationsRetailerTariff Installation[] @relation("InstallationRetailerTariff")
  stationsChrgrfTariff     ChargingStation[]  @relation("StationChrgrfTariff")
  driverContractsWrkpfTariff DriverContract[] @relation("DriverContractWrkpfTariff")

  @@index([orgId, costFactorId, validFrom])
  @@map("tariff_definitions")
  @@schema("billing")
}

model CostCenter {
  id                  String              @id @default(uuid()) @db.Uuid
  orgId               String              @map("org_id") @db.Uuid
  code                String
  displayName         String              @map("display_name")
  payerOrgId          String?             @map("payer_org_id") @db.Uuid
  payerUserId         String?             @map("payer_user_id") @db.Uuid
  beneficiaryOrgId    String?             @map("beneficiary_org_id") @db.Uuid
  status              String              @default("active")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization        @relation("CostCenterOrg", fields: [orgId], references: [id], onDelete: Cascade)
  payerOrg            Organization?       @relation("CostCenterPayer", fields: [payerOrgId], references: [id])
  payerUser           User?               @relation("CostCenterPayerUser", fields: [payerUserId], references: [id])
  beneficiaryOrg      Organization?       @relation("CostCenterBeneficiary", fields: [beneficiaryOrgId], references: [id])
  contractAssignments ContractFactorAssignment[]
  driverOverrides     DriverContractFactorOverride[]
  billingLines        BillingLine[]

  @@unique([orgId, code])
  @@map("cost_centers")
  @@schema("billing")
}

enum ContractScopeType {
  org
  property
  site
  installation
  charger

  @@schema("billing")
}

enum ContractStatus {
  pending_configuration
  active
  superseded
  archived

  @@schema("billing")
}

model Contract {
  id                  String                    @id @default(uuid()) @db.Uuid
  orgId               String                    @map("org_id") @db.Uuid
  scopeType           ContractScopeType         @map("scope_type")
  scopeId             String?                   @map("scope_id") @db.Uuid
  parentContractId    String?                   @map("parent_contract_id") @db.Uuid
  displayName         String                    @map("display_name")
  status              ContractStatus            @default(pending_configuration)
  validFrom           DateTime                  @map("valid_from") @db.Timestamptz(6)
  validUntil          DateTime?                 @map("valid_until") @db.Timestamptz(6)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent              Contract?                 @relation("ContractInheritance", fields: [parentContractId], references: [id])
  children            Contract[]                @relation("ContractInheritance")
  assignments         ContractFactorAssignment[]
  accumulators        ContractPeriodAccumulator[]

  @@index([orgId, scopeType, scopeId])
  @@map("contracts")
  @@schema("billing")
}

model ContractFactorAssignment {
  id                  String         @id @default(uuid()) @db.Uuid
  contractId          String         @map("contract_id") @db.Uuid
  costFactorId        String         @map("cost_factor_id") @db.Uuid
  costCenterId        String         @map("cost_center_id") @db.Uuid
  allocationRule      Json           @map("allocation_rule") @db.JsonB
  priority            Int            @default(0)
  validFrom           DateTime       @map("valid_from") @db.Timestamptz(6)
  validUntil          DateTime?      @map("valid_until") @db.Timestamptz(6)

  contract            Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  costFactor          CostFactor     @relation(fields: [costFactorId], references: [id])
  costCenter          CostCenter     @relation(fields: [costCenterId], references: [id])

  @@index([contractId, costFactorId, priority])
  @@map("contract_factor_assignments")
  @@schema("billing")
}

enum DriverContractOwnerType {
  workplace
  family_group
  self

  @@schema("billing")
}

model DriverContract {
  id                  String                          @id @default(uuid()) @db.Uuid
  orgId               String                          @map("org_id") @db.Uuid
  userId              String                          @map("user_id") @db.Uuid
  scopeType           ContractScopeType?              @map("scope_type")
  scopeId             String?                         @map("scope_id") @db.Uuid
  parentContractId    String?                         @map("parent_contract_id") @db.Uuid
  ownerType           DriverContractOwnerType         @map("owner_type")
  ownerId             String                          @map("owner_id") @db.Uuid
  wrkpfTariffId       String?                         @map("wrkpf_tariff_id") @db.Uuid
  displayName         String                          @map("display_name")
  status              ContractStatus                  @default(pending_configuration)
  validFrom           DateTime                        @map("valid_from") @db.Timestamptz(6)
  validUntil          DateTime?                       @map("valid_until") @db.Timestamptz(6)
  createdAt           DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user                User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent              DriverContract?                 @relation("DriverContractInheritance", fields: [parentContractId], references: [id])
  children            DriverContract[]                @relation("DriverContractInheritance")
  wrkpfTariff         TariffDefinition?               @relation("DriverContractWrkpfTariff", fields: [wrkpfTariffId], references: [id])
  overrides           DriverContractFactorOverride[]
  accumulators        ContractPeriodAccumulator[]

  @@index([orgId, userId, validFrom])
  @@map("driver_contracts")
  @@schema("billing")
}

model DriverContractFactorOverride {
  id                  String              @id @default(uuid()) @db.Uuid
  driverContractId    String              @map("driver_contract_id") @db.Uuid
  costFactorId        String              @map("cost_factor_id") @db.Uuid
  costCenterId        String              @map("cost_center_id") @db.Uuid
  allocationRule      Json                @map("allocation_rule") @db.JsonB
  priority            Int                 @default(0)
  scopeType           ContractScopeType?  @map("scope_type")
  scopeId             String?             @map("scope_id") @db.Uuid

  driverContract      DriverContract      @relation(fields: [driverContractId], references: [id], onDelete: Cascade)
  costFactor          CostFactor          @relation(fields: [costFactorId], references: [id])
  costCenter          CostCenter          @relation(fields: [costCenterId], references: [id])

  @@index([driverContractId, costFactorId, priority])
  @@map("driver_contract_factor_overrides")
  @@schema("billing")
}

model ContractPeriodAccumulator {
  id                          String          @id @default(uuid()) @db.Uuid
  orgId                       String          @map("org_id") @db.Uuid
  driverContractId            String?         @map("driver_contract_id") @db.Uuid
  contractId                  String?         @map("contract_id") @db.Uuid
  costFactorId                String          @map("cost_factor_id") @db.Uuid
  periodType                  String          @map("period_type") @default("calendar_month")
  periodStartDate             DateTime        @map("period_start_date") @db.Date
  periodEndDate               DateTime        @map("period_end_date") @db.Date
  cumulativeKwh               Decimal         @map("cumulative_kwh") @db.Decimal(12, 4) @default(0)
  cumulativeAmountExVatMinor  BigInt          @map("cumulative_amount_ex_vat_minor") @default(0)
  cumulativeSessionCount      Int             @map("cumulative_session_count") @default(0)
  lastSessionId               String?         @map("last_session_id") @db.Uuid
  updatedAt                   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization                Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  driverContract              DriverContract? @relation(fields: [driverContractId], references: [id])
  contract                    Contract?       @relation(fields: [contractId], references: [id])
  costFactor                  CostFactor      @relation(fields: [costFactorId], references: [id])

  @@unique([driverContractId, costFactorId, periodStartDate])
  @@unique([contractId, costFactorId, periodStartDate])
  @@index([orgId, periodStartDate])
  @@map("contract_period_accumulators")
  @@schema("billing")
}

model BillingLine {
  id                          String          @id @default(uuid()) @db.Uuid
  orgId                       String          @map("org_id") @db.Uuid
  sessionId                   String          @map("session_id") @db.Uuid
  costFactorId                String          @map("cost_factor_id") @db.Uuid
  costFactorCode              String          @map("cost_factor_code")
  costCenterId                String          @map("cost_center_id") @db.Uuid
  amountExVatMinor            BigInt          @map("amount_ex_vat_minor")
  vatRatePct                  Decimal         @map("vat_rate_pct") @db.Decimal(4, 2)
  vatAmountMinor              BigInt          @map("vat_amount_minor")
  amountIncVatMinor           BigInt          @map("amount_inc_vat_minor")
  currency                    String
  computationDetail           Json            @map("computation_detail") @db.JsonB
  createdAt                   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization                Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session                     ChargeSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  costFactor                  CostFactor      @relation(fields: [costFactorId], references: [id])
  costCenter                  CostCenter      @relation(fields: [costCenterId], references: [id])

  @@index([orgId, sessionId])
  @@index([costCenterId, createdAt(sort: Desc)])
  @@map("billing_lines")
  @@schema("billing")
}
