  p95LatencyMs  Int      @map("p95_latency_ms")
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)

  @@index([vendor, windowStart])
  @@map("adapter_health")
  @@schema("vendors")
}

model VendorContractTest {
  id        String   @id @default(uuid()) @db.Uuid
  vendor    String
  testName  String   @map("test_name")
  result    String   // pass/fail/skip
  runAt     DateTime @map("run_at") @db.Timestamptz(6)
  details   Json     @default("{}") @db.JsonB

  @@index([vendor, runAt(sort: Desc)])
  @@map("contract_tests")
  @@schema("vendors")
}

// ── Rev-5 (ADR 0012) — vendor API control attachment.
// Anchors a ChargingStation to its OEM API resource (Easee, Zaptec,
// Monta) when control flows through the vendor API rather than OCPP.

model VendorAssetRef {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  chargingStationId   String   @map("charging_station_id") @db.Uuid
  vendorSlug          String   @map("vendor_slug")
  vendorAssetId       String   @map("vendor_asset_id")
  credentialsRef      String?  @map("credentials_ref")
  capabilities        Json     @default("{}") @db.JsonB
  status              String   @default("pending")
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargingStation     ChargingStation  @relation(fields: [chargingStationId], references: [siteAssetId], onDelete: Cascade)

  @@unique([vendorSlug, vendorAssetId])
  @@index([orgId, vendorSlug])
  @@map("vendor_asset_refs")
  @@schema("vendors")
}

// ─────────────────────────────────────────────────────────────────────────────
// roaming — OCPI tokens, hub connections, CDR queue
// ─────────────────────────────────────────────────────────────────────────────

model OcpiToken {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  tokenUid    String       @map("token_uid")
  tokenType   String       @map("token_type") // RFID/APP_USER/AD_HOC_USER/OTHER
  partyId     String       @map("party_id")
  countryCode String       @map("country_code")
  valid       Boolean      @default(true)
  userId      String?      @map("user_id") @db.Uuid
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])

  @@unique([countryCode, partyId, tokenUid])
  @@index([orgId])
  @@map("ocpi_tokens")
  @@schema("roaming")
}

model HubConnection {
  id              String       @id @default(uuid()) @db.Uuid
  orgId           String       @map("org_id") @db.Uuid
  hub             HubKind
  partyId         String       @map("party_id")
  countryCode     String       @map("country_code")
  endpointUrl     String       @map("endpoint_url")
  credentialsRef  String       @map("credentials_ref") // secret store key
  status          String       @default("active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, hub])
  @@map("hub_connections")
  @@schema("roaming")
}

enum HubKind {
  hubject
  gireve
  direct

  @@schema("roaming")
}

model CdrQueueEntry {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  direction   CdrDirection
  partnerRef  String       @map("partner_ref")
  payload     Json         @db.JsonB
  status      String       @default("pending")
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@map("cdr_queue")
  @@schema("roaming")
}

enum CdrDirection {
  inbound
  outbound

  @@schema("roaming")
}

// ── Rev-5 (ADR 0012) — external CPMS overlay attachment.
// Anchors a ChargingStation to an externally-operated CPMS asset when
// Straumvakt is the operating/commercial layer above another CPMS.

model ExternalCpmsRef {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  chargingStationId   String   @map("charging_station_id") @db.Uuid
  externalCpmsSlug    String   @map("external_cpms_slug")
  externalAssetId     String   @map("external_asset_id")
  importMode          String   @map("import_mode")
  credentialsRef      String?  @map("credentials_ref")
  status              String   @default("pending")
  lastImportedAt      DateTime? @map("last_imported_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargingStation     ChargingStation  @relation(fields: [chargingStationId], references: [siteAssetId], onDelete: Cascade)

  @@unique([externalCpmsSlug, externalAssetId])
  @@index([orgId])
  @@map("external_cpms_refs")
  @@schema("roaming")
}

// ─────────────────────────────────────────────────────────────────────────────
// energy — site/property policies and planning results
// ─────────────────────────────────────────────────────────────────────────────

model SiteEnergyPolicy {
  id         String       @id @default(uuid()) @db.Uuid
