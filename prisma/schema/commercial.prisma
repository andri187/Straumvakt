// ───────────────────────────────────────────────────────────────────────────
// commercial — agreements, tariffs, invoices, priced records
// Postgres schemas: billing, agreements, entitlements, reports
// Depends on: charging, assets, identity. Top of the chain.
//
// NOTE: three billing generations coexist here. ADR 0025's premises are
// wrong (see docs/notes/2026-08-04-adr-0025-resolution-and-parked-decisions.md);
// decisions D1-D5 are unanswered. Nothing here is to be deleted or
// restructured until they are.
// ───────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// billing — plans, tariffs, subscriptions, invoices
// Money is BIGINT minor units (aurar / öre / cents). No floats, no decimals.
// ─────────────────────────────────────────────────────────────────────────────

model Tariff {
  id           String     @id @default(uuid()) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  displayName  String     @map("display_name")
  rule         Json       @db.JsonB // interpreted by the tariff engine
  currency     String     // ISO 4217
  validFrom    DateTime   @map("valid_from") @db.Timestamptz(6)
  validUntil   DateTime?  @map("valid_until") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("tariffs")
  @@schema("billing")
}

enum BalanceType {
  prepaid
  postpaid
  non_paying
  pay_immediately
  postpaid_immediately

  @@schema("billing")
}

enum PlanCategory {
  single_tariff
  membership
  roaming
  guest_otp

  @@schema("billing")
}

enum TerminationBehavior {
  terminate
  evergreen
  rollover

  @@schema("billing")
}

enum BillingTxType {
  payment
  refund
  penalty
  credit
  contract_charge
  external_payment

  @@schema("billing")
}

enum InvoiceStatus {
  draft
  issued
  paid
  void

  @@schema("billing")
}

// ─────────────────────────────────────────────────────────────────────────────
// billing — REV-3 cost-center splitting (ADR 0008)
// ─────────────────────────────────────────────────────────────────────────────

enum CostFactorAnchor {
  org
  property
  site
  installation
  circuit
  charger
  driver_contract

  @@schema("billing")
}

enum CostFactorStatus {
  draft
  active
  archived

  @@schema("billing")
}

model CostFactor {
  id                  String              @id @default(uuid()) @db.Uuid
  code                String              @unique
  displayName         String              @map("display_name")
  description         String?
  anchorTier          CostFactorAnchor    @map("anchor_tier")
  defaultVatRatePct   Decimal             @map("default_vat_rate_pct") @db.Decimal(4, 2)
  defaultCurrency     String              @map("default_currency") @default("ISK")
  status              CostFactorStatus    @default(active)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tariffDefinitions   TariffDefinition[]
  billingLines        BillingLine[]

  @@map("cost_factors")
  @@schema("billing")
}

model TariffDefinition {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @map("org_id") @db.Uuid
  costFactorId    String           @map("cost_factor_id") @db.Uuid
  displayName     String           @map("display_name")
  computeRule     Json             @map("compute_rule") @db.JsonB
  vatRatePct      Decimal          @map("vat_rate_pct") @db.Decimal(4, 2)
  currency        String           @default("ISK")
  validFrom       DateTime         @map("valid_from") @db.Timestamptz(6)
  validUntil      DateTime?        @map("valid_until") @db.Timestamptz(6)
  status          String           @default("active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  costFactor      CostFactor       @relation(fields: [costFactorId], references: [id])

  // Anchor entities reference back via FK columns on Site / Installation /
  // Charger / DriverContract — listed below for relation completeness.
  sitesDsoTariff           Site[]           @relation("SiteDsoTariff")
  sitesUsrfTariff          Site[]           @relation("SiteUsrfTariff")
  sitesUsrfPremTariff      Site[]           @relation("SiteUsrfPremTariff")
  sitesXtrrfTariff         Site[]           @relation("SiteXtrrfTariff")
  sitesSpvivfTariff        Site[]           @relation("SiteSpvivfTariff")
  installationsRetailerTariff Installation[] @relation("InstallationRetailerTariff")
  stationsChrgrfTariff     ChargingStation[]  @relation("StationChrgrfTariff")
  driverContractsWrkpfTariff DriverContract[] @relation("DriverContractWrkpfTariff")

  @@index([orgId, costFactorId, validFrom])
  @@map("tariff_definitions")
  @@schema("billing")
}

model CostCenter {
  id                  String              @id @default(uuid()) @db.Uuid
  orgId               String              @map("org_id") @db.Uuid
  code                String
  displayName         String              @map("display_name")
  payerOrgId          String?             @map("payer_org_id") @db.Uuid
  payerUserId         String?             @map("payer_user_id") @db.Uuid
  beneficiaryOrgId    String?             @map("beneficiary_org_id") @db.Uuid
  status              String              @default("active")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization        @relation("CostCenterOrg", fields: [orgId], references: [id], onDelete: Cascade)
  payerOrg            Organization?       @relation("CostCenterPayer", fields: [payerOrgId], references: [id])
  payerUser           User?               @relation("CostCenterPayerUser", fields: [payerUserId], references: [id])
  beneficiaryOrg      Organization?       @relation("CostCenterBeneficiary", fields: [beneficiaryOrgId], references: [id])
  billingLines        BillingLine[]

  @@unique([orgId, code])
  @@map("cost_centers")
  @@schema("billing")
}

enum ContractScopeType {
  org
  property
  site
  installation
  charger

  @@schema("billing")
}

enum ContractStatus {
  pending_configuration
  active
  superseded
  archived

  @@schema("billing")
}

model Contract {
  id                  String                    @id @default(uuid()) @db.Uuid
  orgId               String                    @map("org_id") @db.Uuid
  // Sprint 8.14 — counterparty (the other side of the bilateral
  // arrangement). For Straumvakt's operator-pilot model, orgId is
  // the customer (asset owner) and counterpartyOrgId is the
  // operator (Straumvakt). Nullable because legacy single-sided
  // rows pre-date this column. Both orgs see the same row via
  // listContractsByOrg's OR query.
  counterpartyOrgId   String?                   @map("counterparty_org_id") @db.Uuid
  scopeType           ContractScopeType         @map("scope_type")
  scopeId             String?                   @map("scope_id") @db.Uuid
  parentContractId    String?                   @map("parent_contract_id") @db.Uuid
  displayName         String                    @map("display_name")
  status              ContractStatus            @default(pending_configuration)
  validFrom           DateTime                  @map("valid_from") @db.Timestamptz(6)
  validUntil          DateTime?                 @map("valid_until") @db.Timestamptz(6)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization              @relation("ContractOwnerOrg", fields: [orgId], references: [id], onDelete: Cascade)
  counterparty        Organization?             @relation("ContractCounterpartyOrg", fields: [counterpartyOrgId], references: [id])
  parent              Contract?                 @relation("ContractInheritance", fields: [parentContractId], references: [id])
  children            Contract[]                @relation("ContractInheritance")

  @@index([orgId, scopeType, scopeId])
  @@index([counterpartyOrgId])
  @@map("contracts")
  @@schema("billing")
}

enum DriverContractOwnerType {
  workplace
  family_group
  self

  @@schema("billing")
}

model DriverContract {
  id                  String                          @id @default(uuid()) @db.Uuid
  orgId               String                          @map("org_id") @db.Uuid
  userId              String                          @map("user_id") @db.Uuid
  scopeType           ContractScopeType?              @map("scope_type")
  scopeId             String?                         @map("scope_id") @db.Uuid
  parentContractId    String?                         @map("parent_contract_id") @db.Uuid
  ownerType           DriverContractOwnerType         @map("owner_type")
  ownerId             String                          @map("owner_id") @db.Uuid
  wrkpfTariffId       String?                         @map("wrkpf_tariff_id") @db.Uuid
  displayName         String                          @map("display_name")
  status              ContractStatus                  @default(pending_configuration)
  validFrom           DateTime                        @map("valid_from") @db.Timestamptz(6)
  validUntil          DateTime?                       @map("valid_until") @db.Timestamptz(6)
  createdAt           DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user                User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent              DriverContract?                 @relation("DriverContractInheritance", fields: [parentContractId], references: [id])
  children            DriverContract[]                @relation("DriverContractInheritance")
  wrkpfTariff         TariffDefinition?               @relation("DriverContractWrkpfTariff", fields: [wrkpfTariffId], references: [id])

  @@index([orgId, userId, validFrom])
  @@map("driver_contracts")
  @@schema("billing")
}

model BillingLine {
  id                          String          @id @default(uuid()) @db.Uuid
  orgId                       String          @map("org_id") @db.Uuid
  sessionId                   String          @map("session_id") @db.Uuid
  costFactorId                String          @map("cost_factor_id") @db.Uuid
  costFactorCode              String          @map("cost_factor_code")
  costCenterId                String          @map("cost_center_id") @db.Uuid
  amountExVatMinor            BigInt          @map("amount_ex_vat_minor")
  vatRatePct                  Decimal         @map("vat_rate_pct") @db.Decimal(4, 2)
  vatAmountMinor              BigInt          @map("vat_amount_minor")
  amountIncVatMinor           BigInt          @map("amount_inc_vat_minor")
  currency                    String
  computationDetail           Json            @map("computation_detail") @db.JsonB
  createdAt                   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  organization                Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session                     ChargeSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  costFactor                  CostFactor      @relation(fields: [costFactorId], references: [id])
  costCenter                  CostCenter      @relation(fields: [costCenterId], references: [id])

  @@index([orgId, sessionId])
  @@index([costCenterId, createdAt(sort: Desc)])
  @@map("billing_lines")
  @@schema("billing")
}

// Per session: every billable charging session gets one row here.
// Written by the session.stopped projection in Sprint 8. Mirrors
// charging.charge_sessions but flattens for read performance:
// driver/charger/cost are denormalised so the billing dashboard
// doesn't need joins.
model SessionLedger {
  sessionId         String       @id @map("session_id") @db.Uuid
  orgId             String       @map("org_id") @db.Uuid
  siteId            String?      @map("site_id") @db.Uuid
  chargingStationId String?      @map("charging_station_id") @db.Uuid
  driverUserId      String?      @map("driver_user_id") @db.Uuid
  driverIdTag       String?      @map("driver_id_tag")
  startedAt         DateTime     @map("started_at") @db.Timestamptz(6)
  stoppedAt         DateTime?    @map("stopped_at") @db.Timestamptz(6)
  durationSec       Int?         @map("duration_sec")
  energyKwh         Decimal      @map("energy_kwh") @db.Decimal(10, 3) @default(0)
  costIskMinor      BigInt?      @map("cost_isk_minor")
  tariffDefinitionId String?     @map("tariff_definition_id") @db.Uuid
  computedAt        DateTime     @default(now()) @map("computed_at") @db.Timestamptz(6)

  // ── Sprint 9 / ENRICH-1 — provenance metadata ───────────────────
  // verifiedSource: which feed produced the canonical energy_kwh /
  //   cost the ledger row carries. "ocpp" | "cdr" | "amqp" |
  //   "reconciled". Default reality today: OCPP StopTransaction
  //   projection writes the ledger first (verifiedSource="ocpp"),
  //   then the CDR sync overlays with the authoritative Zaptec figure
  //   (verifiedSource="cdr"). AMQP never sets this — it enriches
  //   with OCMF reference only.
  // enrichmentStatus: "pending" until CDR or AMQP confirms the
  //   figure; "complete" when OCPP and CDR agree within 0.05 kWh;
  //   "mismatch" when they diverge; "stale" reserved for ops to
  //   flag rows where reconciliation never landed.
  // Validation enforced at the application layer (per ADR 0019
  // convention — TEXT for enums, no Postgres enum types).
  verifiedSource     String?     @map("verified_source")
  enrichmentStatus   String?     @map("enrichment_status")

  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt(sort: Desc)])
  @@index([driverUserId, startedAt(sort: Desc)])
  @@index([chargingStationId, startedAt(sort: Desc)])
  @@map("session_ledger")
  @@schema("reports")
}

// site_energy_daily and charger_uptime_daily are declared in assets.prisma;
// command_history in protocol.prisma. See the note above.

// ─────────────────────────────────────────────────────────────────────────────
// agreements — ADR 0019 (Sprint 9 milestone A.2)
//
// Three primitives: Agreement (legal contract Straumvakt <-> counterparty
// ORG), BearerRule (override row at a scope x audience cell — diff against
// the agreement default), RateReference (versioned rate book). Coexists
// additively with the legacy billing.contracts* tables (ADR 0008); cutover
// is a separate ADR after milestone A.6.
// ─────────────────────────────────────────────────────────────────────────────

enum AgreementType {
  // Commercial — Straumvakt's revenue from each customer party.
  service_cpo         // Straumvakt <-> CPO        (INT, USRF, CNR, RVN, PRM)
  service_contractor  // Straumvakt <-> Contractor (AGN, RVN)
  service_workplace   // Straumvakt <-> Workplace  (WRK)
  // Operational — CPO-authored, per-installation cost facts.
  installation        // CPO <-> themselves (per Installation)
  // Cost-bearing — CPO <-> Workplace mediated by Straumvakt.
  workplace           // Holds BearerRule overrides on installation factors only.

  @@schema("agreements")
}

enum AgreementStatus {
  draft
  active
  expired

  @@schema("agreements")
}

enum BearerType {
  org   // any Straumvakt-customer ORG (CPO / Contractor / Workplace).
        // bearer_ref optional; defaults to the agreement's counterparty_org_id.
  usr   // the driver running the session.
  trd   // another User. MDU only. bearer_ref required and revalidated at billing time.

  @@schema("agreements")
}

enum RuleScopeType {
  site
  installation
  circuit
  charger

  @@schema("agreements")
}

enum RuleAudienceType {
  driver_group
  user

  @@schema("agreements")
}

enum RateBasis {
  per_kwh
  per_minute
  per_day
  per_session
  // Added 2026-08-08 for the flat platform fee (Straumvakt -> host, principal).
  // Not session-derived: its quantity is a count of connectors on an org at a
  // point in time. The session resolver throws on it by design; the flat-fee
  // feeder emits those lines directly. See packages/commercial/src/agreement/types.ts.
  per_connector

  @@schema("agreements")
}

enum BillingLineKind {
  passthrough  // amount routes to the supplier on RateReference (e.g. Veitur, retailer)
  markup       // amount routes to CPO ORG (revenue line)

  @@schema("agreements")
}

enum AgrCostFactorStatus {
  draft
  active
  archived

  @@schema("agreements")
}

// Per ADR 0019 — revised cost-factor catalog (DSO, ELE, ACS, PRM, TRF, SRF,
// RNT, MTR). Coexists with the legacy billing.cost_factors catalog (DSOF,
// REPF, ...) until cutover. Seeded by milestone A.4.
model AgreementCostFactor {
  id              String                @id @default(uuid()) @db.Uuid
  code            String                @unique // DSO, ELE, ACS, PRM, TRF, SRF, RNT, MTR
  displayNameIs   String                @map("display_name_is")
  displayNameEn   String                @map("display_name_en")
  description     String?
  status          AgrCostFactorStatus   @default(active)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  rateReferences  RateReference[]
  clauses         AgreementClause[]
  bearerRules     BearerRule[]

  @@map("cost_factors")
  @@schema("agreements")
}

// Versioned rate book. Rules and Agreement defaults reference rates by
// `code` (stable identifier). New supplier rates land as new rows with
// updated effective_from; the resolver picks the row active at session_time.
model RateReference {
  id              String              @id @default(uuid()) @db.Uuid
  code            String              // e.g. "veitur-dso-c", "n1-retail-ele-2026q2"
  costFactorId    String              @map("cost_factor_id") @db.Uuid
  supplierOrgId   String?             @map("supplier_org_id") @db.Uuid // null when there is no external supplier (e.g. ACS, PRM)
  basis           RateBasis
  priceMinor      BigInt              @map("price_minor")               // currency-minor per unit basis
  currency        String              @default("ISK")
  vatRatePct      Decimal             @map("vat_rate_pct") @db.Decimal(4, 2)
  effectiveFrom   DateTime            @map("effective_from") @db.Timestamptz(6)
  effectiveUntil  DateTime?           @map("effective_until") @db.Timestamptz(6)
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  costFactor      AgreementCostFactor @relation(fields: [costFactorId], references: [id])
  supplierOrg     Organization?       @relation("RateReferenceSupplier", fields: [supplierOrgId], references: [id], onDelete: SetNull)

  @@index([code, effectiveFrom(sort: Desc)])
  @@index([costFactorId, effectiveFrom(sort: Desc)])
  @@map("rate_references")
  @@schema("agreements")
}

// Top-level legal contract between Straumvakt and a counterparty ORG. Either
// type=cpo (the ORG operates chargers) or type=workplace (the ORG absorbs
// factors on behalf of its drivers at someone else's chargers).
// Sprint 9 / ADR 0019 (2026-05-08 addendum) — five-type agreement.
// CHECK constraint pairs (agreement_type, cpo_org_id, installation_id):
//   service_cpo / service_contractor / service_workplace
//                                     → cpo_org_id NULL, installation_id NULL
//   installation                      → cpo_org_id NULL, installation_id NOT NULL
//   workplace                         → cpo_org_id NOT NULL, installation_id NULL
// See migration 20260508120000_agreements_v2.
model Agreement {
  id                    String              @id @default(uuid()) @db.Uuid
  agreementType         AgreementType       @map("agreement_type")
  counterpartyOrgId     String              @map("counterparty_org_id") @db.Uuid
  cpoOrgId              String?             @map("cpo_org_id") @db.Uuid
  installationId        String?             @map("installation_id") @db.Uuid
  defaultDriverGroupId  String?             @map("default_driver_group_id") @db.Uuid // public installations only
  displayName           String              @map("display_name")
  status                AgreementStatus     @default(draft)
  effectiveFrom         DateTime            @map("effective_from") @db.Timestamptz(6)
  effectiveUntil        DateTime?           @map("effective_until") @db.Timestamptz(6)
  notes                 String?
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  counterpartyOrg       Organization        @relation("AgreementCounterparty", fields: [counterpartyOrgId], references: [id], onDelete: Cascade)
  cpoOrg                Organization?       @relation("AgreementCpo", fields: [cpoOrgId], references: [id], onDelete: Restrict)
  installation          Installation?       @relation("AgreementInstallation", fields: [installationId], references: [id], onDelete: Restrict)

  clauses               AgreementClause[]
  driverGroups          DriverGroup[]
  bearerRules           BearerRule[]
  billingLines          AgreementBillingLine[]

  @@index([counterpartyOrgId, status])
  @@index([cpoOrgId])
  @@index([installationId])
  @@index([effectiveFrom])
  @@map("agreements")
  @@schema("agreements")
}

// Per-factor default for an Agreement. Names default bearer + rate ref +
// allocation. One row per (agreement, cost_factor) — only enlisted factors
// have a clause; non-enlisted factors are silently absent (no billing_line
// emitted at session-stop).
model AgreementClause {
  id                  String              @id @default(uuid()) @db.Uuid
  agreementId         String              @map("agreement_id") @db.Uuid
  costFactorId        String              @map("cost_factor_id") @db.Uuid
  defaultBearerType   BearerType          @map("default_bearer_type")
  defaultBearerRef    String?             @map("default_bearer_ref") @db.Uuid // required when defaultBearerType=trd
  defaultRateRefCode  String?             @map("default_rate_ref_code")       // null when factor has no rate (rare)
  allocationJson      Json                @map("allocation_json") @db.JsonB
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  agreement           Agreement           @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  costFactor          AgreementCostFactor @relation(fields: [costFactorId], references: [id])

  @@unique([agreementId, costFactorId])
  @@map("agreement_clauses")
  @@schema("agreements")
}

// A group of drivers under an Agreement. owner_org_id resolves the WRK
// bearer at session-stop. scope_filter_json is an opt-in restriction on
// where the group is allowed to charge (sites/installations/circuits/
// chargers); empty = no restriction.
model DriverGroup {
  id              String              @id @default(uuid()) @db.Uuid
  agreementId     String              @map("agreement_id") @db.Uuid
  ownerOrgId      String              @map("owner_org_id") @db.Uuid
  displayName     String              @map("display_name")
  scopeFilterJson Json                @default("{}") @map("scope_filter_json") @db.JsonB
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  agreement       Agreement           @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  ownerOrg        Organization        @relation("DriverGroupOwner", fields: [ownerOrgId], references: [id], onDelete: Restrict)

  memberships     DriverGroupMembership[]
  // ADR 0022 (2026-05-31 addendum) — auto-join target for email-domain rules
  emailDomainAutoJoinTargets OrgEmailDomain[] @relation("OrgEmailDomainDefaultGroup")
  // ADR 0028 — driver invite tokens conferring access to this group
  driverInviteTokens UserToken[] @relation("UserTokenDriverGroup")

  @@index([agreementId])
  @@index([ownerOrgId])
  @@map("driver_groups")
  @@schema("agreements")
}

model DriverGroupMembership {
  id              String              @id @default(uuid()) @db.Uuid
  driverGroupId   String              @map("driver_group_id") @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  addedAt         DateTime            @default(now()) @map("added_at") @db.Timestamptz(6)

  driverGroup     DriverGroup         @relation(fields: [driverGroupId], references: [id], onDelete: Cascade)
  user            User                @relation("DriverGroupMembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([driverGroupId, userId])
  @@index([userId])
  @@map("driver_group_memberships")
  @@schema("agreements")
}

// ─────────────────────────────────────────────────────────────────────────────
// billing — child-object attribution (ADR 0029)
// The BILLING spine (who pays), orthogonal to the ACCESS spine
// (DriverGroup → Agreement → scope, ADR 0019/0020). A ChargeSession's
// invoice recipient resolves: session → driver → BillObjectMember active
// at session.startedAt → BillObject → owner (ownerUser XOR ownerOrg).
// NOTE: the "owner at-most-one" rule (ownerUserId / ownerOrgId) is a
// CHECK constraint added by hand in the migration SQL — Prisma can't
// express it in-schema.
// ─────────────────────────────────────────────────────────────────────────────

model BillObject {
  id             String             @id @default(uuid()) @db.Uuid
  orgId          String             @map("org_id") @db.Uuid          // host org
  installationId String?            @map("installation_id") @db.Uuid // null for company-flat
  kind           BillObjectKind
  label          String
  parentId       String?            @map("parent_id") @db.Uuid       // self-FK for company hierarchy
  ownerUserId    String?            @map("owner_user_id") @db.Uuid   // person (kennitala-bearing)
  ownerOrgId     String?            @map("owner_org_id") @db.Uuid    // org (HOA / landlord / company)
  status         BillObjectStatus   @default(active)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization       @relation("BillObjectOrg", fields: [orgId], references: [id], onDelete: Cascade)
  installation   Installation?      @relation("BillObjectInstallation", fields: [installationId], references: [id], onDelete: SetNull)
  ownerUser      User?              @relation("BillObjectOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerOrg       Organization?      @relation("BillObjectOwnerOrg", fields: [ownerOrgId], references: [id], onDelete: SetNull)
  parent         BillObject?        @relation("BillObjectParent", fields: [parentId], references: [id], onDelete: SetNull)
  children       BillObject[]       @relation("BillObjectParent")
  members        BillObjectMember[]
  inviteTokens   UserToken[]        @relation("UserTokenBillObject")

  @@index([orgId, installationId])
  @@index([ownerUserId])
  @@index([ownerOrgId])
  @@map("bill_objects")
  @@schema("billing")
}

model BillObjectMember {
  id            String     @id @default(uuid()) @db.Uuid
  billObjectId  String     @map("bill_object_id") @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  // History-preserving: effectiveTo NULL = current. Ownership/occupancy
  // changes close the old row + open a new one so past sessions stay
  // attributed to who paid THEN (ADR 0029 §4).
  effectiveFrom DateTime   @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime?  @map("effective_to") @db.Timestamptz(6)

  billObject    BillObject @relation(fields: [billObjectId], references: [id], onDelete: Cascade)
  user          User       @relation("BillObjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveTo])
  @@index([billObjectId])
  @@map("bill_object_members")
  @@schema("billing")
}

enum BillObjectKind {
  apartment
  unit
  stall
  company
  department
  cost_center
  other

  @@schema("billing")
}

enum BillObjectStatus {
  active
  inactive

  @@schema("billing")
}

// ─────────────────────────────────────────────────────────────────────────────
// agreements — DriverAccessRequest (ADR 0022 / 2026-05-31 addendum)
//
// Operator inbox for the request-approve path of driver self-onboarding.
// Triggered either by the driver clicking "Request access to this charger"
// (triggeredBy='self_request') or by the email-verify handler matching an
// OrgEmailDomain row with policy='request_approval'
// (triggeredBy='email_domain_match').
//
// On approve: write a DriverGroupMembership row, set resultingMembershipId,
// status='approved'. Driver gets the standard access-granted email.
// On deny: status='denied', denialReason text, driver gets the denied email.
// ─────────────────────────────────────────────────────────────────────────────

model DriverAccessRequest {
  id                       String                       @id @default(uuid()) @db.Uuid
  userId                   String                       @map("user_id") @db.Uuid
  installationId           String                       @map("installation_id") @db.Uuid
  // @map is not optional here. Without it Prisma addresses a column named
  // "triggeredBy" and the column is "triggered_by", so EVERY query on this
  // model — read and write — failed with:
  //   The column `driver_access_requests.triggeredBy` does not exist
  // The whole driver access-request flow was dead. Found 2026-08-06 by
  // reconciling the schema against the database; the unit tests never caught
  // it because they run against a fake with no column names to get wrong.
  // It was the only field of 157 models missing a @map it needed.
  triggeredBy              DriverAccessRequestTrigger   @map("triggered_by")
  orgEmailDomainId         String?                      @map("org_email_domain_id") @db.Uuid
  status                   DriverAccessRequestStatus    @default(pending)
  reviewedByUserId         String?                      @map("reviewed_by_user_id") @db.Uuid
  reviewedAt               DateTime?                    @map("reviewed_at") @db.Timestamptz(6)
  denialReason             String?                      @map("denial_reason")
  resultingMembershipId    String?                      @map("resulting_membership_id") @db.Uuid
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                     User                         @relation("DriverAccessRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  installation             Installation                 @relation("InstallationDriverAccessRequests", fields: [installationId], references: [id], onDelete: Cascade)
  orgEmailDomain           OrgEmailDomain?              @relation("DriverAccessRequestFromDomain", fields: [orgEmailDomainId], references: [id], onDelete: SetNull)
  reviewedBy               User?                        @relation("DriverAccessRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, installationId])
  @@index([userId, status])
  @@map("driver_access_requests")
  @@schema("agreements")
}

enum DriverAccessRequestTrigger {
  self_request
  email_domain_match

  @@schema("agreements")
}

enum DriverAccessRequestStatus {
  pending
  approved
  denied
  withdrawn

  @@schema("agreements")
}

// The override row. Lives at one cell of (scope x audience). Each override
// field is independently nullable: NULL = inherit from the next walk step.
// One rule per cost factor (the ADR rejects factor=NULL wildcards in
// storage; UI may fan out a wildcard into per-factor rows on save).
model BearerRule {
  id              String              @id @default(uuid()) @db.Uuid
  agreementId     String              @map("agreement_id") @db.Uuid
  costFactorId    String              @map("cost_factor_id") @db.Uuid
  scopeType       RuleScopeType?      @map("scope_type")
  scopeId         String?             @map("scope_id") @db.Uuid
  audienceType    RuleAudienceType?   @map("audience_type")
  audienceId      String?             @map("audience_id") @db.Uuid
  bearerType      BearerType?         @map("bearer_type")           // null = inherit
  bearerRef       String?             @map("bearer_ref") @db.Uuid   // required when bearerType=trd
  rateRefCode     String?             @map("rate_ref_code")         // null = inherit
  allocationJson  Json?               @map("allocation_json") @db.JsonB // null = inherit
  effectiveFrom   DateTime            @map("effective_from") @db.Timestamptz(6)
  effectiveUntil  DateTime?           @map("effective_until") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  agreement       Agreement           @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  costFactor      AgreementCostFactor @relation(fields: [costFactorId], references: [id])

  // Resolver lookup — see ADR 0019 §"per-attribute walk has 13 lookup steps".
  @@index([agreementId, costFactorId, audienceType, audienceId, scopeType, scopeId, effectiveFrom])
  @@index([effectiveFrom])
  @@map("bearer_rules")
  @@schema("agreements")
}

// Output table — one row per (session, factor, kind). passthrough lines
// route to the supplier on RateReference; markup lines route to CPO ORG.
// Invoicing rolls billing_lines up by (recipient, period). Distinct from
// the legacy billing.billing_lines table (ADR 0008); both will coexist
// until cutover.
model AgreementBillingLine {
  id                String          @id @default(uuid()) @db.Uuid
  agreementId       String          @map("agreement_id") @db.Uuid
  // Sprint 9 / ADR 0019 (2026-05-08) — future-proofed for non-session events.
  // Values now: 'session'. Later: 'service_invoice', 'subscription',
  // 'manual_adjustment'. CHECK enforces session_id NOT NULL when type='session'.
  billableEventType String          @default("session") @map("billable_event_type")
  sessionId         String?         @map("session_id") @db.Uuid
  factorCode        String          @map("factor_code")
  kind              BillingLineKind
  basisType         RateBasis       @map("basis_type")
  basisQuantity     Decimal         @map("basis_quantity") @db.Decimal(14, 4) // kWh / minutes / days / sessions
  unitPriceMinor    BigInt          @map("unit_price_minor")
  amountExVatMinor  BigInt          @map("amount_ex_vat_minor")
  vatRatePct        Decimal         @map("vat_rate_pct") @db.Decimal(4, 2)
  vatAmountMinor    BigInt          @map("vat_amount_minor")
  amountIncVatMinor BigInt          @map("amount_inc_vat_minor")
  currency          String          @default("ISK")
  bearerType        BearerType      @map("bearer_type")
  bearerRef         String?         @map("bearer_ref") @db.Uuid
  recipientOrgId    String?         @map("recipient_org_id") @db.Uuid
  recipientUserId   String?         @map("recipient_user_id") @db.Uuid
  rateRefId         String?         @map("rate_ref_id") @db.Uuid
  ruleId            String?         @map("rule_id") @db.Uuid // BearerRule that won; null when only agreement defaults applied
  computationDetail Json            @map("computation_detail") @db.JsonB
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  agreement         Agreement       @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  session           ChargeSession?  @relation("AgreementBillingLineSession", fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([agreementId, billableEventType])
  @@index([sessionId, factorCode, kind])
  @@index([recipientOrgId, createdAt(sort: Desc)])
  @@map("billing_lines")
  @@schema("agreements")
}

// ─────────────────────────────────────────────────────────────────────────────
// CORE BILLING — persistence for packages/commercial/src/core-billing
//
// DOWNSTREAM MIRROR. Drizzle owns these tables (ADR 0051); the authoritative
// declarations are in packages/shared/src/db/commercial.ts, and that file
// carries the reasoning. This exists so `npm run check:schema-consistency`
// passes and so the ~500 un-ported Prisma calls can see the same database.
// Change Drizzle first, then mirror here, then `npm run sync:api-schema`.
//
// Deviation from the ADR 0019 convention noted at SessionLedger ("TEXT for
// enums, no Postgres enum types"): these DO use Postgres enums, matching the
// older billing.* tables above (BalanceType, CostFactorStatus, InvoiceStatus)
// rather than the newer agreements.* convention. The reason is that every one
// of these unions is already exhaustively typed AND tested in
// packages/commercial, so the set is closed by something stronger than a
// comment; a TEXT column would discard that at the storage layer. A
// mismatched member is caught by packages/shared/src/db/tests/core-billing-enums.test.ts.
// ─────────────────────────────────────────────────────────────────────────────

enum PeriodState {
  open
  closing
  closed

  @@schema("billing")
}

enum SettlementStatus {
  settled
  billing_review_required

  @@schema("billing")
}

enum SettlementProvenance {
  ocpp
  cdr
  manual
  unknown

  @@schema("billing")
}

enum ProvenanceState {
  estimated
  ocpp_derived
  cdr_pending
  cdr_confirmed
  cdr_mismatch
  corrected
  held_manual_review

  @@schema("billing")
}

enum ReviewReason {
  no_rate_at_session_start
  meter_unresolvable
  cdr_mismatch_beyond_tolerance
  negative_or_impossible_energy
  missing_session_times
  unsupported_compute_rule
  manual_hold

  @@schema("billing")
}

enum RateComponentKind {
  dso
  retailer
  cpo_addon

  @@schema("billing")
}

enum StatementRecipientKind {
  driver
  organisation

  @@schema("billing")
}

enum StatementLineKind {
  session_energy
  plug_time
  subscription_connector
  subscription_driver
  cap_relief
  correction

  @@schema("billing")
}

enum DeliveryChannel {
  email
  download
  webhook

  @@schema("billing")
}

enum DeliveryState {
  pending
  sending
  sent
  retrying
  failed
  abandoned

  @@schema("billing")
}

enum CorrectionReason {
  cdr_mismatch_resolved
  meter_fault
  tariff_misapplied
  duplicate_session
  customer_dispute
  operator_goodwill

  @@schema("billing")
}

// One row per org per calendar month. Natural key (org_id, year, month) —
// Core bills whole months, so there is no free date range to disagree about.
model BillingPeriod {
  id               String      @id @default(uuid()) @db.Uuid
  orgId            String      @map("org_id") @db.Uuid
  periodYear       Int         @map("period_year")
  periodMonth      Int         @map("period_month")
  periodStart      DateTime    @map("period_start") @db.Timestamptz(6)
  periodEnd        DateTime    @map("period_end") @db.Timestamptz(6)
  state            PeriodState @default(open)
  currency         String      @default("ISK")
  closedAt         DateTime?   @map("closed_at") @db.Timestamptz(6)
  closedByUserId   String?     @map("closed_by_user_id") @db.Uuid
  // CloseBlocker[] outstanding at the moment of close. Empty array = closed
  // clean. A period closed over three held sessions is a different fact from
  // one closed clean, and nobody remembers which six months later.
  blockersAtClose  Json?       @map("blockers_at_close") @db.JsonB
  reopenedAt       DateTime?   @map("reopened_at") @db.Timestamptz(6)
  reopenedByUserId String?     @map("reopened_by_user_id") @db.Uuid
  reopenReason     String?     @map("reopen_reason")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orgId, periodYear, periodMonth])
  @@index([orgId, state])
  @@map("billing_periods")
  @@schema("billing")
}

// The priced snapshot. PK is session_id alone: a session settles once, and a
// retried commit collides instead of double-billing.
model SessionSettlement {
  sessionId           String               @id @map("session_id") @db.Uuid
  orgId               String               @map("org_id") @db.Uuid
  periodId            String               @map("period_id") @db.Uuid
  connectorId         String?              @map("connector_id") @db.Uuid
  driverUserId        String?              @map("driver_user_id") @db.Uuid
  startedAt           DateTime             @map("started_at") @db.Timestamptz(6)
  stoppedAt           DateTime?            @map("stopped_at") @db.Timestamptz(6)
  energyWh            Int?                 @map("energy_wh")
  meterStartWh        Int?                 @map("meter_start_wh")
  meterStopWh         Int?                 @map("meter_stop_wh")
  cdrEnergyKwh        Decimal?             @map("cdr_energy_kwh") @db.Decimal(10, 3)
  plugTimeSeconds     Int?                 @map("plug_time_seconds")
  plugTimeFeeMinor    BigInt               @map("plug_time_fee_minor")
  amountExVatMinor    BigInt               @map("amount_ex_vat_minor")
  vatRatePct          Decimal              @map("vat_rate_pct") @db.Decimal(4, 2)
  vatMinor            BigInt               @map("vat_minor")
  totalIncVatMinor    BigInt               @map("total_inc_vat_minor")
  // The BILLED figure: whole ISK, half-up. Stored because it is what the
  // customer was shown; recomputing it later would adopt whatever rounding
  // rule is current then.
  totalIsk            BigInt               @map("total_isk")
  currency            String               @default("ISK")
  status              SettlementStatus
  provenance          SettlementProvenance
  provenanceState     ProvenanceState      @map("provenance_state")
  rateSelectionPolicy String               @default("start_rate") @map("rate_selection_policy")
  pricedAt            DateTime             @map("priced_at") @db.Timestamptz(6)
  committedAt         DateTime?            @map("committed_at") @db.Timestamptz(6)
  explanation         String
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([orgId, periodId])
  @@index([periodId, status])
  @@index([orgId, driverUserId, startedAt])
  @@index([orgId, connectorId, startedAt])
  @@map("session_settlements")
  @@schema("billing")
}

// Rate lock-in. unit_price_minor / effective_from / effective_until are
// COPIES, not joins: editing a rate row later cannot restate a settled
// session, because nothing reads the price back through rate_version_id.
model SettlementComponent {
  id               String            @id @default(uuid()) @db.Uuid
  sessionId        String            @map("session_id") @db.Uuid
  orgId            String            @map("org_id") @db.Uuid
  kind             RateComponentKind
  rateVersionId    String            @map("rate_version_id") @db.Uuid
  unitPriceMinor   BigInt            @map("unit_price_minor")
  effectiveFrom    DateTime          @map("effective_from") @db.Timestamptz(6)
  effectiveUntil   DateTime?         @map("effective_until") @db.Timestamptz(6)
  amountExVatMinor BigInt            @map("amount_ex_vat_minor")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sessionId, kind])
  @@index([orgId, rateVersionId])
  @@map("settlement_components")
  @@schema("billing")
}

// Why a session is not billable, and who cleared it. One row per (session,
// reason) — a session can be held for several reasons and each needs clearing.
model SettlementHold {
  id               String       @id @default(uuid()) @db.Uuid
  sessionId        String       @map("session_id") @db.Uuid
  orgId            String       @map("org_id") @db.Uuid
  reason           ReviewReason
  detail           String?
  raisedAt         DateTime     @default(now()) @map("raised_at") @db.Timestamptz(6)
  resolvedAt       DateTime?    @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId String?      @map("resolved_by_user_id") @db.Uuid
  resolution       String?
  // Enforced NOT NULL at the application layer once resolved: "resolved" with
  // no reason is indistinguishable from a mis-click, and this is the row an
  // auditor reads when a customer disputes a charge.
  resolutionNote   String?      @map("resolution_note")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sessionId, reason])
  @@index([orgId, resolvedAt])
  @@map("settlement_holds")
  @@schema("billing")
}

// One document per recipient per period.
model Statement {
  id                      String                 @id @default(uuid()) @db.Uuid
  orgId                   String                 @map("org_id") @db.Uuid
  periodId                String                 @map("period_id") @db.Uuid
  recipientKind           StatementRecipientKind @map("recipient_kind")
  recipientId             String                 @map("recipient_id") @db.Uuid
  // statementIdentity() — deterministic FNV-1a over (period, recipient,
  // sessionIds). A regenerate producing different content is DETECTABLE
  // rather than a silent overwrite.
  statementKey            String                 @map("statement_key")
  // Sum of the ROUNDED line amounts, not the rounding of the sum.
  totalIsk                BigInt                 @map("total_isk")
  currency                String                 @default("ISK")
  // Sessions deliberately left off this bill, by id. Excluding a session and
  // pricing it at zero look identical to a customer; they must not look
  // identical here.
  excludedSessionIds      Json                   @map("excluded_session_ids") @db.JsonB
  generatedAt             DateTime               @map("generated_at") @db.Timestamptz(6)
  generatedByUserId       String?                @map("generated_by_user_id") @db.Uuid
  supersededByStatementId String?                @map("superseded_by_statement_id") @db.Uuid
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([periodId, recipientKind, recipientId])
  @@index([orgId, periodId])
  @@index([orgId, recipientKind, recipientId])
  @@map("statements")
  @@schema("billing")
}

model StatementLine {
  id                String             @id @default(uuid()) @db.Uuid
  statementId       String             @map("statement_id") @db.Uuid
  orgId             String             @map("org_id") @db.Uuid
  lineNo            Int                @map("line_no")
  kind              StatementLineKind
  description       String
  quantity          Decimal?           @db.Decimal(14, 4)
  unit              String?
  unitPriceMinor    BigInt?            @map("unit_price_minor")
  // Unrounded aurar, kept for audit.
  amountMinor       BigInt             @map("amount_minor")
  // Billed whole ISK, half-up. These sum to statements.total_isk.
  amountIsk         BigInt             @map("amount_isk")
  sessionId         String?            @map("session_id") @db.Uuid
  correctsSessionId String?            @map("corrects_session_id") @db.Uuid
  correctionReason  CorrectionReason?  @map("correction_reason")
  reason            String?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([statementId, lineNo])
  @@index([orgId, sessionId])
  @@map("statement_lines")
  @@schema("billing")
}

// The provider-proof chain email has never had. Modelled on
// ocpp.outbound_commands, which already does this correctly in this codebase.
model StatementDeliveryAttempt {
  id                String          @id @default(uuid()) @db.Uuid
  statementId       String          @map("statement_id") @db.Uuid
  orgId             String          @map("org_id") @db.Uuid
  channel           DeliveryChannel @default(email)
  state             DeliveryState   @default(pending)
  attempts          Int             @default(0)
  notBefore         DateTime?       @map("not_before") @db.Timestamptz(6)
  lastAttemptAt     DateTime?       @map("last_attempt_at") @db.Timestamptz(6)
  // SendOutcomeKind: ack | retriable | permanent | not_configured. Kept
  // separate from `state` so "we never tried, the binding was missing" stops
  // being indistinguishable from "we tried and it bounced".
  outcomeKind       String?         @map("outcome_kind")
  providerMessageId String?         @map("provider_message_id")
  // Address at time of send. Recipients change; the record must not.
  destination       String?
  lastError         String?         @map("last_error")
  result            Json?           @db.JsonB
  idempotencyKey    String          @map("idempotency_key")
  requestedByUserId String?         @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([statementId, idempotencyKey])
  @@index([orgId, state])
  @@index([state, notBefore])
  @@map("statement_delivery_attempts")
  @@schema("billing")
}

// An operator asked for a file; this is what they got. content_hash makes
// "the export disagrees with the screen" a checkable claim, not an argument.
model StatementExport {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  periodId          String   @map("period_id") @db.Uuid
  format            String   @default("csv")
  rowCount          Int      @map("row_count")
  totalIsk          BigInt   @map("total_isk")
  contentHash       String   @map("content_hash")
  storageKey        String?  @map("storage_key")
  idempotencyKey    String   @map("idempotency_key")
  requestedByUserId String?  @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orgId, idempotencyKey])
  @@index([orgId, periodId])
  @@map("statement_exports")
  @@schema("billing")
}

// Idempotency for money mutations. Deliberately NOT events.idempotency_keys:
// that table has no org_id, its scope is the hardcoded literal "ocpp" in both
// writers, and its expires_at is written by both and read by neither — so an
// expired row suppresses a replay permanently. Sharing it would inherit that.
model BillingMutationReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  // Route-specific: period.close | statement.deliver | statement.export |
  // hold.resolve | rate.write
  scope          String
  idempotencyKey String   @map("idempotency_key")
  // Catches the case the key alone cannot: the same Idempotency-Key sent with
  // a DIFFERENT body, which must 409 rather than replay the first response.
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json?    @map("response_body") @db.JsonB
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  // Meant to be ENFORCED in the WHERE clause, not merely written.
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orgId, scope, idempotencyKey])
  @@index([expiresAt])
  @@map("mutation_receipts")
  @@schema("billing")
}

// 50 kr per active driver per month — this figure IS revenue, and it cannot be
// derived after the fact: session.user_id is nullable, "reporting activity"
// has no persisted event of any kind, and driver_group_memberships has
// added_at only with a unique that forbids the second row history would need.
// Written once per month, never recomputed.
model DriverActivityMonth {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  periodYear   Int      @map("period_year")
  periodMonth  Int      @map("period_month")
  driverUserId String   @map("driver_user_id") @db.Uuid
  // charging_session | reporting_access | roster_membership — why the driver
  // counted, so a disputed 50 kr has an answer.
  source       String
  sessionCount Int      @default(0) @map("session_count")
  firstSeenAt  DateTime @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt   DateTime @map("last_seen_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orgId, periodYear, periodMonth, driverUserId])
  @@index([orgId, periodYear, periodMonth])
  @@map("driver_activity_month")
  @@schema("reports")
}

// 200 kr per active connector per month, capped at 450. Same problem, other
// cause: assets.connectors carries a MUTABLE status with no history, and
// charging_stations has no status/active/removed column at all — a charger
// removed in August leaves no evidence it was billable in July.
model ConnectorActivityMonth {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  periodYear        Int      @map("period_year")
  periodMonth       Int      @map("period_month")
  connectorId       String   @map("connector_id") @db.Uuid
  chargingStationId String?  @map("charging_station_id") @db.Uuid
  // session_observed | status_available | manually_asserted
  source            String
  sessionCount      Int      @default(0) @map("session_count")
  activeDays        Int?     @map("active_days")
  firstSeenAt       DateTime @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt        DateTime @map("last_seen_at") @db.Timestamptz(6)
  // Whole ISK actually charged after the 450 cap. Stored rather than
  // recomputed: the cap depends on the same month's driver count, and
  // recomputing later would use whatever roster is current then.
  capAppliedIsk     BigInt?  @map("cap_applied_isk")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orgId, periodYear, periodMonth, connectorId])
  @@index([orgId, periodYear, periodMonth])
  @@map("connector_activity_month")
  @@schema("reports")
}

// DOWNSTREAM MIRROR of packages/shared/src/db/commercial.ts. Drizzle is
// authoritative (ADR 0051); this exists so check:schema-consistency passes and
// so the Prisma client still compiles while ~500 un-ported calls remain.

/// The append-only period lifecycle log — preflight delta 9.8.
/// Fine-grained state is DERIVED from these rows rather than asserted by a
/// caller's boolean. The Postgres PeriodState enum was deliberately not
/// widened: ALTER TYPE ... ADD VALUE cannot run in a transaction and cannot
/// be undone, so the fine states are text here.
model PeriodTransition {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  periodYear   Int      @map("period_year")
  periodMonth  Int      @map("period_month")
  // PeriodLifecycleState — not_opened | open | activity_sealed | priced | invoiced | closed
  fromState    String   @map("from_state")
  toState      String   @map("to_state")
  // PeriodEvent — open_period | seal_activity | record_pricing_settled | issue_invoice | close_period
  event        String
  // Never null. A transition nobody caused is one nobody can answer for.
  actorUserId  String   @map("actor_user_id") @db.Uuid
  reason       String?
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // No event occurs twice in one period's life, so a retried month-end job
  // collides here instead of double-recording.
  @@unique([orgId, periodYear, periodMonth, event])
  @@index([orgId, periodYear, periodMonth, occurredAt])
  @@map("period_transitions")
  @@schema("billing")
}

/// A human vouching for a connector — preflight delta 9.7.
/// Every connector on a vendor-native (Zaptec-authentication) installation
/// produces neither session nor StatusNotification evidence, permanently: the
/// Zaptec importer writes connector_id NULL on its sessions, and
/// StatusNotification only reaches events.event_log from our own OCPP gateway.
/// Without an assertion those connectors produce no activity row and the
/// period holds.
model ConnectorAssertion {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  periodYear       Int      @map("period_year")
  periodMonth      Int      @map("period_month")
  connectorId      String   @map("connector_id") @db.Uuid
  // Never null. An unattributed assertion is an unauditable one.
  assertedByUserId String   @map("asserted_by_user_id") @db.Uuid
  reason           String
  // Optional pointer at out-of-band proof — a work order, a photo, a ticket.
  evidenceNote     String?  @map("evidence_note")
  assertedAt       DateTime @map("asserted_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([orgId, periodYear, periodMonth, connectorId])
  @@index([orgId, periodYear, periodMonth])
  @@map("connector_assertions")
  @@schema("billing")
}

/// The counter behind an invoice number — migration 0004.
/// A counter ROW rather than a Postgres SEQUENCE: nextval is
/// non-transactional, so a rolled-back issue burns its value permanently.
/// Icelandic law wants unique AND gap-free; only the row gives both, at the
/// cost of serialising allocation per (org, series, year).
model DocumentNumberSeries {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  series      String
  periodYear  Int      @map("period_year")
  nextOrdinal Int      @default(1) @map("next_ordinal")
  padWidth    Int      @default(6) @map("pad_width")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orgId, series, periodYear])
  @@map("document_number_series")
  @@schema("billing")
}

/// Every number ever spent, and what it was spent on — migration 0004.
/// There is deliberately no release operation: a released number leaves a hole
/// the documents around it have already closed over. A number spent without a
/// live document is recorded `voided`, in place, and the sequence still
/// accounts for every ordinal.
model DocumentNumber {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  series         String
  periodYear     Int       @map("period_year")
  ordinal        Int
  documentNumber String    @map("document_number")
  // invoice | credit_note | correction. Text, not an enum: the accountant's
  // constraint is unanswered and ALTER TYPE cannot run in a transaction.
  purpose        String
  // issued | voided. Never deleted.
  status         String    @default("issued")
  statementId    String?   @map("statement_id") @db.Uuid
  // Never generated. A generated key makes every retry a fresh allocation.
  idempotencyKey String    @map("idempotency_key")
  issuedByUserId String?   @map("issued_by_user_id") @db.Uuid
  issuedAt       DateTime  @map("issued_at") @db.Timestamptz(6)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(6)
  voidReason     String?   @map("void_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Two documents cannot share a number.
  @@unique([orgId, series, periodYear, ordinal])
  // A retry gets the same number back rather than consuming another.
  @@unique([orgId, series, periodYear, idempotencyKey])
  // A second issue for one statement is refused at write time, so a caller
  // retrying under a DIFFERENT key collides here instead of spending a number.
  @@unique([statementId, purpose])
  @@index([orgId, issuedAt])
  @@map("document_numbers")
  @@schema("billing")
}
