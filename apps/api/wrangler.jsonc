{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hlada-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  // Service binding to the OCPP gateway Worker — admin command dispatch
  // (start/stop/reset) goes through the gateway. Same pattern as the
  // monolith Worker had. ADR 0004 governs the binding shape.
  "services": [
    {
      "binding": "OCPP_GATEWAY",
      "service": "straumvakt-ocpp"
    }
  ],
  // Staging env — deployed by `wrangler deploy --env staging` from
  // apps/api/. Secrets (DATABASE_URL, AUTH_SECRET, ADMIN_EMAIL,
  // ADMIN_PASSWORD, OCPP_INGEST_SECRET) live in the Cloudflare dashboard
  // for the hlada-api-staging Worker — never in this file.
  "env": {
    "staging": {
      "name": "hlada-api-staging",
      "services": [
        {
          "binding": "OCPP_GATEWAY",
          "service": "straumvakt-ocpp-staging"
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE_DB",
          "id": "d2d56ab1ffe241bbb64946ba78a52be5",
          "localConnectionString": "postgresql://placeholder:placeholder@localhost:5432/placeholder"
        }
      ],
      // R2 bucket — raw OCPP envelope archive (Sprint 7.4 / ADR 0018
      // Decision 3). Written by the archive consumer per the key
      // scheme `<orgId>/<yyyy>/<mm>/<dd>/<chargingStationId>/
      // <eventId>.json.gz`. Lifecycle rules (7y / 90d / 7d / 30d
      // tiers) configured separately via wrangler r2 bucket lifecycle.
      "r2_buckets": [
        {
          "binding": "EVIDENCE_BUCKET",
          "bucket_name": "straumvakt-evidence-staging"
        }
      ],
      // Queue pipelines:
      //
      // 1. OUTBOUND_QUEUE — admin-side command dispatch (start / stop /
      //    reset). Producer side is the admin enqueue routes; consumer
      //    side is this Worker (queue handler in src/index.ts). DLQ
      //    catches commands that fail after max_retries.
      //
      // 2. straumvakt-ocpp-events-staging — inbound OCPP events from
      //    the gateway DO (Sprint 5 / ADR 0017). The gateway is the
      //    producer; this Worker is the consumer. Consumer drains
      //    asynchronously so charger WebSocket replies stay sub-second
      //    even when Postgres is slow. DLQ catches poison messages
      //    after max_retries.
      //
      // 3. straumvakt-archive-events-staging — Sprint 7.4 / ADR 0018
      //    Decision 3. The inbound consumer fans out each accepted
      //    envelope to this queue; a separate consumer drains it to
      //    R2. Two queues so an R2 outage cannot block Postgres ack.
      //    Higher max_retries than the inbound queue because R2 hiccups
      //    are slower to resolve than Postgres ones.
      "queues": {
        "producers": [
          {
            "binding": "OUTBOUND_QUEUE",
            "queue": "straumvakt-outbound-staging"
          },
          {
            "binding": "ARCHIVE_QUEUE",
            "queue": "straumvakt-archive-events-staging"
          }
        ],
        "consumers": [
          {
            "queue": "straumvakt-outbound-staging",
            "max_batch_size": 5,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "dead_letter_queue": "straumvakt-outbound-dlq-staging"
          },
          // P4.14 — batch cadence. Was 1s. The 2026-05-12 note raised it
          // to 30s and measured ~50% fewer Neon CU-hours, but that change
          // is not in this file (reverted with fix-A) and its premise no
          // longer holds cleanly: Neon `suspend_timeout_seconds` is 0, so
          // the compute never autosuspends and the saving is connection
          // churn rather than wake-ups. The full win needs autosuspend
          // enabled on Neon — an operator decision, not a config line here.
          //
          // 10s is the middle ground. Timeout only bites below ~10 events/s;
          // past that `max_batch_size` fills first and the timeout is moot.
          // At today's handful of chargers that means up to 10s of ingest
          // lag on operator-visible StatusNotification — noticeable but
          // tolerable while ADR 0023's fanout is unbuilt and the console
          // polls anyway. 30s would have been very visible at this scale.
          // Revisit with P4-D measurements.
          {
            "queue": "straumvakt-ocpp-events-staging",
            "max_batch_size": 100,
            "max_batch_timeout": 10,
            "max_retries": 3,
            "dead_letter_queue": "straumvakt-ocpp-events-dlq-staging"
          },
          {
            "queue": "straumvakt-archive-events-staging",
            "max_batch_size": 50,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "straumvakt-archive-events-dlq-staging"
          }
        ]
      },
      // Sweeper cron — re-publishes any 'pending' outbox row whose
      // not_before is older than the staleness threshold (1 min in
      // dispatcher.sweepStuckPending). Catches the producer-publish-
      // failed race and DLQ'd rows.
      "triggers": {
        // Sprint 9.1 — fires every minute. Code branches in
        // index.ts scheduled() handler: minutes %5 == 0 run the full
        // sync (sessions + status + cache); other minutes run a
        // sessions-only sweep so /charge-log catches in-progress
        // sessions within ~1 minute even for chargers AMQP can't see.
        "crons": ["* * * * *"]
      },
      // Rate-limit bindings — Sprint 9 / AUD-2 FIX-2.
      // Consumed by apps/api/src/lib/rate-limit.ts. The helper fails
      // OPEN with a console.warn when these are missing, so removing
      // them won't lock anyone out — but the brute-force gate goes
      // dark. CF only supports `period` of 10 or 60 seconds (900 is
      // rejected at deploy time). See
      // docs/operator/RATE_LIMITER_BINDINGS_TODO.md for verification
      // steps. namespace_id values are arbitrary and per-Worker; reuse
      // in env.production when that block lands.
      "unsafe": {
        "bindings": [
          {
            "name": "ADMIN_LOGIN_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": { "limit": 10, "period": 60 }
          },
          {
            "name": "DRIVER_LOGIN_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1002",
            "simple": { "limit": 10, "period": 60 }
          }
        ]
      }
    }
  }
}
