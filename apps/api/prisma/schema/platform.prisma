  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt(sort: Desc)])
  @@map("deliveries")
  @@schema("webhooks")
}

model WebhookDeadLetter {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @map("subscription_id") @db.Uuid
  eventId        String              @map("event_id") @db.Uuid
  payload        Json                @db.JsonB
  lastError      String?             @map("last_error")
  movedAt        DateTime            @default(now()) @map("moved_at") @db.Timestamptz(6)

  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, movedAt(sort: Desc)])
  @@map("dead_letters")
  @@schema("webhooks")
}

// ── ADR 0039 D1 — events.protocol_log ───────────────────────────────
//
// Raw OCPP frames (retention_class = raw_protocol) split out of
// events.event_log. Identical column shape, identical daily RANGE
// partitioning on recorded_at, identical composite PK — so the write
// path differs only in the table name and the projection dispatcher is
// untouched.
//
// Why a second table rather than sub-partitioning event_log: a table
// can only be partitioned one way per level and the axis is already
// spent on time. Every day's partition mixed raw_protocol with
// keep-forever classes, so P4.15's drop gate correctly blocked on
// essentially every real partition and nothing ever reclaimed raw
// frames. ADR 0039 D4 records why composite partitioning was rejected.
//
// Retention: 7 days, enforced by DROP TABLE on the day partition — see
// DROPPABLE_PARENTS in apps/api/src/lib/db/partition-cron.ts. R2 stays
// the durable record (ADR 0039 D2); this table is a short-window
// forensics cache, NOT the system of record.
//
// No `organization` relation, deliberately. event_log's FK carries ON
// DELETE CASCADE, and cascading an org delete across ~2M rows/day of
// day partitions is exactly the heavy operation this ADR exists to
// avoid — and pointless, since every row here is gone within 7 days.
// The migration SQL creates no FK either, so schema and database agree.
//
// PARTITION BY lives in the migration SQL; Prisma 7 has no first-class
// partitioning syntax.
model ProtocolLogEntry {
  id             String         @default(uuid()) @db.Uuid
  orgId          String         @map("org_id") @db.Uuid
  aggregateType  String         @map("aggregate_type")
  aggregateId    String         @map("aggregate_id") @db.Uuid
  eventType      String         @map("event_type")
  schemaVersion  Int            @default(1) @map("schema_version")
  payload        Json           @db.JsonB
  metadata       Json           @default("{}") @db.JsonB
  retentionClass RetentionClass @default(raw_protocol) @map("retention_class")
  occurredAt     DateTime       @map("occurred_at") @db.Timestamptz(6)
  recordedAt     DateTime       @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@id([id, recordedAt])
  @@index([orgId, occurredAt(sort: Desc)])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt(sort: Desc)])
  @@map("protocol_log")
  @@schema("events")
}
