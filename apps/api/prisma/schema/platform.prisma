// ─────────────────────────────────────────────────────────────────────────────
// issues — tickets, timeline, detection rules (Issue Engine moat)
// ─────────────────────────────────────────────────────────────────────────────

model IssueTicket {
  id                    String        @id @default(uuid()) @db.Uuid
  orgId                 String        @map("org_id") @db.Uuid
  subjectType           IssueSubject  @map("subject_type")
  subjectId             String?       @map("subject_id") @db.Uuid
  category              String
  severity              IssueSeverity @default(medium)
  status                IssueStatus   @default(open)
  detectedBy            String        @map("detected_by")
  assignedToUserId      String?       @map("assigned_to_user_id") @db.Uuid
  assignedToContractorId String?      @map("assigned_to_contractor_id") @db.Uuid
  slaTargetAt           DateTime?     @map("sla_target_at") @db.Timestamptz(6)
  resolvedAt            DateTime?     @map("resolved_at") @db.Timestamptz(6)
  resolutionSummary     String?       @map("resolution_summary")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events                TicketEvent[]

  @@index([orgId, status, severity])
  @@index([subjectType, subjectId])
  @@map("tickets")
  @@schema("issues")
}

enum IssueSubject {
  charger
  ocpp_identity
  connector
  session
  site
  user
  other

  @@schema("issues")
}

enum IssueSeverity {
  low
  medium
  high
  critical

  @@schema("issues")
}

enum IssueStatus {
  open
  triaged
  assigned
  in_progress
  waiting
  resolved
  closed

  @@schema("issues")
}

model TicketEvent {
  id           String      @id @default(uuid()) @db.Uuid
  ticketId     String      @map("ticket_id") @db.Uuid
  eventType    String      @map("event_type")
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  payload      Json        @default("{}") @db.JsonB
  occurredAt   DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)

  ticket       IssueTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, occurredAt])
  @@map("ticket_events")
  @@schema("issues")
}

model DetectionRule {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  ruleKey     String       @map("rule_key")
  config      Json         @default("{}") @db.JsonB
  enabled     Boolean      @default(true)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, ruleKey])
  @@map("detection_rules")
  @@schema("issues")
}

// ─────────────────────────────────────────────────────────────────────────────
// events — append-only event log (source of truth) + idempotency
// ─────────────────────────────────────────────────────────────────────────────

// Sprint 7.2 / ADR 0018 Decision 1 — events.event_log is now a
// PARTITIONED table (RANGE on recorded_at, daily partitions).
// Postgres requires the partition key to be part of the primary
// key, so the PK is composite (id, recorded_at) instead of just id.
// Prisma sees the model unchanged in shape — only the @@id composition
// changes. The PARTITION BY declaration lives in the migration SQL,
// not here (Prisma 7 has no first-class partitioning syntax).
//
// Prisma diff awareness: future migrations to this model that add a
// column work fine (PARTITION BY survives column adds). Renames or
// type changes require dropping + recreating the partitioned parent;
// avoid those, or schedule the change with a dedicated migration
// that recreates partitions.
model EventLogEntry {
  id              String          @default(uuid()) @db.Uuid // UUIDv7 when driver lands it
  orgId           String          @map("org_id") @db.Uuid
  aggregateType   String          @map("aggregate_type")
  aggregateId    String           @map("aggregate_id") @db.Uuid
  eventType       String          @map("event_type")
  schemaVersion   Int             @map("schema_version") @default(1)
  payload         Json            @db.JsonB
  metadata        Json            @default("{}") @db.JsonB
  retentionClass  RetentionClass  @map("retention_class") @default(operational)
  occurredAt      DateTime        @map("occurred_at") @db.Timestamptz(6)
  recordedAt      DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)

  organization    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([id, recordedAt])
  @@index([orgId, occurredAt(sort: Desc)])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt(sort: Desc)])
  @@map("event_log")
  @@schema("events")
}

enum RetentionClass {
  financial     // indefinite, hot
  operational   // indefinite, hot, small
  raw_protocol  // 30–90 days, then deleted
  aggregate     // 12–24 months
  issue_history // indefinite

  @@schema("events")
}

// ── ADR 0037 D5 — archive confirmation for partition drop (P4.15) ───
//
// The archive queue consumer increments one row per (retention_class,
// UTC day) for every object it writes to R2. The partition-drop cron
// reads it and refuses to drop unless every (class, day) group in the
// partition is fully accounted for. Fails closed: no row means no drop.
//
// `day` is the UTC day of the envelope's occurred_at — the same date
// the R2 key carries — NOT event_log's recorded_at partition key. The
// cron groups partition rows by occurred_at before comparing so a
// late-arriving event is checked against the day its object actually
// landed under.
//
// object_count is a running total, never a snapshot: concurrent
// consumers must sum. R2 PUT is idempotent by key, so a queue retry
// can re-put the same object and inflate the count — the gate treats a
// surplus as an anomaly to log, and only a SHORTFALL as a block.
model ArchiveWatermark {
  retentionClass RetentionClass @map("retention_class")
  day            DateTime       @map("day") @db.Date
  objectCount    BigInt         @default(0) @map("object_count")
  lastWriteAt    DateTime       @map("last_write_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([retentionClass, day])
  @@index([day])
  @@map("archive_watermark")
  @@schema("events")
}

model IdempotencyKey {
  scope      String   // 'ocpp:<identity>', 'api', 'webhook:<partner>'
  key        String
  result     Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("events")
}

