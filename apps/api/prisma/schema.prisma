  @@map("enterprise_licenses")
  @@schema("entitlements")
}

// ─────────────────────────────────────────────────────────────────────────────
// people — family groups (primary driver + family members for AC pricing)
// ─────────────────────────────────────────────────────────────────────────────

model FamilyGroup {
  id             String            @id @default(uuid()) @db.Uuid
  orgId          String            @map("org_id") @db.Uuid
  displayName    String            @map("display_name")
  primaryUserId  String            @map("primary_user_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  primaryUser    User              @relation("FamilyGroupPrimary", fields: [primaryUserId], references: [id])
  members        FamilyMembership[]

  @@index([orgId])
  @@map("family_groups")
  @@schema("people")
}

model FamilyMembership {
  familyGroupId String       @map("family_group_id") @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  memberKind    MemberKind   @map("member_kind")
  joinedAt      DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)

  familyGroup   FamilyGroup  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
