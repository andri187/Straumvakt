// Straumvakt — V3 Foundation Schema
//
// Sprint 0 deliverable. Supersedes the empty stub.
//
// Conventions (see docs/architecture/STRAUMVAKT_ARCHITECTURE_V3.md §10):
//   • UUIDv7 primary keys (Postgres gen_random_uuid() is acceptable through v7 adoption)
//   • Every operational row carries org_id (the tenant)
//   • Money as BIGINT minor units — no Float, no Decimal ambiguity
//   • JSONB for "shape may grow" fields; regular columns for things that must index
//   • Soft delete only where strictly required (users for compliance); otherwise status columns
//   • Audit columns (created_at / updated_at) on every operational table
//
// Schema namespaces (18) map 1:1 to Postgres schemas via multiSchema:
//   identity, tenancy, hosts, properties, assets, hardware, ocpp,
//   charging, billing, issues, events, audit, entitlements, people,
//   vendors, roaming, energy, webhooks

// Prisma 7 prisma-client generator with runtime: cloudflare. Wrangler+esbuild
// bundles the WASM via the static `?module` import natively — no externalize
// shim, no compile-cf-prisma.sh, no post-opennext-cf-prisma.sh, no `as never`
// casts. Output lands in src/generated/prisma/ and is gitignored.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  runtime         = "cloudflare"
  moduleFormat    = "esm"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  schemas    = ["identity", "tenancy", "hosts", "properties", "assets", "hardware", "ocpp", "charging", "billing", "issues", "events", "audit", "entitlements", "people", "vendors", "roaming", "energy", "webhooks", "reports", "agreements"]
  extensions = [citext]
}

// Connection URL lives in prisma.config.ts (Prisma 7 requirement).
// Runtime client passes a PrismaNeon adapter to PrismaClient — see src/lib/prisma.ts.

// ─────────────────────────────────────────────────────────────────────────────
// identity — users and their credentials
// ─────────────────────────────────────────────────────────────────────────────

model User {
  // ── Sprint 0 (ADR 0001) ──────────────────────────────────────────
  id             String           @id @default(uuid()) @db.Uuid
  email          String           @unique @db.Citext
  displayName    String?          @map("display_name")
  status         UserStatus       @default(active)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(6)

  // ── Profile enrichment per ADR 0010 (Sprint 2.6) ─────────────────
  kennitala      String?          @unique
  phone          String?
  locale         String           @default("is")
  timezone       String           @default("Atlantic/Reykjavik")
  notes          String?          @db.Text

  // ── Profile enrichment round 2 (Sprint 3) ────────────────────────
  firstName      String?          @map("first_name")
  middleName     String?          @map("middle_name")
  lastName       String?          @map("last_name")
  dateOfBirth    DateTime?        @map("date_of_birth") @db.Date
  photoUrl       String?          @map("photo_url")
  address        Json             @default("{}") @map("address") @db.JsonB

  // ── ADR 0014 (audience + verification + activity + GDPR) ─────────
  audience            UserAudience @default(operator)
  emailVerifiedAt     DateTime?    @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt     DateTime?    @map("phone_verified_at") @db.Timestamptz(6)
  lastSeenAt          DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  consentTosAt        DateTime?    @map("consent_tos_at") @db.Timestamptz(6)
  consentPrivacyAt    DateTime?    @map("consent_privacy_at") @db.Timestamptz(6)
  consentMarketingAt  DateTime?    @map("consent_marketing_at") @db.Timestamptz(6)
  metadata            Json         @default("{}") @db.JsonB

  // ── Existing relations ───────────────────────────────────────────
  credentials    UserCredential?
  // Sprint 5.6 — one-shot tokens (invite, magic-link, password-reset).
  tokens         UserToken[]
  memberships    Membership[]
  primaryFamily  FamilyGroup[]    @relation("FamilyGroupPrimary")
  familyMember   FamilyMembership[]
  sessions       ChargeSession[]
  auditActions   AuditAction[]
  commandsAsked  OutboundCommand[] @relation("OutboundCommandRequester")
  ocpiTokens     OcpiToken[]

  // ── Rev-3 / Rev-4 relations (ADRs 0008 + 0010) ───────────────────
  // ── ADR 0014 / Sprint 4 — PlatformAdmin replaced by PlatformGrant.
  platformGrant          PlatformGrant?  @relation("PlatformGrantUser")
  platformGrantsMade     PlatformGrant[] @relation("PlatformGrantedBy")
  platformGrantsRevoked  PlatformGrant[] @relation("PlatformGrantRevokedBy")
  // Membership lifecycle — invitedBy back-relation (ADR 0014).
  membershipsInvited     Membership[]    @relation("MembershipInviter")
  configKeysSet           OcppConfigurationKey[] @relation("ConfigKeySetBy")
  costCentersAsPayer      CostCenter[]     @relation("CostCenterPayerUser")
  driverContracts         DriverContract[]
  // ── ADR 0014 ──
  orgsAsMainContact       Organization[]   @relation("OrgMainContact")

  // ── Vendor identity + auth artefacts (API-onboarding) ───────────
  vendorRefs              UserVendorRef[]
  idTokens                IdToken[]
  vendorGroupMemberships  VendorUserGroupMembership[]
  vehicles                Vehicle[]

  // ── Sprint 9 / ADR 0019 — agreements schema back-relation ───────
  driverGroupMemberships  DriverGroupMembership[] @relation("DriverGroupMembershipUser")

  @@map("users")
  @@schema("identity")
}

enum UserStatus {
  active
  suspended
  deleted

  @@schema("identity")
}

enum UserAudience {
  operator
  driver
  service

  @@schema("identity")
}

// ── UserVendorRef (ADR 0014 / API-onboarding) ───────────────────────

model UserVendorRef {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  vendorSlug          String           @map("vendor_slug")
  vendorUserId        String           @map("vendor_user_id")
  vendorEmail         String?          @map("vendor_email")
  vendorRoleHint      String?          @map("vendor_role_hint")
  scopeInstallationId String?          @map("scope_installation_id") @db.Uuid
  status              VendorRefStatus  @default(active)
  lastSyncedAt        DateTime         @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  metadata            Json             @default("{}") @db.JsonB
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopeInstallation   Installation?    @relation("InstallationVendorUserRefs", fields: [scopeInstallationId], references: [id], onDelete: SetNull)

  @@unique([vendorSlug, vendorUserId])
  @@index([userId])
  @@index([scopeInstallationId])
  @@map("user_vendor_refs")
  @@schema("identity")
}

enum VendorRefStatus {
  active
  inactive_at_vendor
  removed_at_vendor

  @@schema("identity")
}

// ── IdToken (RFID, app JWT, magic link, …) ──────────────────────────

model IdToken {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  kind                IdTokenKind
  value               String           @unique
  vendorIssuedBy      String?          @map("vendor_issued_by")
  vendorTokenId       String?          @map("vendor_token_id")
  label               String?
  status              IdTokenStatus    @default(active)
  expiresAt           DateTime?        @map("expires_at") @db.Timestamptz(6)
  lastUsedAt          DateTime?        @map("last_used_at") @db.Timestamptz(6)
  scopeInstallationId String?          @map("scope_installation_id") @db.Uuid
  metadata            Json             @default("{}") @db.JsonB
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopeInstallation   Installation?    @relation("InstallationIdTokens", fields: [scopeInstallationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, value])
  @@index([scopeInstallationId])
  @@index([vendorIssuedBy, vendorTokenId])
  @@map("id_tokens")
  @@schema("identity")
}

enum IdTokenKind {
  rfid
  app_jwt
  magic_link
  zaptec_proxy
  ocpi_token
  manual

  @@schema("identity")
}

enum IdTokenStatus {
  active
  suspended
  revoked
  expired

  @@schema("identity")
}

// ── VendorUserGroup mirror (Zaptec UserGroups) ──────────────────────

model VendorUserGroup {
  id              String           @id @default(uuid()) @db.Uuid
  vendorSlug      String           @map("vendor_slug")
  vendorGroupId   String           @map("vendor_group_id")
  installationId  String           @map("installation_id") @db.Uuid
  name            String
  metadata        Json             @default("{}") @db.JsonB
  lastSyncedAt    DateTime         @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  installation    Installation     @relation("InstallationVendorUserGroups", fields: [installationId], references: [id], onDelete: Cascade)
  memberships     VendorUserGroupMembership[]

  @@unique([vendorSlug, vendorGroupId])
  @@index([installationId])
  @@map("vendor_user_groups")
  @@schema("identity")
}

model VendorUserGroupMembership {
  groupId    String           @map("group_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  role       String
  metadata   Json             @default("{}") @db.JsonB
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  group      VendorUserGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("vendor_user_group_memberships")
  @@schema("identity")
}

// ── Vehicle (driver-owned EV) ───────────────────────────────────────

model Vehicle {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  make                String?
  model               String?
  year                Int?
  licensePlate        String?          @map("license_plate")
  vin                 String?          @unique
  batteryCapacityKwh  Decimal?         @map("battery_capacity_kwh") @db.Decimal(6, 2)
  metadata            Json             @default("{}") @db.JsonB
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("vehicles")
  @@schema("people")
}

model UserCredential {
  userId        String   @id @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash  String?  @map("password_hash")
  totpSecret    String?  @map("totp_secret")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("user_credentials")
  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────────────────────
// identity — UserToken (Sprint 5.6 / ADR 0017)
// One-shot, time-boxed authentication artefacts: invite links, magic
// links, future password-reset links. See root schema for full
// commentary; mirrored here for the apps/api Prisma client.
// ─────────────────────────────────────────────────────────────────────────────

model UserToken {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          UserTokenKind
  tokenHash     String         @unique @map("token_hash")
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime?      @map("used_at") @db.Timestamptz(6)
  createdById   String?        @map("created_by_id") @db.Uuid
  metadata      Json           @default("{}") @db.JsonB
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, kind, expiresAt])
  @@map("user_tokens")
  @@schema("identity")
}

enum UserTokenKind {
  invite
  magic_link
  password_reset

  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────────────────────
// tenancy — organizations (SaaS tenants / CPOs) and memberships
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  // ── Sprint 0 (ADR 0001) ──────────────────────────────────────────
  id                  String              @id @default(uuid()) @db.Uuid
  displayName         String              @map("display_name")
  countryCode         String              @map("country_code") // ISO 3166-1 alpha-2
  status              OrgStatus           @default(active)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ── Profile per ADR 0014 (Iceland-aligned, Fyrirtækjaskrá fields) ─
  legalName           String?             @map("legal_name")
  legalForm           String?             @map("legal_form")
  legalFormCode       String?             @map("legal_form_code")
  kennitala           String?             @unique
  vskNr               String?             @map("vsk_nr")
  leiCode             String?             @map("lei_code")
  defaultCurrency     String              @map("default_currency") @default("ISK")
  postalAddress       Json?               @map("postal_address") @db.JsonB
  legalAddress        Json?               @map("legal_address") @db.JsonB
  municipalityCode    String?             @map("municipality_code")
  municipalityName    String?             @map("municipality_name")
  branding            Json                @default("{}") @db.JsonB
  regulatorLicenceNo  String?             @map("regulator_licence_no")
  roles               OrganizationRole[]  @default([])
  notes               String?             @db.Text

  // ── Contacts (ADR 0014 follow-up) ────────────────────────────────
  // Array of {role, name, email?, phone?, notes?} contact rows.
  // FK mainContactUserId below takes precedence for the "main" role
  // when a User is linked.
  contacts            Json                @default("[]") @db.JsonB

  // ── Main contact (ADR 0014) ──────────────────────────────────────
  mainContactUserId   String?             @map("main_contact_user_id") @db.Uuid
  mainContact         User?               @relation("OrgMainContact", fields: [mainContactUserId], references: [id], onDelete: SetNull)

  // ── Existing relations (ChargerHost / ChargerServicePlan dropped per ADR 0009) ─
  memberships         Membership[]
  properties          Property[]
  sites               Site[]
  installations       Installation[]
  vendorCredentials   VendorCredential[] @relation("OrgVendorCredentials")
  circuits            Circuit[]
  siteAssets          SiteAsset[]
  // Rev-5 (ADR 0012) — Charger renamed to ChargingStation
  chargingStations         ChargingStation[]    @relation("StationOperator")
  chargingStationsOwned    ChargingStation[]    @relation("StationOwner")
  evses                    EVSE[]
  ocppIdentities      OcppIdentity[]
  connectors          Connector[]
  outboundCommands    OutboundCommand[]
  chargeSessions      ChargeSession[]
  meterValues         MeterValue[]
  reservations        Reservation[]
  // Rev-5 (ADR 0012) — control-plane attachments + protocol/import refs
  vendorAssetRefs         VendorAssetRef[]
  externalCpmsRefs        ExternalCpmsRef[]
  capabilityProfiles      CapabilityProfile[]
  controlRoutingPolicies  ControlRoutingPolicy[]
  protocolTransactionRefs ProtocolTransactionRef[]
  importedCdrRefs         ImportedCdrRef[]
  liveSessions            LiveSession[]
  tariffs             Tariff[]
  customerPlans       CustomerPlan[]
  subscriptions       Subscription[]
  billingTransactions BillingTransaction[]
  invoices            Invoice[]
  statements          Statement[]
  tickets             IssueTicket[]
  detectionRules      DetectionRule[]
  eventLog            EventLogEntry[]
  auditActions        AuditAction[]
  featureFlags        FeatureFlag[]
  enterpriseLicenses  EnterpriseLicense[]
  familyGroups        FamilyGroup[]
  ocpiTokens          OcpiToken[]
  hubConnections      HubConnection[]
  cdrQueueEntries     CdrQueueEntry[]
  siteEnergyPolicies  SiteEnergyPolicy[]
  propertyEnergyPolicies PropertyEnergyPolicy[]
  energyPlanningResults EnergyPlanningResult[]
  webhookSubscriptions WebhookSubscription[]

  // ── Rev-3 billing relations (ADR 0008) ──────────────────────────
  tariffDefinitions   TariffDefinition[]
  costCenters         CostCenter[]         @relation("CostCenterOrg")
  costCentersAsPayer  CostCenter[]         @relation("CostCenterPayer")
  costCentersAsBeneficiary CostCenter[]    @relation("CostCenterBeneficiary")
  contracts           Contract[]                  @relation("ContractOwnerOrg")
  // Sprint 8.14 — bilateral contract counterparty link
  contractsAsCounterparty Contract[]              @relation("ContractCounterpartyOrg")
  contractAccumulators ContractPeriodAccumulator[]
  driverContracts     DriverContract[]
  billingLines        BillingLine[]
  configurationKeys   OcppConfigurationKey[]

  // ── Sprint 7.5 — reports schema back-relations ──────────────────
  billingPeriodSummaries BillingPeriodSummary[]
  sessionLedgers      SessionLedger[]
  siteEnergyDaily     SiteEnergyDaily[]
  chargerUptimeDaily  ChargerUptimeDaily[]
  commandHistory      CommandHistory[]

  // ── Sprint 9 / ADR 0019 — agreements schema back-relations ──────
  agreementsAsCounterparty Agreement[]   @relation("AgreementCounterparty")
  agreementsAsCpo          Agreement[]   @relation("AgreementCpo")
  rateReferencesAsSupplier RateReference[] @relation("RateReferenceSupplier")
  driverGroupsOwned        DriverGroup[] @relation("DriverGroupOwner")

  @@map("organizations")
  @@schema("tenancy")
}

enum OrgStatus {
  active
  suspended
  archived

  @@schema("tenancy")
}

model Membership {
  orgId        String           @map("org_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  role         MembershipRole
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // ── ADR 0014 / Sprint 4 — lifecycle + invite-flow plumbing ───────
  status       MembershipStatus @default(active)

  invitedById      String?  @map("invited_by_id") @db.Uuid
  invitedAt        DateTime? @map("invited_at") @db.Timestamptz(6)
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(6)
  suspendedAt      DateTime? @map("suspended_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)

  scopeSiteIds     String[] @default([]) @map("scope_site_ids") @db.Uuid
  scopePropertyIds String[] @default([]) @map("scope_property_ids") @db.Uuid

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?            @relation("MembershipInviter", fields: [invitedById], references: [id])

  @@id([orgId, userId])
  @@index([orgId, status])
  @@map("memberships")
  @@schema("tenancy")
}

enum MembershipRole {
  // Pre-ADR-0014 values; deprecated. Sprint 9 RLS rebuild removes them.
  owner
  admin
  operator
  helper
  contractor
  driver
  viewer

  // ADR 0014 — new role bundles.
  manager
  technician
  finance
  support

  @@schema("tenancy")
}

enum MembershipStatus {
  invited
  active
  suspended
  revoked

  @@schema("tenancy")
}

// ─────────────────────────────────────────────────────────────────────────────
// hosts — schema namespace reserved for future host-domain tables
// (e.g. ServiceAgreement when Issue Engine ships post-pilot).
// ChargerHost + ChargerServicePlan dropped per ADR 0009 (2026-04-26).
// HostType enum moved to properties.SiteType.
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// properties — physical locations and their sublocations
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id                 String         @id @default(uuid()) @db.Uuid
  orgId              String         @map("org_id") @db.Uuid
  // ChargerHost dropped per ADR 0009 — Property attaches directly to Org.
  // host_id column dropped in the consolidated migration.
  displayName        String         @map("display_name")
  address            Json           @default("{}") @db.JsonB
  locationType       String?        @map("location_type")
  latitude           Decimal?       @db.Decimal(9, 6)
  longitude          Decimal?       @db.Decimal(9, 6)
  provisioningStatus String         @map("provisioning_status") @default("provisioned")
  external           Boolean        @default(false) // shadow record from OCPI roaming partner
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sites              Site[]
  energyPolicies     PropertyEnergyPolicy[]

  @@index([orgId])
  @@map("properties")
  @@schema("properties")
}

model Site {
  // ── Sprint 0 (ADR 0001) ──────────────────────────────────────────
  id                 String          @id @default(uuid()) @db.Uuid
  orgId              String          @map("org_id") @db.Uuid
  propertyId         String          @map("property_id") @db.Uuid
  displayName        String          @map("display_name")
  timezone           String          @default("Atlantic/Reykjavik")
  accessLevel        SiteAccessLevel @map("access_level") @default(private)
  powerClass         SitePowerClass? @map("power_class")
  provisioningStatus String          @map("provisioning_status") @default("provisioned")
  external           Boolean         @default(false)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ── Rev-4 (ADR 0009 — HostType moved here as site_type) ──────────
  siteType           SiteType        @map("site_type") @default(standard)

  // ── Rev-3 tariff anchor FKs (ADR 0008) ───────────────────────────
  dsoTariffId        String?         @map("dso_tariff_id") @db.Uuid
  usrfTariffId       String?         @map("usrf_tariff_id") @db.Uuid
  usrfPremTariffId   String?         @map("usrf_prem_tariff_id") @db.Uuid
  xtrrfTariffId      String?         @map("xtrrf_tariff_id") @db.Uuid
  spvivfTariffId     String?         @map("spvivf_tariff_id") @db.Uuid

  // ── Profile enrichment round 2 (Sprint 3) ────────────────────────
  openingHours       Json            @default("{}") @map("opening_hours") @db.JsonB
  accessNote         String?         @map("access_note") @db.Text
  photoUrl           String?         @map("photo_url")

  // ── Existing relations ───────────────────────────────────────────
  organization       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  property           Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  assets             SiteAsset[]
  installations      Installation[]
  circuits           Circuit[]
  sessions           ChargeSession[]
  energyPolicies     SiteEnergyPolicy[]
  energyPlanningResults EnergyPlanningResult[]

  // ── Tariff-definition relations (rev-3) ──────────────────────────
  dsoTariff          TariffDefinition? @relation("SiteDsoTariff", fields: [dsoTariffId], references: [id])
  usrfTariff         TariffDefinition? @relation("SiteUsrfTariff", fields: [usrfTariffId], references: [id])
  usrfPremTariff     TariffDefinition? @relation("SiteUsrfPremTariff", fields: [usrfPremTariffId], references: [id])
  xtrrfTariff        TariffDefinition? @relation("SiteXtrrfTariff", fields: [xtrrfTariffId], references: [id])
  spvivfTariff       TariffDefinition? @relation("SiteSpvivfTariff", fields: [spvivfTariffId], references: [id])

  @@index([orgId, propertyId])
  @@map("sites")
  @@schema("properties")
}

enum SiteAccessLevel {
  public
  private
  taxi_only

  @@schema("properties")
}

enum SitePowerClass {
  lt_50kw
  between_50_150kw
  between_150_500kw
  gt_500kw

  @@schema("properties")
}

// SiteAsset is the polymorphic "thing at a site". Specific kinds (charger,
// meter, modem, controller) extend this via separate rows in `assets`.
model SiteAsset {
  id            String        @id @default(uuid()) @db.Uuid
  orgId         String        @map("org_id") @db.Uuid
  siteId        String        @map("site_id") @db.Uuid
  kind          SiteAssetKind
  displayName   String        @map("display_name")
  status        String        @default("active")
  metadata      Json          @default("{}") @db.JsonB
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site          Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  chargingStation ChargingStation?
  meter         Meter?
  modem         Modem?
  controller    Controller?

  @@index([orgId, siteId])
  @@index([kind, status])
  @@map("site_assets")
  @@schema("properties")
}

enum SiteAssetKind {
  charger
  meter
  modem
  controller

  @@schema("properties")
}

// Installation — optional grouping between Site and charger-kind SiteAssets.
// Used for AC vendor-managed hardware (Zaptec Pro, Easee One) where the vendor
// portal models an installation and credentials cover the whole group.
// OCPP-only chargers and DC chargers typically have no Installation.
model Installation {
  // ── Sprint 0 (ADR 0001 + ADR 0002) ───────────────────────────────
  id                     String                        @id @default(uuid()) @db.Uuid
  orgId                  String                        @map("org_id") @db.Uuid
  siteId                 String                        @map("site_id") @db.Uuid
  vendorId               String?                       @map("vendor_id") @db.Uuid
  modelId                String?                       @map("model_id") @db.Uuid
  displayName            String                        @map("display_name")
  vendorInstallationRef  String?                       @map("vendor_installation_ref")
  credentialsRef         String?                       @map("credentials_ref")
  credentialsId          String?                       @map("credentials_id") @db.Uuid
  credentialsStatus      String?                       @map("credentials_status")
  onboardingStatus       InstallationOnboardingStatus  @map("onboarding_status") @default(pending_credentials)
  metadata               Json                          @default("{}") @db.JsonB
  createdAt              DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ── Rev-3 (ADR 0008 — REPF anchor) ───────────────────────────────
  retailerTariffId       String?                       @map("retailer_tariff_id") @db.Uuid

  // ── ADR 0014 / Sprint 4 milestone 4.6 — auth-enforce gate ────────
  // When true, the OCPP gateway honours the verdict from
  // /api/internal/ocpp-authorize for every Authorize.req at this
  // installation's chargers. When false (default), the gateway logs
  // the verdict for observability but always replies Accepted —
  // today's shadow-mode behaviour. Per-installation; flip after
  // verifying the IdToken table is seeded with every known card.
  enforceAuthorize       Boolean                       @default(false) @map("enforce_authorize")

  // ── Sprint 9 / ADR 0019 (2026-05-08) — load-bearing for agreements ──
  // Gates: factor enlistment (IDL/NET MDU-only), DriverGroup audience
  // flavors, TRD bearer applicability, public-vs-membership semantics.
  installationType       InstallationType              @default(workplace) @map("installation_type")

  // ── Existing relations ───────────────────────────────────────────
  organization           Organization                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site                   Site                          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  vendor                 HardwareVendor?               @relation(fields: [vendorId], references: [id])
  model                  HardwareModel?                @relation(fields: [modelId], references: [id])
  credentials            VendorCredential?             @relation("InstallationCredential", fields: [credentialsId], references: [id])
  chargingStations       ChargingStation[]
  circuits               Circuit[]

  // ── Tariff-definition relation (rev-3) ───────────────────────────
  retailerTariff         TariffDefinition?             @relation("InstallationRetailerTariff", fields: [retailerTariffId], references: [id])

  // ── ADR 0014 / API onboarding (back-relations) ───────────────────
  vendorUserRefs         UserVendorRef[]               @relation("InstallationVendorUserRefs")
  scopedIdTokens         IdToken[]                     @relation("InstallationIdTokens")
  vendorUserGroups       VendorUserGroup[]             @relation("InstallationVendorUserGroups")

  // ── Sprint 9 / ADR 0019 (2026-05-08) — agreements back-relation ──
  agreementsAtInstallation Agreement[]                 @relation("AgreementInstallation")

  @@index([orgId, siteId])
  @@index([vendorId])
  @@map("installations")
  @@schema("properties")
}

// Sprint 9 / ADR 0019 (2026-05-08) — installation classification.
enum InstallationType {
  workplace
  mdu
  public
  private
  mixed

  @@schema("assets")
}

enum InstallationOnboardingStatus {
  pending_credentials
  discovering
  active
  suspended
  error

  @@schema("properties")
}

// ─────────────────────────────────────────────────────────────────────────────
// assets — kind-specific hardware records, extending SiteAsset
// ─────────────────────────────────────────────────────────────────────────────

// ── Rev-5 (ADR 0012) — Charger renamed to ChargingStation ──────────
// Physical equipment lives independently of the control plane. EVSE +
// Connector are split out below. Control attachments (ocpp.identities,
// vendors.vendor_asset_refs, roaming.external_cpms_refs) anchor here.

model ChargingStation {
  // Inherits ID from SiteAsset (preserves the Sprint 0 invariant that
  // every physical asset has a SiteAsset row).
  siteAssetId      String        @id @map("site_asset_id") @db.Uuid
  orgId            String        @map("org_id") @db.Uuid             // operator (the SaaS tenant)
  modelId          String?       @map("model_id") @db.Uuid
  installationId   String?       @map("installation_id") @db.Uuid
  vendor           String?
  model            String?
  // System-wide unique. Populated from Zaptec DeviceId (uppercase)
  // on import — canonical hardware serial stamped on the device.
  serialNumber     String?       @unique @map("serial_number")
  installDate      DateTime?     @map("install_date") @db.Date
  warrantyExpires  DateTime?     @map("warranty_expires") @db.Date
  firmwareVersion  String?       @map("firmware_version")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ── Rev-3 (ADRs 0007 + 0008) ────────────────────────────────────
  circuitId        String?       @map("circuit_id") @db.Uuid
  ownerOrgId       String?       @map("owner_org_id") @db.Uuid
  chrgrfTariffId   String?       @map("chrgrf_tariff_id") @db.Uuid

  // ── OCPP BootNotification profile (1.6 §6.2 / 2.0.1 §1.4) ────────
  chargeBoxSerialNumber String? @map("charge_box_serial_number")
  meterType             String? @map("meter_type")
  meterSerialNumber     String? @map("meter_serial_number")
  iccid                 String?
  imsi                  String?

  // ── Operator-domain fields (Sprint 3 enrichment) ──────────────────
  locationNote     String?       @map("location_note") @db.Text
  mountingType     String?       @map("mounting_type")
  photoUrl         String?       @map("photo_url")
  ipRating         String?       @map("ip_rating")
  breakerAmps      Int?          @map("breaker_amps")

  // ── Lifetime kWh cache (Sprint 3 / ADR 0013) ──────────────────────
  // Persisted snapshot of Zaptec SignedMeterValueKwh. Updated
  // write-through on every successful detail fetch where new >= cached.
  // Survives offline windows and decommissioning so the operator never
  // loses sight of a charger's lifetime energy.
  lifetimeKwhCached      Decimal?  @map("lifetime_kwh_cached") @db.Decimal(12, 3)
  lifetimeKwhObservedAt  DateTime? @map("lifetime_kwh_observed_at") @db.Timestamptz(6)

  // ── Telemetry snapshot cache (Sprint 8.4.3) ───────────────────────
  // Last-known live read from Zaptec /api/chargers/{id}/state. JSONB
  // so technical-read panel can fall back to last-known when the live
  // fetch fails (charger offline / rate limited / cloud blip). Panel
  // renders stale-marker badge with observed-at timestamp.
  lastTelemetryRead      Json?     @map("last_telemetry_read") @db.JsonB
  lastTelemetryAt        DateTime? @map("last_telemetry_at") @db.Timestamptz(6)

  // ── Firmware detail + online-since (Sprint 8.4.7) ─────────────────
  // Extracted from /state observations every cron tick. firmwareVersion
  // above mirrors StateId 911 (BootNotification path also writes there);
  // these three are the rest of the firmware identity.
  mainboardSwVersion     String?   @map("mainboard_sw_version")        // StateId 908
  smartBootloaderVersion String?   @map("smart_bootloader_version")    // StateId 912
  hardwareVersion        String?   @map("hardware_version")             // StateId 913
  onlineSinceAt          DateTime? @map("online_since_at") @db.Timestamptz(6)
  // Sprint 9.8 — comm-mode + signal cached for the /chargers list.
  commMode               String?   @map("comm_mode")
  signalDbm              Int?      @map("signal_dbm")

  // ── Existing relations ───────────────────────────────────────────
  siteAsset        SiteAsset     @relation(fields: [siteAssetId], references: [id], onDelete: Cascade)
  organization     Organization  @relation("StationOperator", fields: [orgId], references: [id])
  hardwareModel    HardwareModel? @relation(fields: [modelId], references: [id])
  installation     Installation? @relation(fields: [installationId], references: [id])

  // ── Rev-5 (ADR 0012) — physical children + control attachments ───
  evses              EVSE[]
  ocppIdentities     OcppIdentity[]
  vendorAssetRefs    VendorAssetRef[]
  externalCpmsRefs   ExternalCpmsRef[]
  capabilityProfiles CapabilityProfile[]
  controlRoutingPolicy ControlRoutingPolicy?
  sessions           ChargeSession[]
  liveSession        LiveSession?

  // ── Rev-3 / Rev-4 relations ──────────────────────────────────────
  circuit          Circuit?      @relation("CircuitStations", fields: [circuitId], references: [id])
  ownerOrg         Organization? @relation("StationOwner", fields: [ownerOrgId], references: [id])
  chrgrfTariff     TariffDefinition? @relation("StationChrgrfTariff", fields: [chrgrfTariffId], references: [id])

  @@index([modelId])
  @@index([installationId])
  @@index([circuitId])
  @@index([ownerOrgId])
  @@map("charging_stations")
  @@schema("assets")
}

// ── Rev-5 (ADR 0012) — EVSE: an electric vehicle supply equipment
// unit inside a ChargingStation. OCPP 2.0.1 native concept; for OCPP
// 1.6 chargers, one EVSE per connector.

model EVSE {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  chargingStationId   String   @map("charging_station_id") @db.Uuid
  evseIndex           Int      @map("evse_index")
  maxPowerKw          Decimal? @map("max_power_kw") @db.Decimal(8, 2)
  phaseCount          Int?     @map("phase_count")
  status              String   @default("unknown")
  statusUpdatedAt     DateTime? @map("status_updated_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargingStation     ChargingStation  @relation(fields: [chargingStationId], references: [siteAssetId], onDelete: Cascade)
  connectors          Connector[]
  sessions            ChargeSession[]

  @@unique([chargingStationId, evseIndex])
  @@index([orgId, status])
  @@map("evses")
  @@schema("assets")
}

// ── Rev-5 (ADR 0012) — Connector moved from ocpp schema to assets.
// Anchors on EVSE, not on OcppIdentity.

model Connector {
  id              String          @id @default(uuid()) @db.Uuid
  orgId           String          @map("org_id") @db.Uuid
  evseId          String          @map("evse_id") @db.Uuid
  connectorIndex  Int             @map("connector_index")
  type            String          // Type2 / CCS2 / CHAdeMO / Schuko
  maxPowerKw      Decimal?        @map("max_power_kw") @db.Decimal(8, 2)
  status          String          @default("unknown")
  statusUpdatedAt DateTime?       @map("status_updated_at") @db.Timestamptz(6)
  // ── OCPP StatusNotification mirror (1.6 §4.9) ─────────────────────
  errorCode       String?         @map("error_code")
  vendorErrorCode String?         @map("vendor_error_code")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  evse            EVSE            @relation(fields: [evseId], references: [id], onDelete: Cascade)
  sessions        ChargeSession[]
  reservations    Reservation[]

  @@unique([evseId, connectorIndex])
  @@index([orgId])
  @@map("connectors")
  @@schema("assets")
}

// ── Rev-5 (ADR 0012) — control-plane policy + capability tables.
// Live in `assets` schema because they describe asset-level routing,
// not protocol-level state.

model CapabilityProfile {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  chargingStationId String   @map("charging_station_id") @db.Uuid
  controlPlane      String   @map("control_plane")
  capabilities      Json     @db.JsonB
  source            String   // 'declared' / 'observed' / 'imported'
  observedAt        DateTime? @map("observed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargingStation   ChargingStation @relation(fields: [chargingStationId], references: [siteAssetId], onDelete: Cascade)

  @@unique([chargingStationId, controlPlane])
  @@map("capability_profiles")
  @@schema("assets")
}

model ControlRoutingPolicy {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  chargingStationId String   @unique @map("charging_station_id") @db.Uuid
  routing           Json     @db.JsonB
  fallback          String?  @map("fallback_plane")
  status            String   @default("active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargingStation   ChargingStation @relation(fields: [chargingStationId], references: [siteAssetId], onDelete: Cascade)

  @@map("control_routing_policies")
  @@schema("assets")
}

model Meter {
  siteAssetId   String      @id @map("site_asset_id") @db.Uuid
  meterSerial   String?     @map("meter_serial")
  meterType     String?     @map("meter_type") // grid / submeter / pv / battery
  maxAmps       Int?        @map("max_amps")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  siteAsset     SiteAsset   @relation(fields: [siteAssetId], references: [id], onDelete: Cascade)

  @@map("meters")
  @@schema("assets")
}

model Modem {
  siteAssetId  String     @id @map("site_asset_id") @db.Uuid
  imei         String?    @unique
  carrier      String?
  iccid        String?
  lastSeenAt   DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  siteAsset    SiteAsset  @relation(fields: [siteAssetId], references: [id], onDelete: Cascade)

  @@map("modems")
  @@schema("assets")
}

model Controller {
  siteAssetId    String     @id @map("site_asset_id") @db.Uuid
  vendor         String?    // e.g. "shelly"
  deviceId       String?    @map("device_id")
  endpointUrl    String?    @map("endpoint_url")
  capabilities   Json       @default("{}") @db.JsonB
  lastSeenAt     DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  siteAsset      SiteAsset  @relation(fields: [siteAssetId], references: [id], onDelete: Cascade)

  @@map("controllers")
  @@schema("assets")
}

// ─────────────────────────────────────────────────────────────────────────────
// hardware — platform-level catalog of supported vendors and models.
// Not tenant-scoped: all Orgs see the same catalog. Model profiles are the
// template for charger / meter / modem / controller records. Credential
// scope on the model drives where adapter credentials attach (installation
// vs. OCPP identity vs. none).
// ─────────────────────────────────────────────────────────────────────────────

model HardwareVendor {
  id             String              @id @default(uuid()) @db.Uuid
  slug           String              @unique // e.g. "zaptec", "easee", "kempower", "shelly", "generic-ocpp"
  displayName    String              @map("display_name")
  kind           HardwareVendorKind
  website        String?
  apiKind        VendorApiKind       @map("api_kind") @default(none)
  supportContact Json                @default("{}") @map("support_contact") @db.JsonB
  status         String              @default("active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  models         HardwareModel[]
  installations  Installation[]
  credentials    VendorCredential[]

  @@map("vendors")
  @@schema("hardware")
}

// Per-org vendor portal credentials. Mirrors prisma/schema.prisma.
// Password is AES-GCM encrypted with a Worker-side KEK before insert
// (apps/api/src/lib/credential-crypto.ts) — DB never holds plaintext.
model VendorCredential {
  id             String          @id @default(uuid()) @db.Uuid
  ownerOrgId     String          @map("owner_org_id") @db.Uuid
  vendorId       String          @map("vendor_id") @db.Uuid
  username       String          @db.VarChar(200)
  passwordCipher Bytes?          @map("password_cipher")
  passwordIv     Bytes?          @map("password_iv")
  status         String          @default("active") // active | expired | revoked
  lastUsedAt     DateTime?       @map("last_used_at") @db.Timestamptz(6)
  notes          String?         @db.VarChar(500)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownerOrg       Organization    @relation("OrgVendorCredentials", fields: [ownerOrgId], references: [id], onDelete: Cascade)
  vendor         HardwareVendor  @relation(fields: [vendorId], references: [id])
  installations  Installation[]  @relation("InstallationCredential")

  @@unique([ownerOrgId, vendorId, username])
  @@index([ownerOrgId])
  @@map("vendor_credentials")
  @@schema("hardware")
}

enum HardwareVendorKind {
  charger_ac
  charger_dc
  meter
  modem
  controller
  multi // vendors that span kinds (e.g. Shelly: modem + controller)

  @@schema("hardware")
}

enum VendorApiKind {
  oauth       // Zaptec Pro style — exchange user/pass for token, then refresh
  basic_auth  // Easee-style user/pass sent per request, or per-identity DC
  none        // no vendor API; OCPP-only

  @@schema("hardware")
}

model HardwareModel {
  id               String                @id @default(uuid()) @db.Uuid
  vendorId         String                @map("vendor_id") @db.Uuid
  slug             String                // unique per vendor, e.g. "zaptec-pro", "easee-one"
  displayName      String                @map("display_name")
  kind             HardwareVendorKind
  assetClass       AssetClass?           @map("asset_class") // ac/dc for chargers; null for non-chargers
  credentialScope  VendorCredentialScope @map("credential_scope") @default(none)
  profile          Json                  @default("{}") @db.JsonB // technical spec template: power, phases, connectors, OCPP versions
  status           String                @default("active")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendor           HardwareVendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  chargingStations ChargingStation[]
  installations    Installation[]

  @@unique([vendorId, slug])
  @@index([kind, status])
  @@map("models")
  @@schema("hardware")
}

enum VendorCredentialScope {
  installation // AC vendor-managed: creds on properties.installations
  identity     // DC vendor-managed: creds on ocpp.ocpp_identities
  none         // OCPP-only: no vendor API

  @@schema("hardware")
}

// ─────────────────────────────────────────────────────────────────────────────
// ocpp — OCPP identities (control endpoints), connectors, outbound commands
// ─────────────────────────────────────────────────────────────────────────────

model OcppIdentity {
  // ── Rev-5 (ADR 0012) ──────────────────────────────────────────────
  // Now a control attachment on ChargingStation, not the parent of the
  // physical hierarchy. Capabilities + control routing moved to
  // assets.capability_profiles + assets.control_routing_policies.
  id                   String         @id @default(uuid()) @db.Uuid
  orgId                String         @map("org_id") @db.Uuid
  chargingStationId    String         @map("charging_station_id") @db.Uuid
  identityString       String         @map("identity_string")
  // Nullable since the no-auth installation feature: NULL means "this
  // identity accepts WebSocket upgrades without Basic Auth." Operator
  // opts in per installation by submitting an empty plaintext through
  // the password manager. Default for newly-onboarded chargers stays
  // populated; only the explicit empty-set path nulls this column.
  authSecretHash       String?        @map("auth_secret_hash")
  ocppVersion          OcppVersion    @map("ocpp_version")
  assetClass           AssetClass     @map("asset_class") @default(ac)
  vendor               String?
  vendorResourceId     String?        @map("vendor_resource_id")
  credentialsRef       String?        @map("credentials_ref")
  credentialsStatus    String?        @map("credentials_status")
  status               String         @default("provisioned")
  lastSeenAt           DateTime?      @map("last_seen_at") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargingStation      ChargingStation  @relation(fields: [chargingStationId], references: [siteAssetId], onDelete: Cascade)
  outboundCommands     OutboundCommand[]
  configurationKeys    OcppConfigurationKey[]
  sessions             ChargeSession[]
  liveSession          LiveSession?

  @@unique([orgId, identityString])
  @@index([orgId, chargingStationId])
  @@map("ocpp_identities")
  @@schema("ocpp")
}

// Pre-onboarding discoveries — populated by the OCPP gateway auth path
// when a charger presents Basic-Auth that does not match any
// OcppIdentity row. Mirrors prisma/schema.prisma.
model PendingDiscovery {
  identityString     String   @id @map("identity_string") @db.VarChar(64)
  firstSeenAt        DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt         DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  attemptCount       Int      @default(0) @map("attempt_count")
  remoteAddr         String?  @map("remote_addr") @db.VarChar(64)
  userAgent          String?  @map("user_agent") @db.VarChar(255)
  lastPayloadSummary Json?    @map("last_payload_summary") @db.JsonB

  @@index([lastSeenAt(sort: Desc)])
  @@map("pending_discoveries")
  @@schema("ocpp")
}

enum OcppVersion {
  ocpp_1_6
  ocpp_2_0_1
  ocpp_2_1

  @@schema("ocpp")
}

enum AssetClass {
  ac
  dc

  @@schema("ocpp")
}

// ── Rev-5 (ADR 0012) — Connector moved to assets schema (defined
// above near ChargingStation/EVSE). Old definition removed.

model OutboundCommand {
  id              String       @id @default(uuid()) @db.Uuid
  orgId           String       @map("org_id") @db.Uuid
  identityId      String       @map("identity_id") @db.Uuid
  controlDomain   String       @map("control_domain")
  routedTo        String       @map("routed_to") // 'ocpp' or 'vendor:<name>'
  payload         Json         @db.JsonB
  status          CommandStatus @default(pending)
  attempts        Int          @default(0)
  notBefore       DateTime     @map("not_before") @db.Timestamptz(6)
  lastAttemptAt   DateTime?    @map("last_attempt_at") @db.Timestamptz(6)
  result          Json?        @db.JsonB
  correlationId   String       @map("correlation_id") @db.Uuid
  requestedBy     String?      @map("requested_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  identity        OcppIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  requester       User?        @relation("OutboundCommandRequester", fields: [requestedBy], references: [id])

  @@index([status, notBefore])
  @@index([orgId, identityId])
  @@map("outbound_commands")
  @@schema("ocpp")
}

enum CommandStatus {
  pending
  sent
  acked
  failed
  cancelled

  @@schema("ocpp")
}

// ─────────────────────────────────────────────────────────────────────────────
// charging — sessions, meter values, reservations
// ─────────────────────────────────────────────────────────────────────────────

model ChargeSession {
  // ── Rev-5 (ADR 0012) — anchors on EVSE; ocppIdentity/connector now optional ─
  id                String        @id @default(uuid()) @db.Uuid
  orgId             String        @map("org_id") @db.Uuid
  siteId            String        @map("site_id") @db.Uuid
  chargingStationId String        @map("charging_station_id") @db.Uuid
  evseId            String        @map("evse_id") @db.Uuid
  connectorId       String?       @map("connector_id") @db.Uuid
  ocppIdentityId    String?       @map("ocpp_identity_id") @db.Uuid
  userId            String?       @map("user_id") @db.Uuid
  idTag             String?       @map("id_tag")
  startedAt         DateTime      @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?     @map("ended_at") @db.Timestamptz(6)
  energyWh          BigInt?       @map("energy_wh")
  stopReason        String?       @map("stop_reason")
  status            SessionStatus @default(in_progress)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // ── Rev-3 (ADR 0008) — rolled-up summary from billing_lines at session-stop ─
  costExVatMinor    BigInt?   @map("cost_ex_vat_minor")
  costIncVatMinor   BigInt?   @map("cost_inc_vat_minor")

  organization      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  site              Site             @relation(fields: [siteId], references: [id])
  chargingStation   ChargingStation  @relation(fields: [chargingStationId], references: [siteAssetId])
  evse              EVSE             @relation(fields: [evseId], references: [id])
  connector         Connector?       @relation(fields: [connectorId], references: [id])
  ocppIdentity      OcppIdentity?    @relation(fields: [ocppIdentityId], references: [id])
  user              User?            @relation(fields: [userId], references: [id])
  meterValues       MeterValue[]
  billingLines      BillingLine[]
  protocolTransactionRefs ProtocolTransactionRef[]
  importedCdrRefs   ImportedCdrRef[]

  // ── Sprint 9 / ADR 0019 — agreements schema back-relation ───────
  agreementBillingLines AgreementBillingLine[] @relation("AgreementBillingLineSession")

  @@index([orgId, startedAt(sort: Desc)])
  @@index([evseId, startedAt(sort: Desc)])
  @@index([userId, startedAt(sort: Desc)])
  @@map("sessions")
  @@schema("charging")
}

enum SessionStatus {
  in_progress
  completed
  aborted

  @@schema("charging")
}

// Sprint 7.2 / ADR 0018 Decision 1 — charging.meter_values is now
// PARTITIONED (RANGE on measured_at, daily). PK is composite
// (id, measured_at). PARTITION BY declaration is in the migration.
model MeterValue {
  id          String        @default(uuid()) @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  sessionId   String        @map("session_id") @db.Uuid
  measuredAt  DateTime      @map("measured_at") @db.Timestamptz(6)
  energyWh    BigInt?       @map("energy_wh")
  powerW      Int?          @map("power_w")
  voltageV    Decimal?      @map("voltage_v") @db.Decimal(6, 2)
  currentA    Decimal?      @map("current_a") @db.Decimal(6, 2)
  socPercent  Decimal?      @map("soc_percent") @db.Decimal(5, 2)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session     ChargeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([id, measuredAt])
  @@index([sessionId, measuredAt])
  @@map("meter_values")
  @@schema("charging")
}

model Reservation {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  connectorId   String    @map("connector_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  reservedFrom  DateTime  @map("reserved_from") @db.Timestamptz(6)
  reservedUntil DateTime  @map("reserved_until") @db.Timestamptz(6)
  status        String    @default("confirmed")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connector     Connector    @relation(fields: [connectorId], references: [id])

  @@index([orgId, reservedFrom])
  @@map("reservations")
  @@schema("charging")
}

// ── Rev-5 (ADR 0012) — protocol-side and import-side session refs.
// Allow zero-or-many per session. A native-OCPP session has one
// ProtocolTransactionRef. An imported CDR has one ImportedCdrRef and
// zero ProtocolTransactionRefs.

model ProtocolTransactionRef {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  sourceKind   String   @map("source_kind")
  sourceId     String   @map("source_id")
  metadata     Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session      ChargeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sourceKind, sourceId])
  @@index([sessionId])
  @@map("protocol_transaction_refs")
  @@schema("charging")
}

model ImportedCdrRef {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  sourceKind    String   @map("source_kind")
  sourceCdrId   String   @map("source_cdr_id")
  importedAt    DateTime @map("imported_at") @db.Timestamptz(6)
  rawPayload    Json?    @map("raw_payload") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session       ChargeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sourceKind, sourceCdrId])
  @@index([sessionId])
  @@map("imported_cdr_refs")
  @@schema("charging")
}

// charging.live_sessions — Sprint 9.6 active-session tracker driven
// by Azure Service Bus state observations parsed by apps/zaptec-consumer.
// One row per charger that has a session in progress; deleted on the
// transition to Finished/Disconnected.
model LiveSession {
  chargingStationId    String   @id @map("charging_station_id") @db.Uuid
  orgId                String   @map("org_id") @db.Uuid
  ocppIdentityId       String   @unique @map("ocpp_identity_id") @db.Uuid
  vendorResourceId     String   @map("vendor_resource_id")
  startedAt            DateTime @map("started_at") @db.Timestamptz(6)
  lastObservedAt       DateTime @map("last_observed_at") @db.Timestamptz(6)
  lastOperationMode    Int?     @map("last_operation_mode")
  lastPowerW           Decimal? @map("last_power_w") @db.Decimal(10, 0)
  lastSessionEnergyWh  Decimal? @map("last_session_energy_wh") @db.Decimal(12, 0)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chargingStation      ChargingStation  @relation(fields: [chargingStationId], references: [siteAssetId], onDelete: Cascade)
  ocppIdentity         OcppIdentity     @relation(fields: [ocppIdentityId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([lastObservedAt])
  @@map("live_sessions")
  @@schema("charging")
}

// ─────────────────────────────────────────────────────────────────────────────
// billing — plans, tariffs, subscriptions, invoices
// Money is BIGINT minor units (aurar / öre / cents). No floats, no decimals.
// ─────────────────────────────────────────────────────────────────────────────

model Tariff {
  id           String     @id @default(uuid()) @db.Uuid
  orgId        String     @map("org_id") @db.Uuid
  displayName  String     @map("display_name")
  rule         Json       @db.JsonB // interpreted by the tariff engine
  currency     String     // ISO 4217
  validFrom    DateTime   @map("valid_from") @db.Timestamptz(6)
  validUntil   DateTime?  @map("valid_until") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerPlans CustomerPlan[]

  @@index([orgId])
  @@map("tariffs")
  @@schema("billing")
}

model CustomerPlan {
  id                   String        @id @default(uuid()) @db.Uuid
  orgId                String        @map("org_id") @db.Uuid
  code                 String
  displayName          String        @map("display_name")
  description          String?
  balanceType          BalanceType   @map("balance_type")
  category             PlanCategory
  products             Json          @default("[]") @db.JsonB // setup/subscription/RFID/usage credit
  defaultTariffId      String?       @map("default_tariff_id") @db.Uuid
  terminationBehavior  TerminationBehavior @map("termination_behavior") @default(evergreen)
  minCommitmentMonths  Int?          @map("min_commitment_months")
  costFactor           Decimal?      @map("cost_factor") @db.Decimal(8, 4)
  country              String?
  currency             String?
  locale               String?
  validFrom            DateTime      @map("valid_from") @db.Timestamptz(6)
  validUntil           DateTime?     @map("valid_until") @db.Timestamptz(6)
  status               String        @default("active")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  defaultTariff        Tariff?       @relation(fields: [defaultTariffId], references: [id])
  subscriptions        Subscription[]

  @@unique([orgId, code])
  @@map("customer_plans")
  @@schema("billing")
}

enum BalanceType {
  prepaid
  postpaid
  non_paying
  pay_immediately
  postpaid_immediately

  @@schema("billing")
}

enum PlanCategory {
  single_tariff
  membership
  roaming
  guest_otp

  @@schema("billing")
}

enum TerminationBehavior {
  terminate
  evergreen
  rollover

  @@schema("billing")
}

model Subscription {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @map("org_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  planId     String       @map("plan_id") @db.Uuid
  startedAt  DateTime     @map("started_at") @db.Timestamptz(6)
  endedAt    DateTime?    @map("ended_at") @db.Timestamptz(6)
  status     String       @default("active")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan       CustomerPlan @relation(fields: [planId], references: [id])

  @@index([orgId, userId])
  @@map("subscriptions")
  @@schema("billing")
}

model BillingTransaction {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  type           BillingTxType
  amountMinor    BigInt       @map("amount_minor") // can be negative (refunds)
  currency       String
  description    String?
  metadata       Json         @default("{}") @db.JsonB
  occurredAt     DateTime     @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, occurredAt(sort: Desc)])
  @@map("billing_transactions")
  @@schema("billing")
}

enum BillingTxType {
  payment
  refund
  penalty
  credit
  contract_charge
  external_payment

  @@schema("billing")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  periodStart     DateTime      @map("period_start") @db.Date
  periodEnd       DateTime      @map("period_end") @db.Date
  currency        String
  totalMinor      BigInt        @map("total_minor")
  status          InvoiceStatus @default(draft)
  issuedAt        DateTime?     @map("issued_at") @db.Timestamptz(6)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(6)
  externalRef     String?       @map("external_ref")
  pdfRef          String?       @map("pdf_ref")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization    Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines           InvoiceLine[]

  @@index([orgId, userId, periodStart])
  @@map("invoices")
  @@schema("billing")
}

enum InvoiceStatus {
  draft
  issued
  paid
  void

  @@schema("billing")
}

model InvoiceLine {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  description    String
  quantity       Decimal @db.Decimal(12, 4)
  unitPriceMinor BigInt  @map("unit_price_minor")
  amountMinor    BigInt  @map("amount_minor")
  sourceType     String  @map("source_type")
  sourceId       String? @map("source_id") @db.Uuid

  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
  @@schema("billing")
}

model Statement {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  subjectType  String       @map("subject_type") // user / host
  subjectId    String       @map("subject_id") @db.Uuid
  periodStart  DateTime     @map("period_start") @db.Date
  periodEnd    DateTime     @map("period_end") @db.Date
  content      Json         @db.JsonB
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, subjectType, subjectId])
  @@map("statements")
  @@schema("billing")
}

// ─────────────────────────────────────────────────────────────────────────────
// issues — tickets, timeline, detection rules (Issue Engine moat)
// ─────────────────────────────────────────────────────────────────────────────

model IssueTicket {
  id                    String        @id @default(uuid()) @db.Uuid
  orgId                 String        @map("org_id") @db.Uuid
  subjectType           IssueSubject  @map("subject_type")
  subjectId             String?       @map("subject_id") @db.Uuid
  category              String
  severity              IssueSeverity @default(medium)
  status                IssueStatus   @default(open)
  detectedBy            String        @map("detected_by")
  assignedToUserId      String?       @map("assigned_to_user_id") @db.Uuid
  assignedToContractorId String?      @map("assigned_to_contractor_id") @db.Uuid
  slaTargetAt           DateTime?     @map("sla_target_at") @db.Timestamptz(6)
  resolvedAt            DateTime?     @map("resolved_at") @db.Timestamptz(6)
  resolutionSummary     String?       @map("resolution_summary")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events                TicketEvent[]

  @@index([orgId, status, severity])
  @@index([subjectType, subjectId])
  @@map("tickets")
  @@schema("issues")
}

enum IssueSubject {
  charger
  ocpp_identity
  connector
  session
  site
  user
  other

  @@schema("issues")
}

enum IssueSeverity {
  low
  medium
  high
  critical

  @@schema("issues")
}

enum IssueStatus {
  open
  triaged
  assigned
  in_progress
  waiting
  resolved
  closed

  @@schema("issues")
}

model TicketEvent {
  id           String      @id @default(uuid()) @db.Uuid
  ticketId     String      @map("ticket_id") @db.Uuid
  eventType    String      @map("event_type")
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  payload      Json        @default("{}") @db.JsonB
  occurredAt   DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)

  ticket       IssueTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, occurredAt])
  @@map("ticket_events")
  @@schema("issues")
}

model DetectionRule {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  ruleKey     String       @map("rule_key")
  config      Json         @default("{}") @db.JsonB
  enabled     Boolean      @default(true)
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, ruleKey])
  @@map("detection_rules")
  @@schema("issues")
}

// ─────────────────────────────────────────────────────────────────────────────
// events — append-only event log (source of truth) + idempotency
// ─────────────────────────────────────────────────────────────────────────────

// Sprint 7.2 / ADR 0018 Decision 1 — events.event_log is PARTITIONED
// (RANGE on recorded_at, daily). PK is composite (id, recorded_at).
// PARTITION BY declaration is in the migration.
model EventLogEntry {
  id              String          @default(uuid()) @db.Uuid // UUIDv7 when driver lands it
  orgId           String          @map("org_id") @db.Uuid
  aggregateType   String          @map("aggregate_type")
  aggregateId    String           @map("aggregate_id") @db.Uuid
  eventType       String          @map("event_type")
  schemaVersion   Int             @map("schema_version") @default(1)
  payload         Json            @db.JsonB
  metadata        Json            @default("{}") @db.JsonB
  retentionClass  RetentionClass  @map("retention_class") @default(operational)
  occurredAt      DateTime        @map("occurred_at") @db.Timestamptz(6)
  recordedAt      DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)

  organization    Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([id, recordedAt])
  @@index([orgId, occurredAt(sort: Desc)])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt(sort: Desc)])
  @@map("event_log")
  @@schema("events")
}

enum RetentionClass {
  financial     // indefinite, hot
  operational   // indefinite, hot, small
  raw_protocol  // 30–90 days, then deleted
  aggregate     // 12–24 months
  issue_history // indefinite

  @@schema("events")
}

model IdempotencyKey {
  scope      String   // 'ocpp:<identity>', 'api', 'webhook:<partner>'
  key        String
  result     Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("events")
}

// ─────────────────────────────────────────────────────────────────────────────
// audit — actor-did-what log (distinct from events which is what-happened)
// ─────────────────────────────────────────────────────────────────────────────

model AuditAction {
  id           String        @id @default(uuid()) @db.Uuid
  orgId        String        @map("org_id") @db.Uuid
  actorUserId  String?       @map("actor_user_id") @db.Uuid
  actorKind    ActorKind     @map("actor_kind")
  action       String
  targetType   String?       @map("target_type")
  targetId     String?       @map("target_id") @db.Uuid
  metadata     Json          @default("{}") @db.JsonB
  occurredAt   DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id])

  @@index([orgId, occurredAt(sort: Desc)])
  @@index([targetType, targetId, occurredAt(sort: Desc)])
  @@map("actions")
  @@schema("audit")
}

enum ActorKind {
  user
  system
  vendor_webhook
  ocpp_worker

  @@schema("audit")
}

// ─────────────────────────────────────────────────────────────────────────────
// entitlements — feature flags + enterprise licenses (capability vs permission)
// ─────────────────────────────────────────────────────────────────────────────

model FeatureFlag {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  featureKey  String       @map("feature_key")
  scopeType   String       @map("scope_type") // org/site/identity/user
