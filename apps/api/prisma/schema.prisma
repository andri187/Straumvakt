// OCPI-aligned tenant taxonomy (ADR 0014). Trimmed from 21 to 13.
enum OrganizationRole {
  cpo
  emsp
  hub
  nsp
  site_host
  service_contractor
  installer
  vendor
  regulator
  dso
  tso
  retailer
  payment_processor

  @@schema("tenancy")
}

// ─────────────────────────────────────────────────────────────────────────────
// identity — PlatformGrant (ADR 0014, replaces PlatformAdmin from ADR 0008)
// ─────────────────────────────────────────────────────────────────────────────

model PlatformGrant {
  userId        String              @id @map("user_id") @db.Uuid
  role          PlatformRole
  status        PlatformGrantStatus @default(active)
  grantedById   String?             @map("granted_by_id") @db.Uuid
  grantedAt     DateTime            @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt     DateTime?           @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?           @map("revoked_at") @db.Timestamptz(6)
  revokedById   String?             @map("revoked_by_id") @db.Uuid
  scope         Json?

  user          User @relation("PlatformGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy     User? @relation("PlatformGrantedBy", fields: [grantedById], references: [id])
  revokedBy     User? @relation("PlatformGrantRevokedBy", fields: [revokedById], references: [id])

  @@map("platform_grants")
  @@schema("identity")
}

enum PlatformRole {
  super_user
  platform_admin
  support_agent
  sales_cs
  finance_internal
  auditor

  @@schema("identity")
}

enum PlatformGrantStatus {
  active
  suspended
  revoked

  @@schema("identity")
}

// ─────────────────────────────────────────────────────────────────────────────
// properties — SiteType enum (ADR 0009 — moved here from hosts.HostType)
// + Circuit model (ADR 0007)
// ─────────────────────────────────────────────────────────────────────────────

enum SiteType {
  standard
  workplace
  mdu
  hotel
  fleet
  retail

  @@schema("properties")
}

model Circuit {
  id                String        @id @default(uuid()) @db.Uuid
  orgId             String        @map("org_id") @db.Uuid
  siteId            String        @map("site_id") @db.Uuid
  installationId    String?       @map("installation_id") @db.Uuid
  displayName       String        @map("display_name")
  ampereCeiling     Int?          @map("ampere_ceiling")
  phaseCount        Int           @map("phase_count") @default(3)
  vendorCircuitRef  String?       @map("vendor_circuit_ref")
  metadata          Json          @default("{}") @db.JsonB
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
