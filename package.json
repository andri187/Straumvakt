{
  "name": "straumvakt",
  "version": "0.1.0",
  "private": true,
  "description": "Straumvakt — charging operating platform. Clean V3 rebuild.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present && npm --prefix gateway run typecheck",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "deploy": "next build --webpack && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare deploy",
    "deploy:staging": "next build --webpack && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare deploy --env staging",
    "preview": "next build --webpack && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare preview",
    "preview:staging": "next build --webpack && opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare preview --env staging",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate && npm --prefix apps/api run prisma:generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "check:schema-parity": "prisma migrate diff --from-schema apps/api/prisma/schema --to-schema prisma/schema --exit-code",
    "sync:api-schema": "node scripts/sync-api-prisma-schema.mjs",
    "check:api-schema": "node scripts/sync-api-prisma-schema.mjs --check",
    "sync:detour-assets": "node scripts/sync-detour-assets.mjs",
    "check:deps": "depcruise apps/api/src src packages --config .dependency-cruiser.cjs --ignore-known",
    "deps:baseline": "depcruise apps/api/src src packages --config .dependency-cruiser.cjs --output-type baseline > .dependency-cruiser-known-violations.json",
    "deps:graph": "node scripts/gen-dependency-graph.mjs",
    "check:deps-graph": "node scripts/gen-dependency-graph.mjs --check",
    "check": "node scripts/check-all.mjs",
    "check:schemas": "prisma validate --schema prisma/schema && prisma validate --schema apps/api/prisma/schema",
    "check:migrations": "prisma migrate status --schema prisma/schema",
    "api:endpoints": "node scripts/gen-api-endpoints.mjs",
    "check:api-endpoints": "node scripts/gen-api-endpoints.mjs --check",
    "check:unused-exports": "node scripts/check-unused-exports.mjs",
    "unused-exports:baseline": "node scripts/check-unused-exports.mjs --baseline"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "0.447.0",
    "next": "^16.2.4",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.1",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "dependency-cruiser": "^18.1.1",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.0",
    "eslint": "9.17.0",
    "eslint-config-next": "^16.2.4",
    "postcss": "8.4.40",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.7",
    "tsx": "^4.21.0",
    "typescript": "5.5.4",
    "vitest": "^4.1.5",
    "wrangler": "^4.84.1"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
