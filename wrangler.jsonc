{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hlada",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 50
  },
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "Straumvakt",
    "NEXT_PUBLIC_APP_ENV": "production",
    // Production API Worker is not deployed yet — leave empty until
    // hlada-api ships and the cookie domain is custom-bound.
    "NEXT_PUBLIC_API_BASE_URL": ""
  },
  // Service Binding to the OCPP gateway Worker — main-app dispatcher
  // calls `env.OCPP_GATEWAY.fetch('/dispatch/:identityId', ...)`. No
  // public internet hop, authenticated by CF routing. See ADR 0004.
  "services": [
    {
      "binding": "OCPP_GATEWAY",
      "service": "straumvakt-ocpp"
    }
  ],
  // Staging env — deployed by Cloudflare's git integration from the `staging`
  // branch, or locally via `wrangler deploy --env staging`. Secrets
  // (AUTH_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD, DATABASE_URL, DIRECT_URL,
  // OCPP_INGEST_SECRET) live in the Cloudflare dashboard per-Worker,
  // NOT here.
  "env": {
    "staging": {
      "name": "hlada-staging",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "vars": {
        "NEXT_PUBLIC_APP_NAME": "Straumvakt (staging)",
        "NEXT_PUBLIC_APP_ENV": "staging",
        // UI fetches against the staging API Worker. Cookie is scoped
        // to the parent host (straumvakt.workers.dev) by the API Worker
        // login route so it works across the UI/API subdomain split.
        "NEXT_PUBLIC_API_BASE_URL": "https://hlada-api-staging.straumvakt.workers.dev"
      },
      "services": [
        {
          "binding": "OCPP_GATEWAY",
          "service": "straumvakt-ocpp-staging"
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE_DB",
          "id": "d2d56ab1ffe241bbb64946ba78a52be5",
          "localConnectionString": "postgresql://placeholder:placeholder@localhost:5432/placeholder"
        }
      ]
    }
  }
}
