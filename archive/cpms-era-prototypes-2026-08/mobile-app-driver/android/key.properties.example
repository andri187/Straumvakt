# Copy to android/key.properties (gitignored) once you've generated the
# upload keystore. Both files must stay OUT of version control.
#
# Generate the keystore with (run from android/app/):
#
#   keytool -genkey -v -keystore straumvakt-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias straumvakt-upload
#
# Pick a strong password â€” the same password works for both storePassword
# and keyPassword in most setups.

storeFile=straumvakt-upload.jks
storePassword=CHANGE_ME
keyAlias=straumvakt-upload
keyPassword=CHANGE_ME
